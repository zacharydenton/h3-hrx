// Per-head RMSNorm (weight w[c]) and rotate-half rotary embedding, head size 128, 128 channels
// rotated: channels c < 64 pair with c + 64; cos/sin [tokens][64]. q at column 0 of the fused
// [tokens][row_stride] projection, k at k_offset, v after k; outputs contiguous [tokens][heads*128].
// One workgroup of 256 lanes per token, a wave per head (4 channels per lane), the partner quad
// 16 lanes away through a subgroup shuffle.
//
amdgpu.target<gfx11-generic> @h3_rope128_qknorm_f16_gfx11 {subgroup_size = 32}

config.decl @h3.rope128_qknorm_f16.row_stride : %value: index where [range(%value, 128, 65536), mul(%value, 128)]

config.decl @h3.rope128_qknorm_f16.heads : %value: index where [range(%value, 1, 256)]

config.decl @h3.rope128_qknorm_f16.kv_heads : %value: index where [range(%value, 1, 256)]

config.decl @h3.rope128_qknorm_f16.k_offset : %value: index where [range(%value, 128, 65536), mul(%value, 128)]

config.decl @h3.rope128_qknorm_f16.eps : f32

kernel.def target(@h3_rope128_qknorm_f16_gfx11) export("h3_rope128_qknorm_f16") @h3_rope128_qknorm_f16(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens: index, %qkv: buffer, %q_weight: buffer, %k_weight: buffer, %cos: buffer, %sin: buffer, %q_out: buffer, %k_out: buffer, %v_out: buffer) {
  %row_stride = config.get @h3.rope128_qknorm_f16.row_stride : index
  %heads = config.get @h3.rope128_qknorm_f16.heads : index
  %k_offset = config.get @h3.rope128_qknorm_f16.k_offset : index
  %eps = config.get @h3.rope128_qknorm_f16.eps : f32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %cch = index.constant 4 : index
  %cp = index.constant 16 : index
  %c2p = index.constant 32 : index
  %cpair_last = index.constant 60 : index
  %cd = index.constant 128 : index
  %c0_offset = index.constant 0 : offset
  %i32_32 = scalar.constant 32 : i32
  %zero_f = scalar.constant 0.0 : f32
  %invd = scalar.constant 0.0078125 : f32
  %tokens_b = index.assume %tokens [range(%tokens, 1, 1048576)] : index
  %token = kernel.workgroup.id<x> : index
  %row = index.assume %token [lt(%token, %tokens_b)] : index
  %wave0 = kernel.subgroup.id : index
  %wave = index.assume %wave0 [range(%wave0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index
  %lane_col = index.mul %lane, %cch : index
  %kv_heads = config.get @h3.rope128_qknorm_f16.kv_heads : index
  %qk_heads = index.add %heads, %kv_heads : index
  %heads_total = index.add %qk_heads, %kv_heads : index
  %kv_width = index.mul %kv_heads, %cd : index
  %kv_limit = index.sub %kv_width, %cch : index
  %rounds0 = index.add %heads_total, %c7 : index
  %rounds = index.div %rounds0, %c8 : index
  %qkv_global = buffer.assume.memory_space<global> %qkv : buffer
  %qo_global = buffer.assume.memory_space<global> %q_out : buffer
  %ko_global = buffer.assume.memory_space<global> %k_out : buffer
  %vo_global = buffer.assume.memory_space<global> %v_out : buffer
  %width = index.mul %heads, %cd : index
  %qw_global = buffer.assume.memory_space<global> %q_weight : buffer
  %kw_global = buffer.assume.memory_space<global> %k_weight : buffer
  %cos_global = buffer.assume.memory_space<global> %cos : buffer
  %sin_global = buffer.assume.memory_space<global> %sin : buffer
  %qkv_view = buffer.view %qkv_global[%c0_offset] : buffer -> view<[%tokens_b]x[%row_stride]xf16>
  %qo_view = buffer.view %qo_global[%c0_offset] : buffer -> view<[%tokens_b]x[%width]xf16>
  %ko_view = buffer.view %ko_global[%c0_offset] : buffer -> view<[%tokens_b]x[%kv_width]xf16>
  %vo_view = buffer.view %vo_global[%c0_offset] : buffer -> view<[%tokens_b]x[%kv_width]xf16>
  %v_offset = index.add %k_offset, %kv_width : index
  %w_limit = index.sub %width, %cch : index
  %qw_view = buffer.view %qw_global[%c0_offset] : buffer -> view<128xf32>
  %kw_view = buffer.view %kw_global[%c0_offset] : buffer -> view<128xf32>
  %cos_view = buffer.view %cos_global[%c0_offset] : buffer -> view<[%tokens_b]x64xf32>
  %sin_view = buffer.view %sin_global[%c0_offset] : buffer -> view<[%tokens_b]x64xf32>
  %col_limit = index.sub %row_stride, %cch : index
  // rotate-half lane classes: 0..15 hold x1, 16..31 hold x2, the rest pass through
  %is_lo = index.cmp ult, %lane, %cp : index
  %is_pair = index.cmp ult, %lane, %c2p : index
  %up = index.add %lane, %cp : index
  %down0 = index.sub %lane, %cp : index
  %down = scf.select %is_pair, %down0, %lane : index
  %partner0 = scf.select %is_lo, %up, %down : index
  %partner1 = index.assume %partner0 [range(%partner0, 0, 31)] : index
  %partner = index.cast %partner1 : index to i32
  %pair_lane0 = scf.select %is_lo, %lane, %c0 : index
  %pair_lane1 = index.sub %lane, %cp : index
  %pair_lane2 = scf.select %is_lo, %pair_lane0, %pair_lane1 : index
  %pair_lane3 = scf.select %is_pair, %pair_lane2, %c0 : index
  %pair_col0 = index.mul %pair_lane3, %cch : index
  %pair_col = index.assume %pair_col0 [le(%pair_col0, %cpair_last), mul(%pair_col0, 4)] : index
  scf.for %r = [%c0 to %rounds step %c1] {
    %r8 = index.mul %r, %c8 : index
    %head = index.add %r8, %wave : index
    %active = index.cmp ult, %head, %heads_total : index
    scf.if %active {
      %is_q = index.cmp ult, %head, %heads : index
      %is_v = index.cmp uge, %head, %qk_heads : index
      %k_head0 = index.sub %head, %heads : index
      %k_head1 = scf.select %is_q, %c0, %k_head0 : index
      %k_head = index.assume %k_head1 [range(%k_head1, 0, 255)] : index
      %v_head0 = index.sub %head, %qk_heads : index
      %v_head1 = scf.select %is_v, %v_head0, %c0 : index
      %v_head = index.assume %v_head1 [range(%v_head1, 0, 255)] : index
      %q_base = index.mul %head, %cd : index
      %k_base0 = index.mul %k_head, %cd : index
      %k_base = index.add %k_offset, %k_base0 : index
      %base_qk = scf.select %is_q, %q_base, %k_base : index
      %v_base0 = index.mul %v_head, %cd : index
      %v_base = index.add %v_offset, %v_base0 : index
      %base = scf.select %is_v, %v_base, %base_qk : index
      %col0 = index.add %base, %lane_col : index
      %col = index.assume %col0 [le(%col0, %col_limit), mul(%col0, 4)] : index
      %v16 = vector.load %qkv_view[%row, %col] : view<[%tokens_b]x[%row_stride]xf16> -> vector<4xf16>
      scf.if %is_v {
        %vc0 = index.add %v_base0, %lane_col : index
        %vc = index.assume %vc0 [le(%vc0, %kv_limit), mul(%vc0, 4)] : index
        vector.store %v16, %vo_view[%row, %vc] : vector<4xf16>, view<[%tokens_b]x[%kv_width]xf16>
      } else {
        %v = vector.extf %v16 : vector<4xf16> to vector<4xf32>
        %sq = vector.mulf %v, %v : vector<4xf32>
        %lane_ss = vector.reduce<addf> %sq, %zero_f : vector<4xf32>, f32
        %ss = kernel.subgroup.reduce<addf> %lane_ss : f32
        %mean = scalar.mulf %ss, %invd : f32
        %mean_eps = scalar.addf %mean, %eps : f32
        %rinv = scalar.rsqrtf %mean_eps : f32
        %rinv_v = vector.splat %rinv : vector<4xf32>
        %normed = vector.mulf %v, %rinv_v : vector<4xf32>
        %w_q = vector.load %qw_view[%lane_col] : view<128xf32> -> vector<4xf32>
        %w_k = vector.load %kw_view[%lane_col] : view<128xf32> -> vector<4xf32>
        %w = scf.if %is_q -> (vector<4xf32>) {
          scf.yield %w_q : vector<4xf32>
        } else {
          scf.yield %w_k : vector<4xf32>
        }
        %x = vector.mulf %normed, %w : vector<4xf32>
        %px, %ok = kernel.subgroup.shuffle<index> %x, %partner, %i32_32 : vector<4xf32>, i32, i32
        %c = vector.load %cos_view[%row, %pair_col] : view<[%tokens_b]x64xf32> -> vector<4xf32>
        %s = vector.load %sin_view[%row, %pair_col] : view<[%tokens_b]x64xf32> -> vector<4xf32>
        // x1' = x1 cos - x2 sin (the lo lanes, partner x2); x2' = x1 sin + x2 cos (the hi lanes)
        %xc = vector.mulf %x, %c : vector<4xf32>
        %ps = vector.mulf %px, %s : vector<4xf32>
        %lo_out = vector.subf %xc, %ps : vector<4xf32>
        %hi_out = vector.addf %xc, %ps : vector<4xf32>
        %pair_out = scf.if %is_lo -> (vector<4xf32>) {
          scf.yield %lo_out : vector<4xf32>
        } else {
          scf.yield %hi_out : vector<4xf32>
        }
        %out = scf.if %is_pair -> (vector<4xf32>) {
          scf.yield %pair_out : vector<4xf32>
        } else {
          scf.yield %x : vector<4xf32>
        }
        %out16 = vector.fptrunc %out : vector<4xf32> to vector<4xf16>
        scf.if %is_q {
          %qc0 = index.add %q_base, %lane_col : index
          %qc = index.assume %qc0 [le(%qc0, %w_limit), mul(%qc0, 4)] : index
          vector.store %out16, %qo_view[%row, %qc] : vector<4xf16>, view<[%tokens_b]x[%width]xf16>
        } else {
          %kc0 = index.add %k_base0, %lane_col : index
          %kc = index.assume %kc0 [le(%kc0, %kv_limit), mul(%kc0, 4)] : index
          vector.store %out16, %ko_view[%row, %kc] : vector<4xf16>, view<[%tokens_b]x[%kv_width]xf16>
        }
      }
    }
  }
  kernel.return
}
