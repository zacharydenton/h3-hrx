// out[i] = f32(x[i]) over `count` halves (the attention output back into the f32 residual stream's GEMMs).
amdgpu.target<gfx11-generic> @h3_cast_f16_f32_gfx11 {subgroup_size = 32}

kernel.def target(@h3_cast_f16_f32_gfx11) export("h3_cast_f16_f32") @h3_cast_f16_f32(%count: index) {
  %c1 = index.constant 1 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %rounded = index.add %count, %c255 : index
  %groups = index.div %rounded, %c256 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%count: index, %x: buffer, %out: buffer) {
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %count_b = index.assume %count [range(%count, 1, 1073741824)] : index
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %base = index.mul %wg, %c256 : index
  %i = index.add %base, %lane : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %x_view = buffer.view %x_global[%c0_offset] : buffer -> view<[%count_b]xf16>
  %out_view = buffer.view %out_global[%c0_offset] : buffer -> view<[%count_b]xf32>
  %active = index.cmp ult, %i, %count_b : index
  scf.if %active {
    %ii = index.assume %i [lt(%i, %count_b)] : index
    %v = view.load %x_view[%ii] : view<[%count_b]xf16> -> f16
    %w = scalar.extf %v : f16 to f32
    view.store %w, %out_view[%ii] : f32, view<[%count_b]xf32>
  }
  kernel.return
}
