    %k_data_hi1 = vector.load %k_tile[%lane_column_hi, %c16] : view<32x72xf16> -> vector<16xf16>
    %klhs_hi1 = vector.fragment<lhs> %k_data_hi1 shape [%m, %k_frag] : vector<16xf16>
    %qk_hi1 = vector.mma %klhs_hi1, %qrhs1, %qk_hi0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %k_data_hi2 = vector.load %k_tile[%lane_column_hi, %c32] : view<32x72xf16> -> vector<16xf16>
    %klhs_hi2 = vector.fragment<lhs> %k_data_hi2 shape [%m, %k_frag] : vector<16xf16>
    %qk_hi2 = vector.mma %klhs_hi2, %qrhs2, %qk_hi1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %k_data_hi3 = vector.load %k_tile[%lane_column_hi, %c48] : view<32x72xf16> -> vector<16xf16>
    %klhs_hi3 = vector.fragment<lhs> %k_data_hi3 shape [%m, %k_frag] : vector<16xf16>
    %raw_scores_hi = vector.mma %klhs_hi3, %qrhs3, %qk_hi2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %scaled0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_scores, %scale_vector : vector<8xf32>
    %key_end = index.add %key_origin0, %c32 : index
    %keys_full = index.cmp ule, %key_end, %tokens0 : index
    %scaled = scf.if %keys_full -> (vector<8xf32>) {
      scf.yield %scaled0 : vector<8xf32>
    } else {
      %mask0a = index.add %key_origin0, %c0 : index
      %mask0key = index.add %mask0a, %lane_group : index
      %mask0ok = index.cmp ult, %mask0key, %tokens0 : index
      %mask0value = scf.select %mask0ok, %zero_f32, %negative_large : f32
      %mask1a = index.add %key_origin0, %c2 : index
      %mask1key = index.add %mask1a, %lane_group : index
      %mask1ok = index.cmp ult, %mask1key, %tokens0 : index
      %mask1value = scf.select %mask1ok, %zero_f32, %negative_large : f32
      %mask2a = index.add %key_origin0, %c4 : index
      %mask2key = index.add %mask2a, %lane_group : index
      %mask2ok = index.cmp ult, %mask2key, %tokens0 : index
      %mask2value = scf.select %mask2ok, %zero_f32, %negative_large : f32
      %mask3a = index.add %key_origin0, %c6 : index
      %mask3key = index.add %mask3a, %lane_group : index
      %mask3ok = index.cmp ult, %mask3key, %tokens0 : index
      %mask3value = scf.select %mask3ok, %zero_f32, %negative_large : f32
      %mask4a = index.add %key_origin0, %c8 : index
      %mask4key = index.add %mask4a, %lane_group : index
      %mask4ok = index.cmp ult, %mask4key, %tokens0 : index
      %mask4value = scf.select %mask4ok, %zero_f32, %negative_large : f32
      %mask5a = index.add %key_origin0, %c10 : index
      %mask5key = index.add %mask5a, %lane_group : index
      %mask5ok = index.cmp ult, %mask5key, %tokens0 : index
      %mask5value = scf.select %mask5ok, %zero_f32, %negative_large : f32
      %mask6a = index.add %key_origin0, %c12 : index
      %mask6key = index.add %mask6a, %lane_group : index
      %mask6ok = index.cmp ult, %mask6key, %tokens0 : index
      %mask6value = scf.select %mask6ok, %zero_f32, %negative_large : f32
      %mask7a = index.add %key_origin0, %c14 : index
      %mask7key = index.add %mask7a, %lane_group : index
      %mask7ok = index.cmp ult, %mask7key, %tokens0 : index
      %mask7value = scf.select %mask7ok, %zero_f32, %negative_large : f32
      %mask = vector.from_elements %mask0value, %mask1value, %mask2value, %mask3value, %mask4value, %mask5value, %mask6value, %mask7value : vector<8xf32>
      %masked = vector.addf<reassoc|nnan|ninf|nsz> %scaled0, %mask : vector<8xf32>
      scf.yield %masked : vector<8xf32>
    }
    %scaled_hi0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_scores_hi, %scale_vector : vector<8xf32>
    %scaled_hi = scf.if %keys_full -> (vector<8xf32>) {
      scf.yield %scaled_hi0 : vector<8xf32>
    } else {
      %mask_hi0a = index.add %key_origin0, %c0 : index
      %mask_hi0b = index.add %mask_hi0a, %c16 : index
      %mask_hi0key = index.add %mask_hi0b, %lane_group : index
      %mask_hi0ok = index.cmp ult, %mask_hi0key, %tokens0 : index
      %mask_hi0value = scf.select %mask_hi0ok, %zero_f32, %negative_large : f32
      %mask_hi1a = index.add %key_origin0, %c2 : index
      %mask_hi1b = index.add %mask_hi1a, %c16 : index
      %mask_hi1key = index.add %mask_hi1b, %lane_group : index
      %mask_hi1ok = index.cmp ult, %mask_hi1key, %tokens0 : index
      %mask_hi1value = scf.select %mask_hi1ok, %zero_f32, %negative_large : f32
      %mask_hi2a = index.add %key_origin0, %c4 : index
      %mask_hi2b = index.add %mask_hi2a, %c16 : index
      %mask_hi2key = index.add %mask_hi2b, %lane_group : index
      %mask_hi2ok = index.cmp ult, %mask_hi2key, %tokens0 : index
      %mask_hi2value = scf.select %mask_hi2ok, %zero_f32, %negative_large : f32
      %mask_hi3a = index.add %key_origin0, %c6 : index
      %mask_hi3b = index.add %mask_hi3a, %c16 : index
      %mask_hi3key = index.add %mask_hi3b, %lane_group : index
      %mask_hi3ok = index.cmp ult, %mask_hi3key, %tokens0 : index
      %mask_hi3value = scf.select %mask_hi3ok, %zero_f32, %negative_large : f32
      %mask_hi4a = index.add %key_origin0, %c8 : index
      %mask_hi4b = index.add %mask_hi4a, %c16 : index
      %mask_hi4key = index.add %mask_hi4b, %lane_group : index
      %mask_hi4ok = index.cmp ult, %mask_hi4key, %tokens0 : index
      %mask_hi4value = scf.select %mask_hi4ok, %zero_f32, %negative_large : f32
      %mask_hi5a = index.add %key_origin0, %c10 : index
      %mask_hi5b = index.add %mask_hi5a, %c16 : index
      %mask_hi5key = index.add %mask_hi5b, %lane_group : index
      %mask_hi5ok = index.cmp ult, %mask_hi5key, %tokens0 : index
      %mask_hi5value = scf.select %mask_hi5ok, %zero_f32, %negative_large : f32
      %mask_hi6a = index.add %key_origin0, %c12 : index
      %mask_hi6b = index.add %mask_hi6a, %c16 : index
      %mask_hi6key = index.add %mask_hi6b, %lane_group : index
      %mask_hi6ok = index.cmp ult, %mask_hi6key, %tokens0 : index
      %mask_hi6value = scf.select %mask_hi6ok, %zero_f32, %negative_large : f32
      %mask_hi7a = index.add %key_origin0, %c14 : index
      %mask_hi7b = index.add %mask_hi7a, %c16 : index
      %mask_hi7key = index.add %mask_hi7b, %lane_group : index
      %mask_hi7ok = index.cmp ult, %mask_hi7key, %tokens0 : index
      %mask_hi7value = scf.select %mask_hi7ok, %zero_f32, %negative_large : f32
      %mask_hi = vector.from_elements %mask_hi0value, %mask_hi1value, %mask_hi2value, %mask_hi3value, %mask_hi4value, %mask_hi5value, %mask_hi6value, %mask_hi7value : vector<8xf32>
      %masked_hi = vector.addf<reassoc|nnan|ninf|nsz> %scaled_hi0, %mask_hi : vector<8xf32>
      scf.yield %masked_hi : vector<8xf32>
    }
    %pair_max = vector.maxnumf %scaled, %scaled_hi : vector<8xf32>
    %half_max = vector.reduce<maxnumf> %pair_max, %negative_large : vector<8xf32>, f32
    %partner_max, %max_valid = kernel.subgroup.shuffle<xor> %half_max, %i32_16, %i32_32 : f32, i32, i32
    %tile_max = scalar.maxnumf %half_max, %partner_max : f32
    %next_max = scalar.maxnumf %row_max, %tile_max : f32
    %next_max_v = vector.splat %next_max : vector<8xf32>
    %delta = vector.subf<reassoc|nnan|ninf|nsz> %scaled, %next_max_v : vector<8xf32>
    %delta_hi = vector.subf<reassoc|nnan|ninf|nsz> %scaled_hi, %next_max_v : vector<8xf32>
    %weight = vector.exp2f<afn> %delta : vector<8xf32>
    %weight_hi = vector.exp2f<afn> %delta_hi : vector<8xf32>
    %old_delta = scalar.subf %row_max, %next_max : f32
    %old_scale = scalar.exp2f<afn> %old_delta : f32
    %selected_old_scale = vector.splat %old_scale : vector<8xf32>
    %tile_sum_lo = vector.reduce<addf> %weight, %zero_f32 : vector<8xf32>, f32
    %tile_sum_hi = vector.reduce<addf> %weight_hi, %zero_f32 : vector<8xf32>, f32
    %scaled_sum = scalar.mulf %row_sum, %old_scale : f32
    %next_sum_lo = scalar.addf %scaled_sum, %tile_sum_lo : f32
    %next_sum = scalar.addf %next_sum_lo, %tile_sum_hi : f32
    %probability_half = vector.fptrunc %weight : vector<8xf32> to vector<8xf16>
    %probability_words = vector.bitcast %probability_half : vector<8xf16> to vector<4xi32>
    %probability_partner, %probability_valid = kernel.subgroup.shuffle<xor> %probability_words, %i32_16, %i32_32 : vector<4xi32>, i32, i32
    %probability_even = scf.select %lane_group_even, %probability_words, %probability_partner : vector<4xi32>
    %probability_odd = scf.select %lane_group_even, %probability_partner, %probability_words : vector<4xi32>
    %probability_raw = low.invoke @h3_vae_pack(%probability_even, %probability_odd) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
    %probability = vector.fragment<rhs> %probability_raw shape [%k_frag, %n] : vector<16xf16>
    %probability_hi_half = vector.fptrunc %weight_hi : vector<8xf32> to vector<8xf16>
    %probability_hi_words = vector.bitcast %probability_hi_half : vector<8xf16> to vector<4xi32>
    %probability_hi_partner, %probability_hi_valid = kernel.subgroup.shuffle<xor> %probability_hi_words, %i32_16, %i32_32 : vector<4xi32>, i32, i32
    %probability_hi_even = scf.select %lane_group_even, %probability_hi_words, %probability_hi_partner : vector<4xi32>
    %probability_hi_odd = scf.select %lane_group_even, %probability_hi_partner, %probability_hi_words : vector<4xi32>
    %probability_hi_raw = low.invoke @h3_vae_pack(%probability_hi_even, %probability_hi_odd) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
    %probability_hi = vector.fragment<rhs> %probability_hi_raw shape [%k_frag, %n] : vector<16xf16>
    %vrow0 = index.add %lane_column, %c0 : index
    %v_data0 = vector.load %v_tile[%vrow0, %c0] : view<64x40xf16> -> vector<16xf16>
    %v0 = vector.fragment<lhs> %v_data0 shape [%m, %k_frag] : vector<16xf16>
    %vrow1 = index.add %lane_column, %c16 : index
    %v_data1 = vector.load %v_tile[%vrow1, %c0] : view<64x40xf16> -> vector<16xf16>
    %v1 = vector.fragment<lhs> %v_data1 shape [%m, %k_frag] : vector<16xf16>
    %vrow2 = index.add %lane_column, %c32 : index
    %v_data2 = vector.load %v_tile[%vrow2, %c0] : view<64x40xf16> -> vector<16xf16>
    %v2 = vector.fragment<lhs> %v_data2 shape [%m, %k_frag] : vector<16xf16>
    %vrow3 = index.add %lane_column, %c48 : index
    %v_data3 = vector.load %v_tile[%vrow3, %c0] : view<64x40xf16> -> vector<16xf16>
    %v3 = vector.fragment<lhs> %v_data3 shape [%m, %k_frag] : vector<16xf16>
    %rescaled0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc0, %selected_old_scale : vector<8xf32>
    %rescaled1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc1, %selected_old_scale : vector<8xf32>
    %rescaled2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc2, %selected_old_scale : vector<8xf32>
    %rescaled3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc3, %selected_old_scale : vector<8xf32>
    %v_data_hi0 = vector.load %v_tile[%vrow0, %c16] : view<64x40xf16> -> vector<16xf16>
    %v_hi0 = vector.fragment<lhs> %v_data_hi0 shape [%m, %k_frag] : vector<16xf16>
    %v_data_hi1 = vector.load %v_tile[%vrow1, %c16] : view<64x40xf16> -> vector<16xf16>
    %v_hi1 = vector.fragment<lhs> %v_data_hi1 shape [%m, %k_frag] : vector<16xf16>
    %v_data_hi2 = vector.load %v_tile[%vrow2, %c16] : view<64x40xf16> -> vector<16xf16>
    %v_hi2 = vector.fragment<lhs> %v_data_hi2 shape [%m, %k_frag] : vector<16xf16>
    %v_data_hi3 = vector.load %v_tile[%vrow3, %c16] : view<64x40xf16> -> vector<16xf16>
    %v_hi3 = vector.fragment<lhs> %v_data_hi3 shape [%m, %k_frag] : vector<16xf16>
    %mid0 = vector.mma %v0, %probability, %rescaled0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %mid1 = vector.mma %v1, %probability, %rescaled1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %mid2 = vector.mma %v2, %probability, %rescaled2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %mid3 = vector.mma %v3, %probability, %rescaled3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %next0 = vector.mma %v_hi0, %probability_hi, %mid0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %next1 = vector.mma %v_hi1, %probability_hi, %mid1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %next2 = vector.mma %v_hi2, %probability_hi, %mid2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %next3 = vector.mma %v_hi3, %probability_hi, %mid3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next_max, %next_sum, %next0, %next1, %next2, %next3, %next_k_packet, %next_v_packet : f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<16xf16>, vector<16xf16>
  }
  %partner_sum, %sum_valid = kernel.subgroup.shuffle<xor> %final_sum, %i32_16, %i32_32 : f32, i32, i32
  %total_sum = scalar.addf %final_sum, %partner_sum : f32
  %selected_sum = vector.splat %total_sum : vector<8xf32>
  %query_present = index.cmp ult, %query_lane_row, %tokens0 : index
  %query_in_range = index.cmp ult, %query_lane_row, %token_count : index
  %query_live = scalar.andi %query_present, %query_in_range : i1
  %tile_present = index.cmp ult, %tile_in_image0, %tiles_per_image : index
  %writes0 = scalar.andi %query_live, %lane_group_even : i1
  %writes = scalar.andi %writes0, %tile_present : i1
  %out0 = vector.divf<nnan|ninf|nsz|arcp> %final0, %selected_sum : vector<8xf32>
  %out_packet0_half = vector.fptrunc %out0 : vector<8xf32> to vector<8xf16>
  %out_packet0_words = vector.bitcast %out_packet0_half : vector<8xf16> to vector<4xi32>
  %out_packet0_partner, %out_packet0_valid = kernel.subgroup.shuffle<xor> %out_packet0_words, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %out_packet0_even = scf.select %lane_group_even, %out_packet0_words, %out_packet0_partner : vector<4xi32>
  %out_packet0_odd = scf.select %lane_group_even, %out_packet0_partner, %out_packet0_words : vector<4xi32>
  %out_packet0_raw = low.invoke @h3_vae_pack(%out_packet0_even, %out_packet0_odd) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %out_packet0 = vector.bitcast %out_packet0_raw : vector<16xf16> to vector<16xf16>
  scf.if %writes {
    %out_row0 = index.assume %query_lane_row [lt(%query_lane_row, %token_count)] : index
    vector.store %out_packet0, %out_view[%out_row0, %q_channel0] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
  }
  %out1 = vector.divf<nnan|ninf|nsz|arcp> %final1, %selected_sum : vector<8xf32>
  %out_packet1_half = vector.fptrunc %out1 : vector<8xf32> to vector<8xf16>
  %out_packet1_words = vector.bitcast %out_packet1_half : vector<8xf16> to vector<4xi32>
  %out_packet1_partner, %out_packet1_valid = kernel.subgroup.shuffle<xor> %out_packet1_words, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %out_packet1_even = scf.select %lane_group_even, %out_packet1_words, %out_packet1_partner : vector<4xi32>
  %out_packet1_odd = scf.select %lane_group_even, %out_packet1_partner, %out_packet1_words : vector<4xi32>
  %out_packet1_raw = low.invoke @h3_vae_pack(%out_packet1_even, %out_packet1_odd) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %out_packet1 = vector.bitcast %out_packet1_raw : vector<16xf16> to vector<16xf16>
  scf.if %writes {
    %out_row1 = index.assume %query_lane_row [lt(%query_lane_row, %token_count)] : index
    vector.store %out_packet1, %out_view[%out_row1, %q_channel1] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
  }
  %out2 = vector.divf<nnan|ninf|nsz|arcp> %final2, %selected_sum : vector<8xf32>
  %out_packet2_half = vector.fptrunc %out2 : vector<8xf32> to vector<8xf16>
  %out_packet2_words = vector.bitcast %out_packet2_half : vector<8xf16> to vector<4xi32>
  %out_packet2_partner, %out_packet2_valid = kernel.subgroup.shuffle<xor> %out_packet2_words, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %out_packet2_even = scf.select %lane_group_even, %out_packet2_words, %out_packet2_partner : vector<4xi32>
  %out_packet2_odd = scf.select %lane_group_even, %out_packet2_partner, %out_packet2_words : vector<4xi32>
  %out_packet2_raw = low.invoke @h3_vae_pack(%out_packet2_even, %out_packet2_odd) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %out_packet2 = vector.bitcast %out_packet2_raw : vector<16xf16> to vector<16xf16>
  scf.if %writes {
    %out_row2 = index.assume %query_lane_row [lt(%query_lane_row, %token_count)] : index
    vector.store %out_packet2, %out_view[%out_row2, %q_channel2] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
  }
  %out3 = vector.divf<nnan|ninf|nsz|arcp> %final3, %selected_sum : vector<8xf32>
  %out_packet3_half = vector.fptrunc %out3 : vector<8xf32> to vector<8xf16>
  %out_packet3_words = vector.bitcast %out_packet3_half : vector<8xf16> to vector<4xi32>
  %out_packet3_partner, %out_packet3_valid = kernel.subgroup.shuffle<xor> %out_packet3_words, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %out_packet3_even = scf.select %lane_group_even, %out_packet3_words, %out_packet3_partner : vector<4xi32>
  %out_packet3_odd = scf.select %lane_group_even, %out_packet3_partner, %out_packet3_words : vector<4xi32>
  %out_packet3_raw = low.invoke @h3_vae_pack(%out_packet3_even, %out_packet3_odd) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %out_packet3 = vector.bitcast %out_packet3_raw : vector<16xf16> to vector<16xf16>
  scf.if %writes {
    %out_row3 = index.assume %query_lane_row [lt(%query_lane_row, %token_count)] : index
    vector.store %out_packet3, %out_view[%out_row3, %q_channel3] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
  }
  kernel.return
}
