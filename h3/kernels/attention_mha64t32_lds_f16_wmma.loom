// Head-64 MHA: four waves own 64 query rows and share a 32-key LDS tile.
// Transposed K Q^T and V^T P^T; scalar online statistics, packed f16 exchange.
// All 128 lanes stage distinct K/V packets and prefetch the next tile.
// Online softmax, f32 accumulators, f16 output.
// ATTN_STEM=attention_mha64t32_lds_f16_wmma.
amdgpu.target<gfx11-generic> @h3_attention_mha64t32_lds_f16_wmma_gfx11 {subgroup_size = 32}

config.decl @h3.attention_mha64t32_lds_f16_wmma.q_stride : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

config.decl @h3.attention_mha64t32_lds_f16_wmma.kv_stride : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

config.decl @h3.attention_mha64t32_lds_f16_wmma.out_stride : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

config.decl @h3.attention_mha64t32_lds_f16_wmma.tokens : %value: index where [range(%value, 1, 65536)]

config.decl @h3.attention_mha64t32_lds_f16_wmma.token_capacity : %value: index where [range(%value, 32, 1048576), mul(%value, 16)]

config.decl @h3.attention_mha64t32_lds_f16_wmma.scale : f32

low.func.def target<amdgpu.gfx11.generic.core>(@h3_attention_mha64t32_lds_f16_wmma_gfx11) @h3_vae_pack(%even: reg<amdgpu.vgpr x4>, %odd: reg<amdgpu.vgpr x4>) -> (reg<amdgpu.vgpr x8>) asm {
  %lo = s_mov_b32 84148480
  %hi = s_mov_b32 117834498
  %e0 = slice %even[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %o0 = slice %odd[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %p0 = v_perm_b32 %o0, %e0, %lo
  %p1 = v_perm_b32 %o0, %e0, %hi
  %e1 = slice %even[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %o1 = slice %odd[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %p2 = v_perm_b32 %o1, %e1, %lo
  %p3 = v_perm_b32 %o1, %e1, %hi
  %e2 = slice %even[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %o2 = slice %odd[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %p4 = v_perm_b32 %o2, %e2, %lo
  %p5 = v_perm_b32 %o2, %e2, %hi
  %e3 = slice %even[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %o3 = slice %odd[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %p6 = v_perm_b32 %o3, %e3, %lo
  %p7 = v_perm_b32 %o3, %e3, %hi
  %p = concat(%p0, %p1, %p2, %p3, %p4, %p5, %p6, %p7) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x8>
