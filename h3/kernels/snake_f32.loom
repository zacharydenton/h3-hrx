// Snake activation with a per-channel alpha (beta = alpha) on f32 [channels][len] planes, in place or out of place:
//   out = x + sin(alpha x)^2 / (alpha + 1e-9)
amdgpu.target<gfx11-generic> @h3_snake_f32_gfx11 {subgroup_size = 32}

config.decl @h3.snake_f32.channels : %value: index where [range(%value, 1, 4096)]

config.decl @h3.snake_f32.len_bound : %value: index where [range(%value, 256, 4194304), mul(%value, 256)]

kernel.def target(@h3_snake_f32_gfx11) export("h3_snake_f32") @h3_snake_f32(%len: index) {
  %c1 = index.constant 1 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %channels = config.get @h3.snake_f32.channels : index
  %rounded = index.add %len, %c255 : index
  %groups = index.div %rounded, %c256 : index
  kernel.launch.config workgroups(%groups, %channels, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%len: index, %x: buffer, %alpha: buffer, %out: buffer) {
  %channels = config.get @h3.snake_f32.channels : index
  %len_bound = config.get @h3.snake_f32.len_bound : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %tiny = scalar.constant 1.0000000000000001e-09 : f32
  %len_b = index.assume %len [range(%len, 1, 4194304), le(%len, %len_bound)] : index
  %wg = kernel.workgroup.id<x> : index
  %c0 = kernel.workgroup.id<y> : index
  %c = index.assume %c0 [lt(%c0, %channels)] : index
  %lane = kernel.workitem.id<x> : index
  %base = index.mul %wg, %c256 : index
  %n = index.add %base, %lane : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %a_global = buffer.assume.memory_space<global> %alpha : buffer
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %x_view = buffer.view %x_global[%c0_offset] : buffer -> view<[%channels]x[%len_b]xf32>
  %a_view = buffer.view %a_global[%c0_offset] : buffer -> view<[%channels]xf32>
  %out_view = buffer.view %out_global[%c0_offset] : buffer -> view<[%channels]x[%len_b]xf32>
  %active = index.cmp ult, %n, %len_b : index
  scf.if %active {
    %nn = index.assume %n [lt(%n, %len_b)] : index
    %a = view.load %a_view[%c] : view<[%channels]xf32> -> f32
    %v = view.load %x_view[%c, %nn] : view<[%channels]x[%len_b]xf32> -> f32
    %arg = scalar.mulf %a, %v : f32
    %s = scalar.sinf<afn> %arg : f32
    %s2 = scalar.mulf %s, %s : f32
    %den = scalar.addf %a, %tiny : f32
    %q = scalar.divf %s2, %den : f32
    %r = scalar.addf %v, %q : f32
    view.store %r, %out_view[%c, %nn] : f32, view<[%channels]x[%len_b]xf32>
  }
  kernel.return
}
