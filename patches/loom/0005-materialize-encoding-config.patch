 loom/src/loom/ops/config/BUILD.bazel          |  3 +
 loom/src/loom/ops/config/CMakeLists.txt       |  3 +
 loom/src/loom/ops/config/canonicalize.c       | 40 ++++++++++
 loom/src/loom/ops/config/ops.h                |  2 +
 .../ops/config/test/canonicalize.loom-test    | 51 ++++++++++++
 ...source_low_mma_fragment_epilogue.loom-test | 80 +++++++++++++++++++
 7 files changed, 180 insertions(+)
 create mode 100644 loom/src/loom/ops/config/canonicalize.c

