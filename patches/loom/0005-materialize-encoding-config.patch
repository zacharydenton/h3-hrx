+++ b/loom/src/loom/ops/config/ops.h
@@ -77,6 +77,8 @@ iree_status_t loom_config_def_verify(
 LOOM_DEFINE_ISA(loom_config_get_isa, LOOM_OP_CONFIG_GET)
 LOOM_DEFINE_RESULT(loom_config_get_result, 0)
 LOOM_DEFINE_ATTR_SYMBOL(loom_config_get_config, 0)
+iree_status_t loom_config_get_canonicalize(loom_op_t* op,
+                                          loom_rewriter_t* rewriter);
 iree_status_t loom_config_get_build(
     loom_builder_t* builder,
     loom_symbol_ref_t config,
diff --git a/loom/src/loom/ops/config/test/canonicalize.loom-test b/loom/src/loom/ops/config/test/canonicalize.loom-test
index 941b00750..121a01f8a 100644
--- a/loom/src/loom/ops/config/test/canonicalize.loom-test
+++ b/loom/src/loom/ops/config/test/canonicalize.loom-test
@@ -150,3 +150,54 @@ func.def @read_decl_config_facts() -> (i64, i64, i64) {
   %divisor = scalar.constant 4 : i64
   func.return %lo, %hi, %divisor : i64, i64, i64
 }
+
+// ====
+
+config.def @exact_schema = #encoding.operand<element_format=i4, payload_elements=16, payload_registers=2> : encoding<schema>
+
+func.def @return_schema() -> (encoding<schema>) {
+  %value = config.get @exact_schema : encoding<schema>
+  func.return %value : encoding<schema>
+}
+
+// ----
+config.def @exact_schema = #encoding.operand<element_format=i4, payload_elements=16, payload_registers=2> : encoding<schema>
+
+func.def @return_schema() -> (encoding<schema>) {
+  %value = encoding.define #encoding.operand<element_format=i4, payload_elements=16, payload_registers=2> : encoding<schema>
+  func.return %value : encoding<schema>
+}
+
+// ====
+
+config.def @exact_layout = #encoding.layout.dense : encoding<layout>
+
+func.def @return_layout() -> (encoding<layout>) {
+  %value = config.get @exact_layout : encoding<layout>
+  func.return %value : encoding<layout>
+}
+
+// ----
+config.def @exact_layout = #encoding.layout.dense : encoding<layout>
+
+func.def @return_layout() -> (encoding<layout>) {
+  %value = encoding.define #encoding.layout.dense : encoding<layout>
+  func.return %value : encoding<layout>
+}
+
+// ====
+
+config.decl @unresolved_schema : encoding<schema>
+
+func.def @return_unresolved_schema() -> (encoding<schema>) {
+  %value = config.get @unresolved_schema : encoding<schema>
+  func.return %value : encoding<schema>
+}
+
+// ----
+config.decl @unresolved_schema : encoding<schema>
+
+func.def @return_unresolved_schema() -> (encoding<schema>) {
+  %value = config.get @unresolved_schema : encoding<schema>
+  func.return %value : encoding<schema>
+}
diff --git a/loom/src/loom/target/arch/amdgpu/test/source_low/source_low_mma_fragment_epilogue.loom-test b/loom/src/loom/target/arch/amdgpu/test/source_low/source_low_mma_fragment_epilogue.loom-test
index 363c1c028..75f8a81c7 100644
--- a/loom/src/loom/target/arch/amdgpu/test/source_low/source_low_mma_fragment_epilogue.loom-test
+++ b/loom/src/loom/target/arch/amdgpu/test/source_low/source_low_mma_fragment_epilogue.loom-test
@@ -1707,3 +1707,83 @@ kernel.def target(@target) @report_large_scaled_bf16_result_epilogue_group() {
   vector.fragment.store<result> %epilogue3, %output_view[0, 48] shape [%m, %n] : vector<8xf32>, view<16x64xbf16>
   kernel.return
 }
+
+// ====
+
+// RUN: emit source-low output=none
+// Exact encoding configuration feeds packed matrix fragments.
+amdgpu.target<gfx11-generic> @probe_gfx11 {subgroup_size = 32}
+
+config.def @probe.schema = #encoding.operand<element_format=i4, payload_elements=16, payload_registers=2> : encoding<schema>
+
+config.def @probe.registers = 2 : index
+
+kernel.def target(@probe_gfx11) export("packed_probe") @packed_probe() {
+  %one = index.constant 1 : index
+  %threads = index.constant 32 : index
+  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
+} launch(%a: buffer, %b: buffer, %out: buffer) {
+  %zero = index.constant 0 : index
+  %offset = index.constant 0 : offset
+  %sixteen = index.constant 16 : index
+  %registers = config.get @probe.registers : index
+  %schema = config.get @probe.schema : encoding<schema>
+  %lane = kernel.subgroup.lane.id : index
+  %ag = buffer.assume.memory_space<global> %a : buffer
+  %bg = buffer.assume.memory_space<global> %b : buffer
+  %og = buffer.assume.memory_space<global> %out : buffer
+  %av = buffer.view %ag[%offset] : buffer -> view<32x4xi32>
+  %bv = buffer.view %bg[%offset] : buffer -> view<32x4xi32>
+  %ov = buffer.view %og[%offset] : buffer -> view<32x8xi32>
+  %ap = vector.load %av[%lane, %zero] : view<32x4xi32> -> vector<[%registers]xi32>
+  %bp = vector.load %bv[%lane, %zero] : view<32x4xi32> -> vector<[%registers]xi32>
+  %lhs = vector.fragment<lhs> %ap shape [%sixteen, %sixteen] using {schema = %schema : encoding<schema>} : vector<[%registers]xi32>
+  %rhs = vector.fragment<rhs> %bp shape [%sixteen, %sixteen] using {schema = %schema : encoding<schema>} : vector<[%registers]xi32>
+  %zeros = vector.constant 0 : vector<8xi32>
+  %init = vector.fragment<init> %zeros shape [%sixteen, %sixteen] : vector<8xi32>
+  %acc = vector.mma %lhs, %rhs, %init : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
+  vector.store %acc, %ov[%lane, %zero] : vector<8xi32>, view<32x8xi32>
+  kernel.return
+}
+
+// ----
+
+// ====
+
+// RUN: emit source-low output=none
+// Exact encoding configuration feeds packed matrix fragments.
+amdgpu.target<gfx11-generic> @probe_gfx11 {subgroup_size = 32}
+
+config.def @probe.schema = #encoding.operand<element_format=i8, payload_elements=16, payload_registers=4> : encoding<schema>
+
+config.def @probe.registers = 4 : index
+
+kernel.def target(@probe_gfx11) export("packed_probe") @packed_probe() {
+  %one = index.constant 1 : index
+  %threads = index.constant 32 : index
+  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
+} launch(%a: buffer, %b: buffer, %out: buffer) {
+  %zero = index.constant 0 : index
+  %offset = index.constant 0 : offset
+  %sixteen = index.constant 16 : index
+  %registers = config.get @probe.registers : index
+  %schema = config.get @probe.schema : encoding<schema>
+  %lane = kernel.subgroup.lane.id : index
+  %ag = buffer.assume.memory_space<global> %a : buffer
+  %bg = buffer.assume.memory_space<global> %b : buffer
+  %og = buffer.assume.memory_space<global> %out : buffer
+  %av = buffer.view %ag[%offset] : buffer -> view<32x4xi32>
+  %bv = buffer.view %bg[%offset] : buffer -> view<32x4xi32>
+  %ov = buffer.view %og[%offset] : buffer -> view<32x8xi32>
+  %ap = vector.load %av[%lane, %zero] : view<32x4xi32> -> vector<[%registers]xi32>
+  %bp = vector.load %bv[%lane, %zero] : view<32x4xi32> -> vector<[%registers]xi32>
+  %lhs = vector.fragment<lhs> %ap shape [%sixteen, %sixteen] using {schema = %schema : encoding<schema>} : vector<[%registers]xi32>
+  %rhs = vector.fragment<rhs> %bp shape [%sixteen, %sixteen] using {schema = %schema : encoding<schema>} : vector<[%registers]xi32>
+  %zeros = vector.constant 0 : vector<8xi32>
+  %init = vector.fragment<init> %zeros shape [%sixteen, %sixteen] : vector<8xi32>
+  %acc = vector.mma %lhs, %rhs, %init : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
+  vector.store %acc, %ov[%lane, %zero] : vector<8xi32>, view<32x8xi32>
+  kernel.return
+}
