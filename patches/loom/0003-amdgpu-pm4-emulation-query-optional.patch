From f6e266a77771f1d730b31598def5fc67a1b3e17a Mon Sep 17 00:00:00 2001
From: Zach Denton <z@chdenton.com>
Date: Tue, 8 Sep 2026 09:29:08 +0200
Subject: [PATCH] [HAL/AMDGPU] Answer an unsupported PM4-emulation query
 natively

iree_hal_amdgpu_query_aql_queue_execution_mode queries
HSA_AMD_AGENT_INFO_PM4_EMULATION and propagates every failure, so device
initialization aborts on any ROCr that predates the attribute. The value is
0xA119; a stock HSA 1.18 runtime's HSA_AMD_AGENT_INFO_ enum ends at 0xA118
(HSA_AMD_AGENT_INFO_CLOCK_COUNTERS) and returns INVALID_ARGUMENT for anything
past it, so hrx_gpu_initialize fails outright with

  [hsa_agent_get_info] HSA_STATUS_ERROR_INVALID_ARGUMENT: ...
  querying HSA_AMD_AGENT_INFO_PM4_EMULATION

INVALID_ARGUMENT from this query specifically means the attribute is unknown,
and a runtime that does not know it is not emulating PM4, so that case is
answered by the already-false default instead of failing startup. Every other
status is a real failure and still propagates, which the existing
FailurePropagates test now covers with OUT_OF_RESOURCES.

Verified on gfx1151 (Radeon 8060S) against a distribution HSA 1.18: before the
change hrx_gpu_initialize failed in 0.25 s; after it a full text-to-video
denoise plus video and audio decode runs to completion, and its frames and
samples are bit-identical to the same workload run through the HIP backend.
---
 .../iree/hal/drivers/amdgpu/util/aql_ring.c   | 21 +++++++++++----
 .../hal/drivers/amdgpu/util/aql_ring_test.cc  | 26 +++++++++++++++----
 2 files changed, 37 insertions(+), 10 deletions(-)

diff --git a/runtime/src/iree/hal/drivers/amdgpu/util/aql_ring.c b/runtime/src/iree/hal/drivers/amdgpu/util/aql_ring.c
index 39248361c..ff925f603 100644
--- a/runtime/src/iree/hal/drivers/amdgpu/util/aql_ring.c
+++ b/runtime/src/iree/hal/drivers/amdgpu/util/aql_ring.c
@@ -12,12 +12,23 @@ iree_status_t iree_hal_amdgpu_query_aql_queue_execution_mode(
   IREE_ASSERT_ARGUMENT(libhsa);
   IREE_ASSERT_ARGUMENT(out_execution_mode);
 
+  // HSA_AMD_AGENT_INFO_PM4_EMULATION (0xA119) postdates ROCr 1.18, whose agent
+  // attribute enum ends at 0xA118; such runtimes reject the query with
+  // INVALID_ARGUMENT. That status specifically means the attribute is unknown,
+  // and a runtime that does not know it is not emulating PM4, so the query is
+  // answered by the default rather than failing device initialization. Any
+  // other status is a real failure and still propagates.
   bool pm4_emulation = false;
-  IREE_RETURN_IF_ERROR(
-      iree_hsa_agent_get_info(
-          IREE_LIBHSA(libhsa), device_agent,
-          (hsa_agent_info_t)HSA_AMD_AGENT_INFO_PM4_EMULATION, &pm4_emulation),
-      "querying HSA_AMD_AGENT_INFO_PM4_EMULATION");
+  iree_status_t pm4_status = iree_hsa_agent_get_info(
+      IREE_LIBHSA(libhsa), device_agent,
+      (hsa_agent_info_t)HSA_AMD_AGENT_INFO_PM4_EMULATION, &pm4_emulation);
+  if (iree_status_is_invalid_argument(pm4_status)) {
+    iree_status_ignore(pm4_status);
+    pm4_emulation = false;
+  } else {
+    IREE_RETURN_IF_ERROR(pm4_status,
+                         "querying HSA_AMD_AGENT_INFO_PM4_EMULATION");
+  }
   *out_execution_mode =
       pm4_emulation ? IREE_HAL_AMDGPU_AQL_QUEUE_EXECUTION_MODE_PM4_EMULATED
                     : IREE_HAL_AMDGPU_AQL_QUEUE_EXECUTION_MODE_NATIVE;
diff --git a/runtime/src/iree/hal/drivers/amdgpu/util/aql_ring_test.cc b/runtime/src/iree/hal/drivers/amdgpu/util/aql_ring_test.cc
index 127b9b620..fdf729921 100644
--- a/runtime/src/iree/hal/drivers/amdgpu/util/aql_ring_test.cc
+++ b/runtime/src/iree/hal/drivers/amdgpu/util/aql_ring_test.cc
@@ -72,17 +72,33 @@ TEST(AqlRingTest, QueriesAqlQueueExecutionMode) {
   EXPECT_EQ(query.query_count, 2u);
 }
 
-TEST(AqlRingTest, AqlQueueExecutionQueryFailurePropagates) {
+// A runtime older than HSA_AMD_AGENT_INFO_PM4_EMULATION (0xA119) rejects the
+// query with INVALID_ARGUMENT. It is not emulating PM4, so the attribute being
+// unknown must answer the query natively rather than fail device startup.
+TEST(AqlRingTest, UnsupportedAqlQueueExecutionQueryIsNative) {
   iree_hal_amdgpu_libhsa_t libhsa = AqlQueueExecutionQueryLibhsa();
   AqlQueueExecutionQuery query;
   query.status = HSA_STATUS_ERROR_INVALID_ARGUMENT;
+  query.pm4_emulation = true;  // never written: the query fails
+  iree_hal_amdgpu_aql_queue_execution_mode_t execution_mode =
+      kPm4EmulatedAqlQueue;
+
+  IREE_ASSERT_OK(iree_hal_amdgpu_query_aql_queue_execution_mode(
+      &libhsa, AqlQueueExecutionQueryAgent(&query), &execution_mode));
+  EXPECT_EQ(execution_mode, kNativeAqlQueue);
+  EXPECT_EQ(query.query_count, 1u);
+}
+
+// Any other status is a real failure and still propagates.
+TEST(AqlRingTest, AqlQueueExecutionQueryFailurePropagates) {
+  iree_hal_amdgpu_libhsa_t libhsa = AqlQueueExecutionQueryLibhsa();
+  AqlQueueExecutionQuery query;
+  query.status = HSA_STATUS_ERROR_OUT_OF_RESOURCES;
   iree_hal_amdgpu_aql_queue_execution_mode_t execution_mode =
       kPm4EmulatedAqlQueue;
 
-  IREE_EXPECT_STATUS_IS(
-      IREE_STATUS_INVALID_ARGUMENT,
-      iree_hal_amdgpu_query_aql_queue_execution_mode(
-          &libhsa, AqlQueueExecutionQueryAgent(&query), &execution_mode));
+  EXPECT_FALSE(iree_status_is_ok(iree_hal_amdgpu_query_aql_queue_execution_mode(
+      &libhsa, AqlQueueExecutionQueryAgent(&query), &execution_mode)));
   EXPECT_EQ(execution_mode, kPm4EmulatedAqlQueue);
   EXPECT_EQ(query.query_count, 1u);
 }
-- 
