From 8b2d1e882d28eb386bccd65fe702bd87119266ce Mon Sep 17 00:00:00 2001
From: Zach Denton <z@chdenton.com>
Date: Sun, 6 Sep 2026 22:14:18 +0200
Subject: [PATCH 2/2] sink-single-use-reads: keep reads that feed a matrix
 fragment where the source put them

A single-use vector read whose sole user is vector.fragment is an operand-latency load: the
source issues it early so the matrix multiplies between the read and the fragment cover the
LDS or global latency. Sinking it next to the fragment left the WMMA waiting on the read
(lgkmcnt(3..0) two or three multiplies after issue). Reads feeding a fragment now stay in
source order; other single-use reads sink as before. Verified on a 256x128 int8 WMMA GEMM:
with sub-step s+1's fragment reads written before sub-step s's multiplies the ISA now issues
16 reads ahead and waits at lgkmcnt(11..8); kernels written just-in-time are unchanged.
---
 loom/src/loom/transforms/vector/sink_single_use_reads.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/loom/src/loom/transforms/vector/sink_single_use_reads.c b/loom/src/loom/transforms/vector/sink_single_use_reads.c
index 870d27877..44853fa84 100644
--- a/loom/src/loom/transforms/vector/sink_single_use_reads.c
+++ b/loom/src/loom/transforms/vector/sink_single_use_reads.c
@@ -9,6 +9,7 @@
 #include "loom/analysis/motion.h"
 #include "loom/ir/module.h"
 #include "loom/ops/op_defs.h"
+#include "loom/ops/vector/ops.h"
 #include "loom/rewrite/rewriter.h"
 
 //===----------------------------------------------------------------------===//
@@ -201,6 +202,12 @@ static bool loom_sink_single_use_reads_find_same_block_user(
       user_op->block_ordinal <= op->block_ordinal) {
     return false;
   }
+  // A read feeding a matrix fragment is an operand-latency load: the source
+  // placed it early on purpose (the LDS or global latency is covered by the
+  // matrix multiplies between the read and its fragment), and sinking it next
+  // to the fragment leaves the multiply waiting on the read. Keep it where the
+  // source put it.
+  if (loom_vector_fragment_isa(user_op)) return false;
   const loom_trait_flags_t user_traits =
       loom_op_effective_traits(context->module, user_op);
   if (!iree_any_bit_set(user_traits, LOOM_TRAIT_PURE) ||
