+
+// --- f32 result -> packed-F16 RHS through the half-swap exchange -------------
+//
+// gfx11 wave32 WMMA 16x16x16 with a 32-bit accumulator: result lane l holds
+// column (l mod 16) at rows 2i + (l / 16), i = 0..7. The F16 RHS operand lane l
+// holds column (l mod 16) at k = 0..15, packed two per register (low = even k).
+// Register i of the RHS is therefore (row 2i, row 2i + 1) = (own, partner) in
+// the low half and (partner, own) in the high half, partner = lane ^ 16: one
+// f32 -> f16 convert, one exchange and one byte permute per register, the
+// permute selector chosen once per lane (CK-tile's PermuteWarpGemmCToA).
+static bool loom_amdgpu_fragment_layout_is_gfx11_wave32_acc32(uint32_t kind) {
+  switch (kind) {
+    case LOOM_AMDGPU_MATRIX_FRAGMENT_LAYOUT_RDNA3_WMMAR3_F32_16X16X16_F16:
+    case LOOM_AMDGPU_MATRIX_FRAGMENT_LAYOUT_RDNA3_WMMAR3_F32_16X16X16_BF16:
+    case LOOM_AMDGPU_MATRIX_FRAGMENT_LAYOUT_RDNA3_WMMAR3_I32_16X16X16_IU8:
+    case LOOM_AMDGPU_MATRIX_FRAGMENT_LAYOUT_RDNA3_WMMAR3_I32_16X16X16_IU4:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool loom_amdgpu_select_result_f32_to_rhs_b16_permlane_fragment_repack_plan(
+    const loom_low_descriptor_set_t* descriptor_set,
+    const loom_amdgpu_matrix_fragment_layout_t* layout,
+    loom_amdgpu_fragment_repack_plan_t* plan) {
+  // An MMA output carries the accumulator role; its lane layout is the result's.
+  if ((plan->source_role != LOOM_CONTRACT_OPERAND_ROLE_RESULT &&
+       plan->source_role != LOOM_CONTRACT_OPERAND_ROLE_ACCUMULATOR) ||
+      plan->result_role != LOOM_CONTRACT_OPERAND_ROLE_RHS ||
+      layout->wave_size != 32 ||
+      !loom_amdgpu_fragment_layout_is_gfx11_wave32_acc32(layout->kind) ||
+      layout->result.register_count != 8 ||
+      layout->result.element_bit_count != 32 ||
+      loom_type_element_type(plan->source_type) != LOOM_SCALAR_TYPE_F32 ||
+      loom_type_element_type(plan->result_type) != LOOM_SCALAR_TYPE_F16) {
+    return false;
+  }
+  static const loom_amdgpu_descriptor_ref_t kRequiredDescriptorRefs[] = {
+      LOOM_AMDGPU_DESCRIPTOR_REF_S_MOV_B32_VCC_IMM,
+      LOOM_AMDGPU_DESCRIPTOR_REF_V_CNDMASK_B32_SRC0_LIT_VCC,
+      LOOM_AMDGPU_DESCRIPTOR_REF_V_MOV_B32,
+      LOOM_AMDGPU_DESCRIPTOR_REF_V_PERM_B32,
+      LOOM_AMDGPU_DESCRIPTOR_REF_V_CVT_F16_F32,
+      LOOM_AMDGPU_DESCRIPTOR_REF_V_PACK_B32_F16,
+  };
+  if (!loom_amdgpu_descriptor_set_has_all_refs(
+          descriptor_set, kRequiredDescriptorRefs,
+          IREE_ARRAYSIZE(kRequiredDescriptorRefs))) {
+    return false;
+  }
+  loom_amdgpu_direct_xor_lane_recipe_t exchange = {0};
+  if (!loom_amdgpu_select_direct_xor_lane_recipe(descriptor_set,
+                                                 /*width=*/32, /*lane_xor=*/16,
+                                                 &exchange)) {
+    return false;
+  }
+  plan->strategy =
+      LOOM_AMDGPU_FRAGMENT_REPACK_STRATEGY_RESULT_F32_TO_RHS_B16_PERMLANE;
+  plan->reason = LOOM_AMDGPU_FRAGMENT_REPACK_REASON_NONE;
+  plan->native_contraction_facts = layout->native_contraction_facts;
+  plan->native_transition_facts = NULL;
+  plan->source_register_count = 8;
+  plan->result_register_count = 8;
+  plan->strategy_payload.result_f32_to_rhs_permlane.exchange = exchange;
+  plan->strategy_payload.result_f32_to_rhs_permlane.pack_ref =
+      LOOM_AMDGPU_DESCRIPTOR_REF_V_CVT_F16_F32;
+  plan->strategy_payload.result_f32_to_rhs_permlane.high_half_lane_mask =
+      0xFFFF0000u;
+  return true;
+}
+
+iree_status_t loom_amdgpu_lower_result_f32_to_rhs_b16_permlane_fragment_repack(
+    loom_low_lower_context_t* context, const loom_op_t* source_op,
+    const loom_amdgpu_fragment_repack_plan_t* plan) {
+  const loom_amdgpu_direct_xor_lane_recipe_t* exchange =
+      &plan->strategy_payload.result_f32_to_rhs_permlane.exchange;
+  loom_value_id_t low_source = LOOM_VALUE_ID_INVALID;
+  IREE_RETURN_IF_ERROR(
+      loom_low_lower_lookup_value(context, plan->source, &low_source));
+  loom_type_t vgpr_type = loom_type_none();
+  IREE_RETURN_IF_ERROR(loom_amdgpu_make_vgpr_type(context, &vgpr_type));
+  loom_type_t vcc_type = loom_type_none();
+  IREE_RETURN_IF_ERROR(loom_amdgpu_make_vcc_type(context, &vcc_type));
+  loom_low_lower_resolved_descriptor_t exchange_descriptor = {0};
+  IREE_RETURN_IF_ERROR(loom_amdgpu_resolve_descriptor_ref(
+      context, exchange->descriptor_ref, &exchange_descriptor));
+  loom_low_lower_resolved_descriptor_t vcc_constant_descriptor = {0};
+  IREE_RETURN_IF_ERROR(loom_amdgpu_resolve_descriptor_ref(
+      context, LOOM_AMDGPU_DESCRIPTOR_REF_S_MOV_B32_VCC_IMM,
+      &vcc_constant_descriptor));
+  loom_low_lower_resolved_descriptor_t selector_descriptor = {0};
+  IREE_RETURN_IF_ERROR(loom_amdgpu_resolve_descriptor_ref(
+      context, LOOM_AMDGPU_DESCRIPTOR_REF_V_CNDMASK_B32_SRC0_LIT_VCC,
+      &selector_descriptor));
+  loom_low_lower_resolved_descriptor_t permute_descriptor = {0};
+  IREE_RETURN_IF_ERROR(loom_amdgpu_resolve_descriptor_ref(
+      context, LOOM_AMDGPU_DESCRIPTOR_REF_V_PERM_B32, &permute_descriptor));
+  loom_low_lower_resolved_descriptor_t convert_descriptor = {0};
+  IREE_RETURN_IF_ERROR(loom_amdgpu_resolve_descriptor_ref(
+      context, plan->strategy_payload.result_f32_to_rhs_permlane.pack_ref,
+      &convert_descriptor));
+  // The per-lane byte selector: (own.low16, partner.low16) in the low half of
+  // the wave, (partner.low16, own.low16) in the high half.
+  loom_value_id_t low_high_half = LOOM_VALUE_ID_INVALID;
+  IREE_RETURN_IF_ERROR(loom_amdgpu_fragment_repack_vcc_constant(
+      context, source_op, &vcc_constant_descriptor,
+      plan->strategy_payload.result_f32_to_rhs_permlane.high_half_lane_mask,
+      vcc_type, &low_high_half));
+  // v_perm_b32 with both sources the packed pair: identity below lane 16,
+  // the halfword swap above.
+  loom_value_id_t low_reversed_selector = LOOM_VALUE_ID_INVALID;
+  IREE_RETURN_IF_ERROR(loom_amdgpu_emit_const_u32(
+      context, source_op, LOOM_AMDGPU_DESCRIPTOR_REF_V_MOV_B32,
+      /*halfword swap*/ 0x01000302u, vgpr_type, &low_reversed_selector));
+  loom_named_attr_t selector_attrs[1];
+  iree_host_size_t selector_attr_count = 0;
+  IREE_RETURN_IF_ERROR(loom_amdgpu_append_i64_attr(
+      context, IREE_SV("imm32"), /*identity*/ 0x03020100u, selector_attrs,
+      IREE_ARRAYSIZE(selector_attrs), &selector_attr_count));
+  const loom_value_id_t selector_operands[] = {low_reversed_selector,
+                                               low_high_half};
+  loom_op_t* low_selector_op = NULL;
+  IREE_RETURN_IF_ERROR(loom_low_lower_emit_resolved_descriptor_op(
+      context, &selector_descriptor, selector_operands,
+      IREE_ARRAYSIZE(selector_operands),
+      loom_make_named_attr_slice(selector_attrs, selector_attr_count),
+      &vgpr_type, 1, /*tied_results=*/NULL, /*tied_result_count=*/0,
+      source_op->location, &low_selector_op));
+  const loom_value_id_t low_selector =
+      loom_value_slice_get(loom_low_op_results(low_selector_op), 0);
+  loom_low_lower_resolved_descriptor_t pack_descriptor = {0};
+  IREE_RETURN_IF_ERROR(loom_amdgpu_resolve_descriptor_ref(
+      context, LOOM_AMDGPU_DESCRIPTOR_REF_V_PACK_B32_F16, &pack_descriptor));
+  // Exchange the f32 registers first (full-register payloads), then convert
+  // own and partner to f16 and pack them; the per-lane byte selector orders
+  // the pair (own, partner) in the low half of the wave, (partner, own) above.
+  loom_value_id_t source_registers[LOOM_AMDGPU_MAX_SCALARIZED_32BIT_LANES] = {
+      LOOM_VALUE_ID_INVALID};
+  loom_value_id_t partner_registers[LOOM_AMDGPU_MAX_SCALARIZED_32BIT_LANES] = {
+      LOOM_VALUE_ID_INVALID};
+  for (uint16_t i = 0; i < plan->source_register_count; ++i) {
+    IREE_RETURN_IF_ERROR(loom_amdgpu_emit_low_slice(
+        context, source_op, low_source, i, vgpr_type, &source_registers[i]));
+  }
+  for (uint16_t i = 0; i < plan->source_register_count; ++i) {
+    IREE_RETURN_IF_ERROR(loom_amdgpu_emit_direct_crosslane_register(
+        context, source_op, &exchange_descriptor, exchange->crosslane_kind,
+        source_registers[i], exchange->immediate, vgpr_type,
+        &partner_registers[i]));
+  }
+  loom_value_id_t result_registers[LOOM_AMDGPU_MAX_SCALARIZED_32BIT_LANES] = {
+      LOOM_VALUE_ID_INVALID};
+  for (uint16_t i = 0; i < plan->source_register_count; ++i) {
+    loom_value_id_t halves[2] = {LOOM_VALUE_ID_INVALID, LOOM_VALUE_ID_INVALID};
+    const loom_value_id_t full[2] = {source_registers[i], partner_registers[i]};
+    for (int h = 0; h < 2; ++h) {
+      loom_op_t* convert_op = NULL;
+      IREE_RETURN_IF_ERROR(loom_low_lower_emit_resolved_descriptor_op(
+          context, &convert_descriptor, &full[h], 1,
+          loom_named_attr_slice_empty(), &vgpr_type, 1, /*tied_results=*/NULL,
+          /*tied_result_count=*/0, source_op->location, &convert_op));
+      halves[h] = loom_value_slice_get(loom_low_op_results(convert_op), 0);
+    }
+    loom_op_t* pack_op = NULL;
+    IREE_RETURN_IF_ERROR(loom_low_lower_emit_resolved_descriptor_op(
+        context, &pack_descriptor, halves, 2, loom_named_attr_slice_empty(),
+        &vgpr_type, 1, /*tied_results=*/NULL, /*tied_result_count=*/0,
+        source_op->location, &pack_op));
+    const loom_value_id_t packed =
+        loom_value_slice_get(loom_low_op_results(pack_op), 0);
+    const loom_value_id_t permute_operands[] = {packed, packed, low_selector};
+    loom_op_t* low_permute_op = NULL;
+    IREE_RETURN_IF_ERROR(loom_low_lower_emit_resolved_descriptor_op(
+        context, &permute_descriptor, permute_operands,
+        IREE_ARRAYSIZE(permute_operands), loom_named_attr_slice_empty(),
+        &vgpr_type, 1, /*tied_results=*/NULL, /*tied_result_count=*/0,
+        source_op->location, &low_permute_op));
+    result_registers[i] =
+        loom_value_slice_get(loom_low_op_results(low_permute_op), 0);
+  }
+  return loom_amdgpu_bind_low_register_range(context, source_op, plan->result,
+                                             result_registers,
+                                             plan->result_register_count);
+}
