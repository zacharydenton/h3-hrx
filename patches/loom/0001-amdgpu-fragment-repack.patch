     loom_low_lower_context_t* context, const loom_op_t* source_op,
     const loom_amdgpu_fragment_repack_plan_t* plan);
 
+// f32 result (rows 2i + half per lane) to packed-B16 RHS (k pairs per
+// register): v_permlanex16 half swap, two selects and a pack per register.
+bool loom_amdgpu_select_result_f32_to_rhs_b16_permlane_fragment_repack_plan(
+    const loom_low_descriptor_set_t* descriptor_set,
+    const loom_amdgpu_matrix_fragment_layout_t* layout,
+    loom_amdgpu_fragment_repack_plan_t* plan);
+iree_status_t loom_amdgpu_lower_result_f32_to_rhs_b16_permlane_fragment_repack(
+    loom_low_lower_context_t* context, const loom_op_t* source_op,
+    const loom_amdgpu_fragment_repack_plan_t* plan);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
diff --git a/loom/src/loom/target/arch/amdgpu/lower/plan.h b/loom/src/loom/target/arch/amdgpu/lower/plan.h
index d0adc5c67..422aa4cc7 100644
--- a/loom/src/loom/target/arch/amdgpu/lower/plan.h
+++ b/loom/src/loom/target/arch/amdgpu/lower/plan.h
@@ -1000,6 +1000,9 @@ typedef enum loom_amdgpu_crosslane_kind_e {
   LOOM_AMDGPU_CROSSLANE_DPP = 1,
   // Use DS swizzle with a bitmask permutation immediate.
   LOOM_AMDGPU_CROSSLANE_SWIZZLE = 2,
+  // Use v_permlanex16_b32 to exchange the two 16-lane halves of each 32-lane
+  // group (lane xor 16) without touching the LDS crossbar (gfx10+).
+  LOOM_AMDGPU_CROSSLANE_PERMLANEX16 = 3,
 } loom_amdgpu_crosslane_kind_t;
 
 typedef struct loom_amdgpu_direct_xor_lane_recipe_t {
@@ -1631,6 +1634,10 @@ typedef enum loom_amdgpu_fragment_repack_strategy_e {
   LOOM_AMDGPU_FRAGMENT_REPACK_STRATEGY_DIAGNOSTIC = 5,
   // Packed B16 result rows are exchanged and repacked into RHS registers.
   LOOM_AMDGPU_FRAGMENT_REPACK_STRATEGY_RESULT_TO_RHS_PACKED_B16_XOR_PERMUTE = 6,
+  // f32 result rows (2i + half) to packed-B16 RHS k pairs: one half-swap
