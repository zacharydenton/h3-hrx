+        semantic_tag="lane.permlanex16.b32",
+        schedule_class=_SCHEDULE_VALU,
+        operands=(
+            AmdgpuOperandOverlay("VDST", _vgpr_result()),
+            AmdgpuOperandOverlay("SRC0", _vgpr_operand("src")),
+            AmdgpuOperandOverlay("SRC1", _sgpr_operand("selector_low")),
+            AmdgpuOperandOverlay("SRC2", _sgpr_operand("selector_high")),
+        ),
+        effects=(_CONVERGENT_EFFECT,),
+        flags=(DescriptorFlag.DEAD_REMOVABLE,),
