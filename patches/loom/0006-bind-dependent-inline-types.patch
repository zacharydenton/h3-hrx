+iree_status_t loom_callable_type_matches(loom_ir_remap_t* remap,
+                                         const loom_value_fact_table_t* facts,
+                                         loom_type_t callee_type,
+                                         loom_type_t call_type,
+                                         bool* out_matches) {
+  if (loom_type_equal(callee_type, call_type)) {
+    *out_matches = true;
+    return iree_ok_status();
+  }
+  loom_type_t bound_type;
+  IREE_RETURN_IF_ERROR(loom_ir_remap_type(remap, callee_type, &bound_type));
+  if (facts) {
+    loom_type_refinement_result_t refinement;
+    IREE_RETURN_IF_ERROR(loom_type_refine_with_value_facts(
+        bound_type, facts, remap->arena, &bound_type, &refinement));
+    if (refinement == LOOM_TYPE_REFINEMENT_CONFLICT) {
+      *out_matches = false;
+      return iree_ok_status();
+    }
+    IREE_RETURN_IF_ERROR(loom_type_refine_with_value_facts(
+        call_type, facts, remap->arena, &call_type, &refinement));
+    if (refinement == LOOM_TYPE_REFINEMENT_CONFLICT) {
+      *out_matches = false;
+      return iree_ok_status();
+    }
+  }
+  *out_matches = loom_type_equal(bound_type, call_type);
+  return iree_ok_status();
+}
