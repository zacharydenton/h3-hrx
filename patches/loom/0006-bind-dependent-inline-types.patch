+// ====
+
+// Each call binds the same dependent signature to a different static width.
+// RUN: pass canonicalize,inline-callables,canonicalize
+func.def inline @identity(%width: index, %value: vector<[%width]xi32>) -> (vector<[%width]xi32>) {
+  func.return %value : vector<[%width]xi32>
+}
+
+func.def public @two_specializations() {
+  %two = index.constant 2 : index
+  %four = index.constant 4 : index
+  %a = vector.constant 7 : vector<[%two]xi32>
+  %b = vector.constant 9 : vector<[%four]xi32>
+  %x = func.call @identity(%two, %a) : (index, vector<[%two]xi32>) -> (vector<[%two]xi32>)
+  %y = func.call @identity(%four, %b) : (index, vector<[%four]xi32>) -> (vector<[%four]xi32>)
+  test.use %x : vector<[%two]xi32>
+  test.use %y : vector<[%four]xi32>
+  func.return
+}
+
+// ----
+func.def public @two_specializations() {
+  %a = vector.constant 7 : vector<2xi32>
+  %b = vector.constant 9 : vector<4xi32>
+  test.use %a : vector<2xi32>
+  test.use %b : vector<4xi32>
+  func.return
+}
+
+// ====
+
+// Runtime dimensions still bind by SSA identity; they need not become static.
+// RUN: pass inline-callables
+func.def inline @identity(%width: index, %value: vector<[%width]xi32>) -> (vector<[%width]xi32>) {
+  func.return %value : vector<[%width]xi32>
+}
+
+func.def public @runtime_width(%n: index, %input: vector<[%n]xi32>) -> (vector<[%n]xi32>) {
+  %result = func.call @identity(%n, %input) : (index, vector<[%n]xi32>) -> (vector<[%n]xi32>)
+  func.return %result : vector<[%n]xi32>
+}
+
+// ----
+func.def public @runtime_width(%n: index, %input: vector<[%n]xi32>) -> (vector<[%n]xi32>) {
+  func.return %input : vector<[%n]xi32>
+}
+
+// ====
+
+
+// Each call binds the same dependent signature to a different static width.
+// RUN: pass canonicalize,inline-callables,canonicalize
+func.def inline @double_vector(%width: index, %value: vector<[%width]xi32>) -> (vector<[%width]xi32>) {
+  %sum = vector.addi %value, %value : vector<[%width]xi32>
+  func.return %sum : vector<[%width]xi32>
+}
+
+func.def public @two_computed_specializations() {
+  %two = index.constant 2 : index
+  %four = index.constant 4 : index
+  %a = vector.constant 7 : vector<[%two]xi32>
+  %b = vector.constant 9 : vector<[%four]xi32>
+  %x = func.call @double_vector(%two, %a) : (index, vector<[%two]xi32>) -> (vector<[%two]xi32>)
+  %y = func.call @double_vector(%four, %b) : (index, vector<[%four]xi32>) -> (vector<[%four]xi32>)
+  test.use %x : vector<[%two]xi32>
+  test.use %y : vector<[%four]xi32>
+  func.return
+}
