@@ -741,6 +746,32 @@ def _component_source_operand_index(
     raise ValueError(f"AMDGPU VOPD component '{component.descriptor_key}' has unsupported source form '{component.form}'")
 
 
+def _component_source_caches(component: _VopdComponentDefinition) -> tuple[str, str, str]:
+    # Encoded VSRC1 is SRC2 for FMAMK, while an accumulating instruction reads
+    # its tied destination through SRC2. Literals do not consume a VGPR cache.
+    return {
+        _FORM_TIED_ACCUMULATE: (_CACHE_SRC0, _CACHE_VSRC1, _CACHE_DESTINATION),
+        _FORM_FMAAK_LITERAL: (_CACHE_SRC0, _CACHE_VSRC1, _CACHE_NONE),
+        _FORM_FMAMK_LITERAL: (_CACHE_SRC0, _CACHE_NONE, _CACHE_VSRC1),
+        _FORM_BINARY_VGPR: (_CACHE_SRC0, _CACHE_VSRC1, _CACHE_NONE),
+        _FORM_CNDMASK_VCC: (_CACHE_SRC0, _CACHE_VSRC1, _CACHE_NONE),
+        _FORM_REGISTER_MOV: (_CACHE_SRC0, _CACHE_NONE, _CACHE_NONE),
+        _FORM_INLINE_MOV: (_CACHE_NONE, _CACHE_NONE, _CACHE_NONE),
+    }[component.form]
+
+
+def _placement_cache_ref(
+    pair_component: str,
+    component: _VopdComponentDefinition,
+    cache_register: str,
+    flags: frozenset[str],
+) -> _VopdPairPlacementValueRef:
+    if cache_register == _CACHE_DESTINATION:
+        return _placement_result_ref(pair_component)
+    source_mask = {_CACHE_SRC0: _SOURCE_SRC0, _CACHE_VSRC1: _SOURCE_VSRC1}[cache_register]
+    return _placement_source_ref(pair_component, component, _source_mask_for_component_orientation(source_mask, flags))
+
+
 def _component_operand_count(component: _VopdComponentDefinition) -> int:
     if component.form == _FORM_TIED_ACCUMULATE:
         return max(component.operand_layout) + 1
@@ -840,6 +871,21 @@ def _pair_placement_relations(
             location_mask=0x1,
         )
     ]
+    for cache, (first_cache, second_cache, bank_mask) in enumerate(zip(_component_source_caches(first_component), _component_source_caches(second_component), (0x3, 0x3, 0x1), strict=True)):
+        if _CACHE_NONE in (first_cache, second_cache):
+            continue
+        if first_cache == second_cache == _CACHE_DESTINATION:
+            continue  # Already covered by destination parity.
+        if cache == 0 and not _components_share_source_cache(first_component, second_component, _SOURCE_SRC0, first_component_flags, second_component_flags):
+            continue
+        relations.append(
+            _VopdPairPlacementRelation(
+                result=_placement_cache_ref(_PLACEMENT_COMPONENT_FIRST, first_component, first_cache, first_component_flags),
+                source=_placement_cache_ref(_PLACEMENT_COMPONENT_SECOND, second_component, second_cache, second_component_flags),
+                kind=_PLACEMENT_DIFFERENT_MASKED,
+                location_mask=bank_mask,
+            )
+        )
     for source_mask in (_SOURCE_SRC0, _SOURCE_VSRC1):
         first_source_mask = _source_mask_for_component_orientation(
             source_mask,
@@ -854,33 +900,6 @@ def _pair_placement_relations(
             second_component,
             second_source_mask,
         )
-        if (
-            first_has_source
-            and second_has_source
-            and _components_share_source_cache(
-                first_component,
-                second_component,
-                source_mask,
-                first_component_flags,
-                second_component_flags,
-            )
-        ):
-            relations.append(
-                _VopdPairPlacementRelation(
-                    result=_placement_source_ref(
-                        _PLACEMENT_COMPONENT_FIRST,
-                        first_component,
-                        first_source_mask,
-                    ),
-                    source=_placement_source_ref(
-                        _PLACEMENT_COMPONENT_SECOND,
-                        second_component,
-                        second_source_mask,
-                    ),
-                    kind=_PLACEMENT_DIFFERENT_MASKED,
-                    location_mask=0x3,
-                )
-            )
         if second_has_source:
             relations.append(
                 _VopdPairPlacementRelation(
@@ -1294,6 +1313,7 @@ def _component_rule_initializer(
             f"                .vsrc1_index = {vsrc1_index},",
             "            },",
             f"        .source_register_mask = {component.source_register_mask},",
