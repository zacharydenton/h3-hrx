@@ -12,6 +12,27 @@ from loom.gen.target.arch.amdgpu.descriptors import amdgpu_vopd_component_tables
 from loom.target.arch.amdgpu.target_info import sorted_descriptor_set_infos
 
 
+@pytest.mark.parametrize(
+    ("first", "second", "expected_sources"),
+    [
+        ("fmamk_f32", "fmamk_f32", {("operand", 0, "operand", 0, 3), ("operand", 1, "operand", 1, 1)}),
+        ("fmamk_f32", "fmac_f32", {("operand", 0, "operand", 1, 3), ("operand", 1, "result", 0, 1)}),
+        ("fmac_f32", "fmamk_f32", {("operand", 1, "operand", 0, 3), ("result", 0, "operand", 1, 1)}),
+        ("fmamk_f32", "fmaak_f32", {("operand", 0, "operand", 0, 3)}),
+        ("fmamk_f32", "mul_f32", {("operand", 0, "operand", 0, 3)}),
+        ("fmaak_f32", "fmaak_f32", {("operand", 0, "operand", 0, 3), ("operand", 1, "operand", 1, 3)}),
+        ("fmac_f32", "fmac_f32", {("operand", 1, "operand", 1, 3), ("operand", 2, "operand", 2, 3)}),
+    ],
+)
+def test_pair_placement_compares_actual_operand_caches(first, second, expected_sources) -> None:
+    tables = amdgpu_vopd_component_tables
+    components = {c.descriptor_key: c for c in tables._component_definitions()}
+    relations = tables._pair_placement_relations(components[f"amdgpu.v_{first}"], components[f"amdgpu.v_{second}"], frozenset(), frozenset())
+    kinds = {tables._PLACEMENT_VALUE_OPERAND: "operand", tables._PLACEMENT_VALUE_RESULT: "result"}
+    bank_relations = {(kinds[r.result.kind], r.result.index, kinds[r.source.kind], r.source.index, r.location_mask) for r in relations if r.kind == tables._PLACEMENT_DIFFERENT_MASKED}
+    assert bank_relations == expected_sources | {("result", 0, "result", 0, 1)}
+
+
 def test_vopd_descriptor_set_groups_follow_target_info() -> None:
     descriptor_set_infos = sorted_descriptor_set_infos()
 
