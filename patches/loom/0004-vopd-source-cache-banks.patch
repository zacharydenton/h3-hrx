-                                        3)) {
-    flags |= LOOM_AMDGPU_VOPD_REGISTER_CONSTRAINT_FLAG_SRC0_BANK;
-  }
-  if (iree_any_bit_set(paired_source_registers,
-                       LOOM_AMDGPU_VOPD_COMPONENT_SOURCE_VSRC1) &&
-      !loom_amdgpu_vopd_bank_compatible(candidate->x.vsrc1, candidate->y.vsrc1,
-                                        3)) {
-    flags |= LOOM_AMDGPU_VOPD_REGISTER_CONSTRAINT_FLAG_VSRC1_BANK;
+  static const uint16_t bank_masks[] = {3, 3, 1};
+  static const loom_amdgpu_vopd_register_constraint_flags_t bank_flags[] = {
+      LOOM_AMDGPU_VOPD_REGISTER_CONSTRAINT_FLAG_SRC0_BANK,
+      LOOM_AMDGPU_VOPD_REGISTER_CONSTRAINT_FLAG_VSRC1_BANK,
+      LOOM_AMDGPU_VOPD_REGISTER_CONSTRAINT_FLAG_SRC2_BANK,
+  };
+  for (iree_host_size_t cache = 0; cache < IREE_ARRAYSIZE(bank_masks);
+       ++cache) {
+    const uint8_t x = candidate->x.rule->source_cache_registers[cache];
+    const uint8_t y = candidate->y.rule->source_cache_registers[cache];
+    if (x == LOOM_AMDGPU_VOPD_CACHE_REGISTER_NONE ||
+        y == LOOM_AMDGPU_VOPD_CACHE_REGISTER_NONE) {
+      continue;
+    }
+    // On profiles with separate dual-MOV caches, the Y move uses SRC2.
+    // Neither move reads another cache, so only the SRC0 intersection changes.
+    if (cache == 0 && !loom_amdgpu_vopd_components_share_source_cache(
+                          &candidate->x, &candidate->y,
+                          LOOM_AMDGPU_VOPD_COMPONENT_SOURCE_SRC0)) {
+      continue;
+    }
+    // Tied accumulators both read their destinations through SRC2; destination
+    // parity already checks this case and owns its diagnostic.
+    if (x == LOOM_AMDGPU_VOPD_CACHE_REGISTER_DESTINATION &&
+        y == LOOM_AMDGPU_VOPD_CACHE_REGISTER_DESTINATION) {
+      continue;
+    }
+    if (!loom_amdgpu_vopd_bank_compatible(
+            loom_amdgpu_vopd_cache_register(&candidate->x, x),
+            loom_amdgpu_vopd_cache_register(&candidate->y, y),
+            bank_masks[cache])) {
+      flags |= bank_flags[cache];
+    }
   }
   if (iree_any_bit_set(candidate->y.rule->source_register_mask,
                        LOOM_AMDGPU_VOPD_COMPONENT_SOURCE_SRC0) &&
