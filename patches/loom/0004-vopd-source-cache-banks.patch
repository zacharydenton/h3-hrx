+static uint16_t loom_amdgpu_vopd_cache_register(
+    const loom_amdgpu_vopd_candidate_component_t* component, uint8_t selector) {
+  switch (selector) {
+    case LOOM_AMDGPU_VOPD_CACHE_REGISTER_SRC0:
+      return component->src0;
+    case LOOM_AMDGPU_VOPD_CACHE_REGISTER_VSRC1:
+      return component->vsrc1;
+    case LOOM_AMDGPU_VOPD_CACHE_REGISTER_DESTINATION:
+      return component->vdst;
+    default:
+      IREE_ASSERT_UNREACHABLE("cache must select a register");
+      return 0;
+  }
+}
