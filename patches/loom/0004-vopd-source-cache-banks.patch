+// ====
+
+// Same-parity FMAMK addends conflict in SRC2 even when they differ modulo four.
+// RUN: emit amdgpu-assembly @fmamk_same_src2_bank strategy=source fixed=%lhs0:physical_register:1:1 fixed=%addend0:physical_register:0:1 fixed=%lhs1:physical_register:3:1 fixed=%addend1:physical_register:2:1 fixed=%next0:physical_register:4:1 fixed=%next1:physical_register:5:1
+amdgpu.target<gfx1151> @target {subgroup_size = 32}
+low.func.def target<amdgpu.rdna3_5.core>(@target) @fmamk_same_src2_bank(%resource: reg<amdgpu.sgpr x4>, %vaddr: reg<amdgpu.vgpr>, %soffset: reg<amdgpu.sgpr>, %lhs0: reg<amdgpu.vgpr>, %addend0: reg<amdgpu.vgpr>, %lhs1: reg<amdgpu.vgpr>, %addend1: reg<amdgpu.vgpr>) asm {
+  %next0 = v_fmamk_f32 %lhs0, %addend0, 1027024659
+  %next1 = v_fmamk_f32 %lhs1, %addend1, 1027024659
+  buffer_store_dword %next0, %resource, %vaddr, %soffset
+  buffer_store_dword %next1, %resource, %vaddr, %soffset {offset = 4}
+  return
+}
+
+// ----
+  v_fmamk_f32 v4, v1, 0x3d372713, v0
