// The FMAMK addends use SRC2: v0 and v2 conflict despite differing modulo four.
// This is an expected-failing compiler reproducer, outside the model test suite.
// RUN: emit amdgpu-asm @fmamk_bank_conflict strategy=source fixed=%lhs0:physical_register:1:1 fixed=%addend0:physical_register:0:1 fixed=%lhs1:physical_register:3:1 fixed=%addend1:physical_register:2:1 fixed=%next0:physical_register:4:1 fixed=%next1:physical_register:5:1
amdgpu.target<gfx1151> @target {subgroup_size = 32}
low.func.def target<amdgpu.rdna3_5.core>(@target) @fmamk_bank_conflict(%resource: reg<amdgpu.sgpr x4>, %vaddr: reg<amdgpu.vgpr>, %soffset: reg<amdgpu.sgpr>, %lhs0: reg<amdgpu.vgpr>, %addend0: reg<amdgpu.vgpr>, %lhs1: reg<amdgpu.vgpr>, %addend1: reg<amdgpu.vgpr>) asm {
  %next0 = v_fmamk_f32 %lhs0, %addend0, 1027024659
  %next1 = v_fmamk_f32 %lhs1, %addend1, 1027024659
  buffer_store_dword %next0, %resource, %vaddr, %soffset
  buffer_store_dword %next1, %resource, %vaddr, %soffset {offset = 4}
  return
}

// ----
v_fmamk_f32 v4, v1, 0x3d372713, v0
  v_fmamk_f32 v5, v3, 0x3d372713, v2
  buffer_store_dword v4, v6, s[0:3], s4 offen offset:0
  buffer_store_dword v5, v6, s[0:3], s4 offen offset:4
  s_waitcnt_vscnt vscnt(0)
  s_endpgm

// ====

// Opposite-parity addends remain a legal dual FMA.
// RUN: emit amdgpu-asm @fmamk_bank_control strategy=source fixed=%lhs0:physical_register:1:1 fixed=%addend0:physical_register:0:1 fixed=%lhs1:physical_register:2:1 fixed=%addend1:physical_register:3:1 fixed=%next0:physical_register:4:1 fixed=%next1:physical_register:5:1
amdgpu.target<gfx1151> @target {subgroup_size = 32}
low.func.def target<amdgpu.rdna3_5.core>(@target) @fmamk_bank_control(%resource: reg<amdgpu.sgpr x4>, %vaddr: reg<amdgpu.vgpr>, %soffset: reg<amdgpu.sgpr>, %lhs0: reg<amdgpu.vgpr>, %addend0: reg<amdgpu.vgpr>, %lhs1: reg<amdgpu.vgpr>, %addend1: reg<amdgpu.vgpr>) asm {
  %next0 = v_fmamk_f32 %lhs0, %addend0, 1027024659
  %next1 = v_fmamk_f32 %lhs1, %addend1, 1027024659
  buffer_store_dword %next0, %resource, %vaddr, %soffset
  buffer_store_dword %next1, %resource, %vaddr, %soffset {offset = 4}
  return
}

// ----
v_dual_fmamk_f32 v4, v1, 0x3d372713, v0 :: v_dual_fmamk_f32 v5, v2, 0x3d372713, v3
  buffer_store_dword v4, v6, s[0:3], s4 offen offset:0
  buffer_store_dword v5, v6, s[0:3], s4 offen offset:4
  s_waitcnt_vscnt vscnt(0)
  s_endpgm
