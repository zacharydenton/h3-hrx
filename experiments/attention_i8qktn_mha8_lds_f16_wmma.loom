// MHA attention with int4 QK^T (SageAttention-style operands) and K/V tiles staged in LDS: one workgroup of four waves
// per (16 query rows, key-value head); wave w owns query head kv_head*4 + w. Each
// 16-key tile of K and V is loaded once, coalesced (a lane reads 32 contiguous bytes),
// into LDS and serves all four heads; K's rhs fragments are assembled from the LDS rows
// (lane = key, 16 contiguous channels), V's as dense rhs loads from the tile rows (the tile's [key][channel] layout is the rhs' logical [k][n]). Online
// softmax with running max and sum per lane group, eight accumulators for the 128
// output channels, f16 out. q [tokens][q_stride], k and v [tokens][kv_stride] (natural
// layout, no transpose needed), token_capacity >= tokens + 16 with zero headroom.
//
amdgpu.target<gfx11-generic> @h3_attention_i8qktn_mha8_lds_f16_wmma_gfx11 {subgroup_size = 32}

config.decl @h3.attention_i8qktn_mha8_lds_f16_wmma.q_stride : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

config.decl @h3.attention_i8qktn_mha8_lds_f16_wmma.kv_stride : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

config.decl @h3.attention_i8qktn_mha8_lds_f16_wmma.out_stride : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

config.decl @h3.attention_i8qktn_mha8_lds_f16_wmma.tokens : %value: index where [range(%value, 1, 65536)]

config.decl @h3.attention_i8qktn_mha8_lds_f16_wmma.token_capacity : %value: index where [range(%value, 32, 1048576), mul(%value, 16)]

config.decl @h3.attention_i8qktn_mha8_lds_f16_wmma.scale : f32

kernel.def target(@h3_attention_i8qktn_mha8_lds_f16_wmma_gfx11) export("h3_attention_i8qktn_mha8_lds_f16_wmma") @h3_attention_i8qktn_mha8_lds_f16_wmma(%token_count: index, %kv_head_count: index) {
  %c1 = index.constant 1 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %c127 = index.constant 127 : index
  %c128 = index.constant 128 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %tokens0 = config.get @h3.attention_i8qktn_mha8_lds_f16_wmma.tokens : index
  %rounded = index.add %tokens0, %c127 : index
  %tiles = index.div %rounded, %c128 : index
  kernel.launch.config workgroups(%tiles, %kv_head_count, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%token_count: index, %qi: buffer, %qs: buffer, %ki: buffer, %ks: buffer, %v: buffer, %out: buffer) {
  %q_stride0 = config.get @h3.attention_i8qktn_mha8_lds_f16_wmma.q_stride : index
  %kv_stride0 = config.get @h3.attention_i8qktn_mha8_lds_f16_wmma.kv_stride : index
  %out_stride0 = config.get @h3.attention_i8qktn_mha8_lds_f16_wmma.out_stride : index
  %tokens0 = config.get @h3.attention_i8qktn_mha8_lds_f16_wmma.tokens : index
  %padded_tokens = config.get @h3.attention_i8qktn_mha8_lds_f16_wmma.token_capacity : index
  %scale = config.get @h3.attention_i8qktn_mha8_lds_f16_wmma.scale : f32
  %c0 = index.constant 0 : index
  %c20 = index.constant 20 : index
  %c24 = index.constant 24 : index
  %c28 = index.constant 28 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c80 = index.constant 80 : index
  %c96 = index.constant 96 : index
  %c112 = index.constant 112 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c136 = index.constant 136 : index
  %cd = index.constant 128 : index
  %c10 = index.constant 10 : index
  %c12 = index.constant 12 : index
  %c14 = index.constant 14 : index
  %c_klanes = index.constant 128 : index
  %c_kvlanes = index.constant 256 : index
  %c_nf = index.constant 8 : index
  %c0_offset = index.constant 0 : offset
  %k_tile_offset = index.constant 0 : offset
  %v_tile_offset = index.constant 4608 : offset
  %scratch_offset = index.constant 16896 : offset
  %kbuf_bytes = index.constant 2304 : offset
  %vbuf_bytes = index.constant 6144 : offset
  // the result stage aliases the K/V tiles: it is used only after the loop's final barrier
  %result_offset = index.constant 0 : offset
  %q_tile_offset = index.constant 20992 : offset
  %lds_bytes = index.constant 20992 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k_frag = index.constant 16 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %negative_large = scalar.constant -1000000000.0 : f32
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %cj0 = index.constant 0 : index
  %cj1 = index.constant 1 : index
  %cj2 = index.constant 2 : index
  %cj3 = index.constant 3 : index
  %cj4 = index.constant 4 : index
  %cj5 = index.constant 5 : index
  %cj6 = index.constant 6 : index
  %cj7 = index.constant 7 : index
  %cj8 = index.constant 8 : index
  %cj9 = index.constant 9 : index
  %cj10 = index.constant 10 : index
  %cj11 = index.constant 11 : index
  %cj12 = index.constant 12 : index
  %cj13 = index.constant 13 : index
  %cj14 = index.constant 14 : index
  %cj15 = index.constant 15 : index
  %i32_1 = scalar.constant 1 : i32
  %i32_2 = scalar.constant 2 : i32
  %i32_4 = scalar.constant 4 : i32
  %i32_8 = scalar.constant 8 : i32
  %i32_32 = scalar.constant 32 : i32
  %i32_16 = scalar.constant 16 : i32
  %zero_vector = vector.splat %zero_f32 : vector<8xf32>
  %negative_vector = vector.splat %negative_large : vector<8xf32>
  %scale_vector = vector.splat %scale : vector<8xf32>

  %tile_id = kernel.workgroup.id<x> : index
  %kv_head_raw = kernel.workgroup.id<y> : index
  %kv_head_limit = index.div %kv_stride0, %cd : index
  %kv_head = index.rem %kv_head_raw, %kv_head_limit : index
  %workitem = kernel.workitem.id<x> : index
  %wave0 = kernel.subgroup.id : index
  %wave = index.assume %wave0 [range(%wave0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index
  %lane_column = index.rem %lane, %c16 : index
  %lane_group = index.div %lane, %c16 : index
  %lane_group_even = index.cmp eq, %lane_group, %c0 : index
  // this wave's query head, and its channels in q and out
  %head_limit = index.div %out_stride0, %cd : index
  %rounded = index.add %tokens0, %c15 : index
  %tiles_per_image = index.div %rounded, %c16 : index
  // MHA: this wave is query tile 8 * workgroup + wave of head kv_head (tiles past the sequence write nothing)
  %head = index.rem %kv_head, %head_limit : index
  %tile4 = index.mul %tile_id, %c8 : index
  %tile_in_image0 = index.add %tile4, %wave : index
  %tile_limit = index.sub %tiles_per_image, %c1 : index
  %tile_in_image = index.min %tile_in_image0, %tile_limit : index
  %head_base0 = index.mul %head, %cd : index
  %kv_base0 = index.mul %kv_head, %cd : index
  %query_origin0 = index.mul %tile_in_image, %c16 : index
  %tile_origin_limit = index.sub %padded_tokens, %c16 : index

  %qi_global = buffer.assume.memory_space<global> %qi : buffer
  %qs_global = buffer.assume.memory_space<global> %qs : buffer
  %ki_global = buffer.assume.memory_space<global> %ki : buffer
  %ks_global = buffer.assume.memory_space<global> %ks : buffer
  %v_global = buffer.assume.memory_space<global> %v : buffer
  %out_global = buffer.assume.memory_space<global> %out : buffer
  // int4 operands: [tokens][heads * 16] i32 words (8 codes each), scales [tokens][heads] f32
  %qi_words = index.div %q_stride0, %c4 : index
  %ki_words = index.div %kv_stride0, %c4 : index
  %qi_view = buffer.view %qi_global[%c0_offset] : buffer -> view<[%padded_tokens]x[%qi_words]xi32>
  %ki_view = buffer.view %ki_global[%c0_offset] : buffer -> view<[%padded_tokens]x[%ki_words]xi32>
  %qs_view = buffer.view %qs_global[%c0_offset] : buffer -> view<[%padded_tokens]x[%head_limit]xf32>
  %ks_view = buffer.view %ks_global[%c0_offset] : buffer -> view<[%padded_tokens]x[%kv_head_limit]xf32>
  %i8_schema = encoding.define #encoding.operand<element_format=i8, payload_elements=16, payload_registers=4> : encoding<schema>
  %zero_i32x8 = vector.constant 0 : vector<8xi32>
  %init_i = vector.fragment<init> %zero_i32x8 shape [%m, %n] : vector<8xi32>
  %v_view = buffer.view %v_global[%c0_offset] : buffer -> view<[%kv_stride0]x[%padded_tokens]xf16>
  %out_view = buffer.view %out_global[%c0_offset] : buffer -> view<[%token_count]x[%out_stride0]xf16>

  %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  // K and V tiles: 16 keys x 128 channels, rows padded to 136 halves
  %k_tile = buffer.view %lds[%k_tile_offset] : buffer -> view<16x36xi32>
  %v_tile = buffer.view %lds[%v_tile_offset] : buffer -> view<128x24xf16>
  %wave_scratch_bytes = index.constant 512 : offset
  %wave_scratch_offset0 = index.scale %wave, %wave_scratch_bytes : index, offset -> offset
  %wave_scratch_offset = index.add %scratch_offset, %wave_scratch_offset0 : offset
  %scratch_view = buffer.view %lds[%wave_scratch_offset] : buffer -> view<16x16xf16>
  %wave_result_bytes = index.constant 1024 : offset
  %wave_result_offset0 = index.scale %wave, %wave_result_bytes : index, offset -> offset
  %wave_result_offset = index.add %result_offset, %wave_result_offset0 : offset
  %result_view = buffer.view %lds[%wave_result_offset] : buffer -> view<16x16xf32>

  // cooperative staging map: lane -> key workitem/8, 16-channel chunk (workitem%8)*16
  %st_lane = index.rem %workitem, %c_klanes : index
  %st_key = index.div %st_lane, %c_nf : index
  %st_chunk0 = index.rem %st_lane, %c_nf : index
  %st_chunk = index.mul %st_chunk0, %c4 : index
  %kv_word0 = index.mul %kv_head, %c32 : index
  %st_col0 = index.add %kv_word0, %st_chunk : index
  %kv_col_limit = index.sub %kv_stride0, %c16 : index
  %ki_col_limit = index.sub %ki_words, %c4 : index
  %st_col = index.assume %st_col0 [le(%st_col0, %ki_col_limit), mul(%st_col0, 4)] : index
  // V staging: lane -> (key = workitem mod 16, channel chunk = workitem / 16), transposed into LDS
  %st_key_v = index.rem %st_lane, %c16 : index
  %st_chan_v = index.add %kv_base0, %st_lane : index
  %st_chan_limit = index.sub %kv_stride0, %c1 : index
  %st_chan = index.assume %st_chan_v [le(%st_chan_v, %st_chan_limit)] : index
  %st_chunk_v0 = index.div %st_lane, %c16 : index
  %st_is_k = index.cmp ult, %workitem, %c_klanes : index
  %st_is_v = index.cmp ult, %workitem, %c_kvlanes : index
  %st_chunk_v = index.mul %st_chunk_v0, %c16 : index
  %st_col_v0 = index.add %kv_base0, %st_chunk_v : index
  %st_col_v = index.assume %st_col_v0 [le(%st_col_v0, %kv_col_limit), mul(%st_col_v0, 16)] : index
  %init = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %key_tile_count = index.add %tiles_per_image, %c0 : index

  %q_row0 = index.add %query_origin0, %lane_column : index
  %q_row = index.assume %q_row0 [lt(%q_row0, %padded_tokens)] : index
  %q_wbase = index.mul %head, %c32 : index
  %q_word_limit = index.sub %qi_words, %c4 : index
  %q_word0a = index.add %q_wbase, %c0 : index
  %q_word0 = index.assume %q_word0a [le(%q_word0a, %q_word_limit), mul(%q_word0a, 4)] : index
  %qd0 = vector.load %qi_view[%q_row, %q_word0] : view<[%padded_tokens]x[%qi_words]xi32> -> vector<4xi32>
  %qrhs0 = vector.fragment<rhs> %qd0 shape [%k_frag, %n] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
  %q_word1a = index.add %q_wbase, %c4 : index
  %q_word1 = index.assume %q_word1a [le(%q_word1a, %q_word_limit), mul(%q_word1a, 4)] : index
  %qd1 = vector.load %qi_view[%q_row, %q_word1] : view<[%padded_tokens]x[%qi_words]xi32> -> vector<4xi32>
  %qrhs1 = vector.fragment<rhs> %qd1 shape [%k_frag, %n] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
  %q_word2a = index.add %q_wbase, %c8 : index
  %q_word2 = index.assume %q_word2a [le(%q_word2a, %q_word_limit), mul(%q_word2a, 4)] : index
  %qd2 = vector.load %qi_view[%q_row, %q_word2] : view<[%padded_tokens]x[%qi_words]xi32> -> vector<4xi32>
  %qrhs2 = vector.fragment<rhs> %qd2 shape [%k_frag, %n] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
  %q_word3a = index.add %q_wbase, %c12 : index
  %q_word3 = index.assume %q_word3a [le(%q_word3a, %q_word_limit), mul(%q_word3a, 4)] : index
  %qd3 = vector.load %qi_view[%q_row, %q_word3] : view<[%padded_tokens]x[%qi_words]xi32> -> vector<4xi32>
  %qrhs3 = vector.fragment<rhs> %qd3 shape [%k_frag, %n] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
  %q_word4a = index.add %q_wbase, %c16 : index
  %q_word4 = index.assume %q_word4a [le(%q_word4a, %q_word_limit), mul(%q_word4a, 4)] : index
  %qd4 = vector.load %qi_view[%q_row, %q_word4] : view<[%padded_tokens]x[%qi_words]xi32> -> vector<4xi32>
  %qrhs4 = vector.fragment<rhs> %qd4 shape [%k_frag, %n] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
  %q_word5a = index.add %q_wbase, %c20 : index
  %q_word5 = index.assume %q_word5a [le(%q_word5a, %q_word_limit), mul(%q_word5a, 4)] : index
  %qd5 = vector.load %qi_view[%q_row, %q_word5] : view<[%padded_tokens]x[%qi_words]xi32> -> vector<4xi32>
  %qrhs5 = vector.fragment<rhs> %qd5 shape [%k_frag, %n] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
  %q_word6a = index.add %q_wbase, %c24 : index
  %q_word6 = index.assume %q_word6a [le(%q_word6a, %q_word_limit), mul(%q_word6a, 4)] : index
  %qd6 = vector.load %qi_view[%q_row, %q_word6] : view<[%padded_tokens]x[%qi_words]xi32> -> vector<4xi32>
  %qrhs6 = vector.fragment<rhs> %qd6 shape [%k_frag, %n] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
  %q_word7a = index.add %q_wbase, %c28 : index
  %q_word7 = index.assume %q_word7a [le(%q_word7a, %q_word_limit), mul(%q_word7a, 4)] : index
  %qd7 = vector.load %qi_view[%q_row, %q_word7] : view<[%padded_tokens]x[%qi_words]xi32> -> vector<4xi32>
  %qrhs7 = vector.fragment<rhs> %qd7 shape [%k_frag, %n] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
  // this lane's query: origin + lane_column; its scale splat over the eight keys the lane holds
  %qs_rowa = index.add %query_origin0, %lane_column : index
  %qs_row = index.assume %qs_rowa [lt(%qs_rowa, %padded_tokens)] : index
  %qs_lane = view.load %qs_view[%qs_row, %head] : view<[%padded_tokens]x[%head_limit]xf32> -> f32
  %qs_vec = vector.splat %qs_lane : vector<8xf32>
  // key scales, transposed and parity-split: block of 16 keys = [even keys 0..7 | odd keys 8..15]
  %kst_view = buffer.view %ks_global[%c0_offset] : buffer -> view<[%kv_head_limit]x[%padded_tokens]xf32>
  %ks_par = index.mul %lane_group, %c8 : index
  %ks_off_limit = index.sub %padded_tokens, %c8 : index
  %zero_k4 = vector.constant 0 : vector<4xi32>
  %tiles_last = index.sub %key_tile_count, %c1 : index
  %p_first_k = scf.if %st_is_k -> (vector<4xi32>) {
    %st_row_f = index.assume %st_key [lt(%st_key, %padded_tokens)] : index
    %r = vector.load %ki_view[%st_row_f, %st_col] : view<[%padded_tokens]x[%ki_words]xi32> -> vector<4xi32>
    scf.yield %r : vector<4xi32>
  } else {
    scf.yield %zero_k4 : vector<4xi32>
  }
  %final_max, %final_sum, %final0, %final1, %final2, %final3, %final4, %final5, %final6, %final7, %k_end = scf.for %key_tile = [%c0 to %key_tile_count step %c1](%row_max = %negative_large : f32, %row_sum = %zero_f32 : f32, %acc0 = %init : vector<8xf32>, %acc1 = %init : vector<8xf32>, %acc2 = %init : vector<8xf32>, %acc3 = %init : vector<8xf32>, %acc4 = %init : vector<8xf32>, %acc5 = %init : vector<8xf32>, %acc6 = %init : vector<8xf32>, %acc7 = %init : vector<8xf32>, %k_pre = %p_first_k : vector<4xi32>) -> (f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<4xi32>) {
    %key_origin1 = index.mul %key_tile, %c16 : index
    %key_origin0 = index.assume %key_origin1 [le(%key_origin1, %tile_origin_limit), mul(%key_origin1, 16)] : index
    %buf = index.rem %key_tile, %c2 : index
    %kb_off = index.scale %buf, %kbuf_bytes : index, offset -> offset
    %k_tile_b = buffer.view %lds[%kb_off] : buffer -> view<16x36xi32>
    %vb_off0 = index.scale %buf, %vbuf_bytes : index, offset -> offset
    %vb_off = index.add %v_tile_offset, %vb_off0 : offset
    %v_tile_b = buffer.view %lds[%vb_off] : buffer -> view<128x24xf16>
    // stage K and V tiles (rows past the sequence are zero headroom)
    scf.if %st_is_k {
      vector.store %k_pre, %k_tile_b[%st_key, %st_chunk] : vector<4xi32>, view<16x36xi32>
    } else {
      %v_chunk = vector.load %v_view[%st_chan, %key_origin0] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
      vector.store %v_chunk, %v_tile_b[%st_lane, %c0] : vector<16xf16>, view<128x24xf16>
    }
    // the next tile's packets, issued now and consumed after this tile's compute
    %nt0 = index.add %key_tile, %c1 : index
    %nt = index.min %nt0, %tiles_last : index
    %ko_n1 = index.mul %nt, %c16 : index
    %ko_n = index.assume %ko_n1 [le(%ko_n1, %tile_origin_limit), mul(%ko_n1, 16)] : index
    %k_next = scf.if %st_is_k -> (vector<4xi32>) {
      %st_row_n0 = index.add %ko_n, %st_key : index
      %st_row_n = index.assume %st_row_n0 [lt(%st_row_n0, %padded_tokens)] : index
      %r = vector.load %ki_view[%st_row_n, %st_col] : view<[%padded_tokens]x[%ki_words]xi32> -> vector<4xi32>
      scf.yield %r : vector<4xi32>
    } else {
      scf.yield %zero_k4 : vector<4xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %local_key = index.add %key_origin0, %lane_column : index
    %key_valid = index.cmp ult, %local_key, %tokens0 : index
    %local_key_safe = index.min %local_key, %tile_origin_limit : index
    %k_data0 = vector.load %k_tile_b[%lane_column, %c0] : view<16x36xi32> -> vector<4xi32>
    %klhs0 = vector.fragment<lhs> %k_data0 shape [%m, %k_frag] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %qk0 = vector.mma %klhs0, %qrhs0, %init_i : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %k_data1 = vector.load %k_tile_b[%lane_column, %c4] : view<16x36xi32> -> vector<4xi32>
    %klhs1 = vector.fragment<lhs> %k_data1 shape [%m, %k_frag] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %qk1 = vector.mma %klhs1, %qrhs1, %qk0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %k_data2 = vector.load %k_tile_b[%lane_column, %c8] : view<16x36xi32> -> vector<4xi32>
    %klhs2 = vector.fragment<lhs> %k_data2 shape [%m, %k_frag] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %qk2 = vector.mma %klhs2, %qrhs2, %qk1 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %k_data3 = vector.load %k_tile_b[%lane_column, %c12] : view<16x36xi32> -> vector<4xi32>
    %klhs3 = vector.fragment<lhs> %k_data3 shape [%m, %k_frag] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %qk3 = vector.mma %klhs3, %qrhs3, %qk2 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %k_data4 = vector.load %k_tile_b[%lane_column, %c16] : view<16x36xi32> -> vector<4xi32>
    %klhs4 = vector.fragment<lhs> %k_data4 shape [%m, %k_frag] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %qk4 = vector.mma %klhs4, %qrhs4, %qk3 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %k_data5 = vector.load %k_tile_b[%lane_column, %c20] : view<16x36xi32> -> vector<4xi32>
    %klhs5 = vector.fragment<lhs> %k_data5 shape [%m, %k_frag] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %qk5 = vector.mma %klhs5, %qrhs5, %qk4 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %k_data6 = vector.load %k_tile_b[%lane_column, %c24] : view<16x36xi32> -> vector<4xi32>
    %klhs6 = vector.fragment<lhs> %k_data6 shape [%m, %k_frag] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %qk6 = vector.mma %klhs6, %qrhs6, %qk5 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %k_data7 = vector.load %k_tile_b[%lane_column, %c28] : view<16x36xi32> -> vector<4xi32>
    %klhs7 = vector.fragment<lhs> %k_data7 shape [%m, %k_frag] using {schema = %i8_schema : encoding<schema>} : vector<4xi32>
    %raw_scores_i = vector.mma %klhs7, %qrhs7, %qk6 : vector<4xi32>, vector<4xi32>, vector<8xi32>
    %raw_scores = vector.sitofp %raw_scores_i : vector<8xi32> to vector<8xf32>
    %ks_offa = index.add %key_origin0, %ks_par : index
    %ks_off = index.assume %ks_offa [le(%ks_offa, %ks_off_limit), mul(%ks_offa, 8)] : index
    %ks_vec = vector.load %kst_view[%kv_head, %ks_off] : view<[%kv_head_limit]x[%padded_tokens]xf32> -> vector<8xf32>
    %qk_scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_scores, %qs_vec : vector<8xf32>
    %scaled0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %qk_scaled, %ks_vec : vector<8xf32>
    %scaled = %scaled0
    // this lane's query: the tile max over its eight keys, joined with the partner lane's (lane ^ 16)
    %m8 = vector.reduce<maxnumf> %scaled, %negative_large : vector<8xf32>, f32
    %m8s, %mok = kernel.subgroup.shuffle<xor> %m8, %i32_16, %i32_32 : f32, i32, i32
    %tile_max = scalar.maxnumf %m8, %m8s : f32
    %next_max = scalar.maxnumf %row_max, %tile_max : f32
    %next_max_v = vector.splat %next_max : vector<8xf32>
    %delta = vector.subf<reassoc|nnan|ninf|nsz> %scaled, %next_max_v : vector<8xf32>
    // an invalid key's score is -large, so its weight is exp(-large) = 0 without a mask
    %weight = vector.expf<afn> %delta : vector<8xf32>
    %old_delta = scalar.subf %row_max, %next_max : f32
    %old_scale = scalar.expf<afn> %old_delta : f32
    %selected_old_scale = vector.splat %old_scale : vector<8xf32>
    %w8 = vector.reduce<addf> %weight, %zero_f32 : vector<8xf32>, f32
    %w8s, %sok = kernel.subgroup.shuffle<xor> %w8, %i32_16, %i32_32 : f32, i32, i32
    %tile_sum = scalar.addf %w8, %w8s : f32
    %scaled_sum = scalar.mulf %row_sum, %old_scale : f32
    %next_sum = scalar.addf %scaled_sum, %tile_sum : f32
    // P^T as the PV rhs, repacked in registers (v_permlanex16 + cvt + pack + v_perm)
    %probability = vector.fragment.repack<rhs> %weight shape [%m, %n] : vector<8xf32> -> vector<16xf16>
    %rescaled0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc0, %selected_old_scale : vector<8xf32>
    %rescaled1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc1, %selected_old_scale : vector<8xf32>
    %rescaled2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc2, %selected_old_scale : vector<8xf32>
    %rescaled3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc3, %selected_old_scale : vector<8xf32>
    %rescaled4 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc4, %selected_old_scale : vector<8xf32>
    %rescaled5 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc5, %selected_old_scale : vector<8xf32>
    %rescaled6 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc6, %selected_old_scale : vector<8xf32>
    %rescaled7 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc7, %selected_old_scale : vector<8xf32>
    %vrow0 = index.add %lane_column, %c0 : index
    %v_data0 = vector.load %v_tile_b[%vrow0, %c0] : view<128x24xf16> -> vector<16xf16>
    %v0 = vector.fragment<lhs> %v_data0 shape [%m, %k_frag] : vector<16xf16>
    %next0 = vector.mma %v0, %probability, %rescaled0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow1 = index.add %lane_column, %c16 : index
    %v_data1 = vector.load %v_tile_b[%vrow1, %c0] : view<128x24xf16> -> vector<16xf16>
    %v1 = vector.fragment<lhs> %v_data1 shape [%m, %k_frag] : vector<16xf16>
    %next1 = vector.mma %v1, %probability, %rescaled1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow2 = index.add %lane_column, %c32 : index
    %v_data2 = vector.load %v_tile_b[%vrow2, %c0] : view<128x24xf16> -> vector<16xf16>
    %v2 = vector.fragment<lhs> %v_data2 shape [%m, %k_frag] : vector<16xf16>
    %next2 = vector.mma %v2, %probability, %rescaled2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow3 = index.add %lane_column, %c48 : index
    %v_data3 = vector.load %v_tile_b[%vrow3, %c0] : view<128x24xf16> -> vector<16xf16>
    %v3 = vector.fragment<lhs> %v_data3 shape [%m, %k_frag] : vector<16xf16>
    %next3 = vector.mma %v3, %probability, %rescaled3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow4 = index.add %lane_column, %c64 : index
    %v_data4 = vector.load %v_tile_b[%vrow4, %c0] : view<128x24xf16> -> vector<16xf16>
    %v4 = vector.fragment<lhs> %v_data4 shape [%m, %k_frag] : vector<16xf16>
    %next4 = vector.mma %v4, %probability, %rescaled4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow5 = index.add %lane_column, %c80 : index
    %v_data5 = vector.load %v_tile_b[%vrow5, %c0] : view<128x24xf16> -> vector<16xf16>
    %v5 = vector.fragment<lhs> %v_data5 shape [%m, %k_frag] : vector<16xf16>
    %next5 = vector.mma %v5, %probability, %rescaled5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow6 = index.add %lane_column, %c96 : index
    %v_data6 = vector.load %v_tile_b[%vrow6, %c0] : view<128x24xf16> -> vector<16xf16>
    %v6 = vector.fragment<lhs> %v_data6 shape [%m, %k_frag] : vector<16xf16>
    %next6 = vector.mma %v6, %probability, %rescaled6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow7 = index.add %lane_column, %c112 : index
    %v_data7 = vector.load %v_tile_b[%vrow7, %c0] : view<128x24xf16> -> vector<16xf16>
    %v7 = vector.fragment<lhs> %v_data7 shape [%m, %k_frag] : vector<16xf16>
    %next7 = vector.mma %v7, %probability, %rescaled7 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    scf.yield %next_max, %next_sum, %next0, %next1, %next2, %next3, %next4, %next5, %next6, %next7, %k_next : f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<4xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %selected_sum = vector.splat %final_sum : vector<8xf32>
  %out0 = vector.divf<nnan|ninf|nsz|arcp> %final0, %selected_sum : vector<8xf32>
  %out1 = vector.divf<nnan|ninf|nsz|arcp> %final1, %selected_sum : vector<8xf32>
  %out2 = vector.divf<nnan|ninf|nsz|arcp> %final2, %selected_sum : vector<8xf32>
  %out3 = vector.divf<nnan|ninf|nsz|arcp> %final3, %selected_sum : vector<8xf32>
  %out4 = vector.divf<nnan|ninf|nsz|arcp> %final4, %selected_sum : vector<8xf32>
  %out5 = vector.divf<nnan|ninf|nsz|arcp> %final5, %selected_sum : vector<8xf32>
  %out6 = vector.divf<nnan|ninf|nsz|arcp> %final6, %selected_sum : vector<8xf32>
  %out7 = vector.divf<nnan|ninf|nsz|arcp> %final7, %selected_sum : vector<8xf32>
  // Publish one 16x16 fragment at a time through this wave's 1 KB stage: each lane
  // takes two vector4 slices, rows past the sequence dropped.
  %publish_row0 = index.div %lane, %c4 : index
  %publish_col_group = index.rem %lane, %c4 : index
  %publish_col = index.mul %publish_col_group, %c4 : index
  scf.for %fragment = [%c0 to %c_nf step %c1] {
    %is1 = index.cmp eq, %fragment, %c1 : index
    %pick1 = scf.select %is1, %out1, %out0 : vector<8xf32>
    %is2 = index.cmp eq, %fragment, %c2 : index
    %pick2 = scf.select %is2, %out2, %pick1 : vector<8xf32>
    %is3 = index.cmp eq, %fragment, %c3 : index
    %pick3 = scf.select %is3, %out3, %pick2 : vector<8xf32>
    %is4 = index.cmp eq, %fragment, %c4 : index
    %pick4 = scf.select %is4, %out4, %pick3 : vector<8xf32>
    %is5 = index.cmp eq, %fragment, %c5 : index
    %pick5 = scf.select %is5, %out5, %pick4 : vector<8xf32>
    %is6 = index.cmp eq, %fragment, %c6 : index
    %pick6 = scf.select %is6, %out6, %pick5 : vector<8xf32>
    %is7 = index.cmp eq, %fragment, %c7 : index
    %pick7 = scf.select %is7, %out7, %pick6 : vector<8xf32>
    vector.fragment.store<result> %pick7, %result_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
    %frag_col = index.mul %fragment, %c16 : index
    %out_column_base = index.add %head_base0, %frag_col : index
    scf.for %half = [%c0 to %c2 step %c1] {
      %row_offset = index.mul %half, %c8 : index
      %publish_row = index.add %publish_row0, %row_offset : index
      %out_column_ca = index.add %out_column_base, %publish_row : index
      %out_column_c = index.assume %out_column_ca [lt(%out_column_ca, %out_stride0)] : index
      %values = vector.load %result_view[%publish_row, %publish_col] : view<16x16xf32> -> vector<4xf32>
      %halves = vector.fptrunc %values : vector<4xf32> to vector<4xf16>
      %pe0 = vector.extract %halves[0] : vector<4xf16> -> f16
      %pq0a = index.add %query_origin0, %publish_col : index
      %pq0 = index.add %pq0a, %c0 : index
      %pp0 = index.cmp ult, %pq0, %tokens0 : index
      %pr0 = index.cmp ult, %pq0, %token_count : index
      %pw0 = scalar.andi %pp0, %pr0 : i1
      scf.if %pw0 {
        %pg0 = index.assume %pq0 [lt(%pq0, %token_count)] : index
        view.store %pe0, %out_view[%pg0, %out_column_c] : f16, view<[%token_count]x[%out_stride0]xf16>
      }
      %pe1 = vector.extract %halves[1] : vector<4xf16> -> f16
      %pq1a = index.add %query_origin0, %publish_col : index
      %pq1 = index.add %pq1a, %c1 : index
      %pp1 = index.cmp ult, %pq1, %tokens0 : index
      %pr1 = index.cmp ult, %pq1, %token_count : index
      %pw1 = scalar.andi %pp1, %pr1 : i1
      scf.if %pw1 {
        %pg1 = index.assume %pq1 [lt(%pq1, %token_count)] : index
        view.store %pe1, %out_view[%pg1, %out_column_c] : f16, view<[%token_count]x[%out_stride0]xf16>
      }
      %pe2 = vector.extract %halves[2] : vector<4xf16> -> f16
      %pq2a = index.add %query_origin0, %publish_col : index
      %pq2 = index.add %pq2a, %c2 : index
      %pp2 = index.cmp ult, %pq2, %tokens0 : index
      %pr2 = index.cmp ult, %pq2, %token_count : index
      %pw2 = scalar.andi %pp2, %pr2 : i1
      scf.if %pw2 {
        %pg2 = index.assume %pq2 [lt(%pq2, %token_count)] : index
        view.store %pe2, %out_view[%pg2, %out_column_c] : f16, view<[%token_count]x[%out_stride0]xf16>
      }
      %pe3 = vector.extract %halves[3] : vector<4xf16> -> f16
      %pq3a = index.add %query_origin0, %publish_col : index
      %pq3 = index.add %pq3a, %c3 : index
      %pp3 = index.cmp ult, %pq3, %tokens0 : index
      %pr3 = index.cmp ult, %pq3, %token_count : index
      %pw3 = scalar.andi %pp3, %pr3 : i1
      scf.if %pw3 {
        %pg3 = index.assume %pq3 [lt(%pq3, %token_count)] : index
        view.store %pe3, %out_view[%pg3, %out_column_c] : f16, view<[%token_count]x[%out_stride0]xf16>
      }
    }
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  }
  kernel.return
}
