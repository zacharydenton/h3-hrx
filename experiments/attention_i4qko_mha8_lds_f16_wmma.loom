  %orow5b = index.add %orow5a, %lane_group : index
  %ovalid5a = index.cmp ult, %orow5b, %tokens0 : index
  %ovalid5b = index.cmp ult, %orow5b, %token_count : index
  %ovalid5 = scalar.andi %ovalid5a, %ovalid5b : i1
