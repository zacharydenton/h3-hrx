  %orow3b = index.add %orow3a, %lane_group : index
  %ovalid3a = index.cmp ult, %orow3b, %tokens0 : index
  %ovalid3b = index.cmp ult, %orow3b, %token_count : index
  %ovalid3 = scalar.andi %ovalid3a, %ovalid3b : i1
  %orow4a = index.add %query_origin0, %c8 : index
  %orow4b = index.add %orow4a, %lane_group : index
  %ovalid4a = index.cmp ult, %orow4b, %tokens0 : index
  %ovalid4b = index.cmp ult, %orow4b, %token_count : index
  %ovalid4 = scalar.andi %ovalid4a, %ovalid4b : i1
