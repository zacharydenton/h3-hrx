    %o13_2 = vector.mma %la1_2, %rb3_2, %o13_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o20_2 = vector.mma %la2_2, %rb0_2, %o20_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o21_2 = vector.mma %la2_2, %rb1_2, %o21_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o22_2 = vector.mma %la2_2, %rb2_2, %o22_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
