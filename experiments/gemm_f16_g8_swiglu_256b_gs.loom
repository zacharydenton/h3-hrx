    %rb3_3 = vector.fragment<rhs> %db3_3 shape [%k, %n] : vector<16xf16>
    %o00_3 = vector.mma %la0_3, %rb0_3, %o00_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o01_3 = vector.mma %la0_3, %rb1_3, %o01_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o02_3 = vector.mma %la0_3, %rb2_3, %o02_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o03_3 = vector.mma %la0_3, %rb3_3, %o03_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o10_3 = vector.mma %la1_3, %rb0_3, %o10_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o11_3 = vector.mma %la1_3, %rb1_3, %o11_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o12_3 = vector.mma %la1_3, %rb2_3, %o12_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o13_3 = vector.mma %la1_3, %rb3_3, %o13_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o20_3 = vector.mma %la2_3, %rb0_3, %o20_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o21_3 = vector.mma %la2_3, %rb1_3, %o21_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o22_3 = vector.mma %la2_3, %rb2_3, %o22_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o23_3 = vector.mma %la2_3, %rb3_3, %o23_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o30_3 = vector.mma %la3_3, %rb0_3, %o30_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o31_3 = vector.mma %la3_3, %rb1_3, %o31_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o32_3 = vector.mma %la3_3, %rb2_3, %o32_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o33_3 = vector.mma %la3_3, %rb3_3, %o33_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %o00_3, %o01_3, %o02_3, %o03_3, %o10_3, %o11_3, %o12_3, %o13_3, %o20_3, %o21_3, %o22_3, %o23_3, %o30_3, %o31_3, %o32_3, %o33_3, %na0, %na1, %nw0, %nw1, %nw2, %nw3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<16xf16>, vector<16xf16>, vector<16xf16>, vector<16xf16>, vector<16xf16>, vector<16xf16>
  }
  %publish_row0 = index.div %lane, %c4 : index
  %publish_col_group = index.rem %lane, %c4 : index
  %publish_col = index.mul %publish_col_group, %c4 : index
  %publish_col_half = index.mul %publish_col_group, %c2 : index
  %one_f32 = scalar.constant 1.0 : f32
  %zero_f32 = scalar.constant 0.0 : f32
  %one4 = vector.splat %one_f32 : vector<4xf32>
  %zero4 = vector.splat %zero_f32 : vector<4xf32>
  %f16_max = scalar.constant 65472.0 : f32
  %f16_min = scalar.constant -65472.0 : f32
  %f16_max4 = vector.splat %f16_max : vector<4xf32>
  %f16_min4 = vector.splat %f16_min : vector<4xf32>
  %up_stage_offset = index.constant 1024 : offset
  %wave_up_offset = index.add %wave_result_offset, %up_stage_offset : offset
  %up_view = buffer.view %lds[%wave_up_offset] : buffer -> view<16x16xf32>
  scf.for %step = [%c0 to %c8 step %c1] {
    %fi = index.div %step, %c2 : index
    %pj = index.rem %step, %c2 : index
    %g_is1 = index.cmp eq, %step, %cf1 : index
    %g_p1 = scf.select %g_is1, %acc02, %acc00 : vector<8xf32>
    %g_is2 = index.cmp eq, %step, %cf2 : index
    %g_p2 = scf.select %g_is2, %acc10, %g_p1 : vector<8xf32>
    %g_is3 = index.cmp eq, %step, %cf3 : index
    %g_p3 = scf.select %g_is3, %acc12, %g_p2 : vector<8xf32>
    %g_is4 = index.cmp eq, %step, %cf4 : index
    %g_p4 = scf.select %g_is4, %acc20, %g_p3 : vector<8xf32>
    %g_is5 = index.cmp eq, %step, %cf5 : index
    %g_p5 = scf.select %g_is5, %acc22, %g_p4 : vector<8xf32>
    %g_is6 = index.cmp eq, %step, %cf6 : index
    %g_p6 = scf.select %g_is6, %acc30, %g_p5 : vector<8xf32>
    %g_is7 = index.cmp eq, %step, %cf7 : index
    %g_p7 = scf.select %g_is7, %acc32, %g_p6 : vector<8xf32>
    %u_is1 = index.cmp eq, %step, %cf1 : index
    %u_p1 = scf.select %u_is1, %acc03, %acc01 : vector<8xf32>
    %u_is2 = index.cmp eq, %step, %cf2 : index
    %u_p2 = scf.select %u_is2, %acc11, %u_p1 : vector<8xf32>
    %u_is3 = index.cmp eq, %step, %cf3 : index
    %u_p3 = scf.select %u_is3, %acc13, %u_p2 : vector<8xf32>
    %u_is4 = index.cmp eq, %step, %cf4 : index
    %u_p4 = scf.select %u_is4, %acc21, %u_p3 : vector<8xf32>
    %u_is5 = index.cmp eq, %step, %cf5 : index
    %u_p5 = scf.select %u_is5, %acc23, %u_p4 : vector<8xf32>
    %u_is6 = index.cmp eq, %step, %cf6 : index
    %u_p6 = scf.select %u_is6, %acc31, %u_p5 : vector<8xf32>
    %u_is7 = index.cmp eq, %step, %cf7 : index
    %u_p7 = scf.select %u_is7, %acc33, %u_p6 : vector<8xf32>
    vector.fragment.store<result> %g_p7, %result_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
    vector.fragment.store<result> %u_p7, %up_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
    %frag_row_offset = index.mul %fi, %c16 : index
    %gate_col_offset = index.mul %pj, %c32 : index
    %gate_tile_col = index.add %wave_col, %gate_col_offset : index
    %gate_col_local = index.add %gate_tile_col, %publish_col : index
    %gate_col = index.add %base_n, %gate_col_local : index
    %up_col = index.add %gate_col, %c16 : index
    %out_col0 = index.div %gate_col, %c2 : index
    %out_col1 = index.add %out_col0, %publish_col : index
    %out_col2 = index.sub %out_col1, %publish_col_half : index
    %out_col = index.assume %out_col2 [lt(%out_col2, %n_half)] : index
    scf.for %half = [%c0 to %c2 step %c1] {
      %row_offset = index.mul %half, %c8 : index
      %publish_row = index.add %publish_row0, %row_offset : index
      %gate_values = vector.load %result_view[%publish_row, %publish_col] : view<16x16xf32> -> vector<4xf32>
      %up_values = vector.load %up_view[%publish_row, %publish_col] : view<16x16xf32> -> vector<4xf32>
      %gate_f32 = vector.addf %gate_values, %zero4 : vector<4xf32>
      %up_f32 = vector.addf %up_values, %zero4 : vector<4xf32>
      %gate_scaled0 = vector.addf %gate_f32, %zero4 : vector<4xf32>
      %up_scaled0 = vector.addf %up_f32, %zero4 : vector<4xf32>
      %row_in_wave = index.add %frag_row_offset, %publish_row : index
      %row_local = index.add %wave_row, %row_in_wave : index
      %out_row = index.add %base_m, %row_local : index
      %writes = index.cmp ult, %out_row, %m_bounded : index
      scf.if %writes {
        %bounded = index.assume %out_row [lt(%out_row, %m_bounded)] : index
        %g0 = vector.addf %gate_scaled0, %zero4 : vector<4xf32>
        %u0 = vector.addf %up_scaled0, %zero4 : vector<4xf32>
        %gate_bias = vector.load %bias_view[%gate_col] : view<[%n_size]xf32> -> vector<4xf32>
        %up_bias = vector.load %bias_view[%up_col] : view<[%n_size]xf32> -> vector<4xf32>
        %g1 = vector.addf %g0, %gate_bias : vector<4xf32>
        %u1 = vector.addf %u0, %up_bias : vector<4xf32>
        %g = vector.addf %u1, %zero4 : vector<4xf32>
        %u = vector.addf %g1, %zero4 : vector<4xf32>
        %neg_g = vector.subf %zero4, %g : vector<4xf32>
        %e = vector.expf<afn> %neg_g : vector<4xf32>
        %den = vector.addf %one4, %e : vector<4xf32>
        %sig = vector.divf %one4, %den : vector<4xf32>
        %silu = vector.mulf %g, %sig : vector<4xf32>
        %prod = vector.mulf %silu, %u : vector<4xf32>
        %sat0 = vector.minnumf %prod, %f16_max4 : vector<4xf32>
        %sat = vector.maxnumf %sat0, %f16_min4 : vector<4xf32>
        %narrow = vector.fptrunc %sat : vector<4xf32> to vector<4xf16>
        vector.store %narrow, %c_view[%bounded, %out_col] : vector<4xf16>, view<[%m_bounded]x[%out_stride]xf16>
      }
    }
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  }
  kernel.return
}
