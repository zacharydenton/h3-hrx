    %o32_2 = vector.mma %la3_2, %rb2_2, %o32_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %o33_2 = vector.mma %la3_2, %rb3_2, %o33_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %da0_3 = vector.load %a_stage[%fa0, %c48] : view<128x72xf16> -> vector<16xf16>
    %da1_3 = vector.load %a_stage[%fa1, %c48] : view<128x72xf16> -> vector<16xf16>
    %da2_3 = vector.load %a_stage[%fa2, %c48] : view<128x72xf16> -> vector<16xf16>
    %da3_3 = vector.load %a_stage[%fa3, %c48] : view<128x72xf16> -> vector<16xf16>
    %db0_3 = vector.load %w_stage[%fb0, %c48] : view<256x72xf16> -> vector<16xf16>
    %db1_3 = vector.load %w_stage[%fb1, %c48] : view<256x72xf16> -> vector<16xf16>
    %db2_3 = vector.load %w_stage[%fb2, %c48] : view<256x72xf16> -> vector<16xf16>
    %db3_3 = vector.load %w_stage[%fb3, %c48] : view<256x72xf16> -> vector<16xf16>
    %la0_3 = vector.fragment<lhs> %da0_3 shape [%m, %k] : vector<16xf16>
    %la1_3 = vector.fragment<lhs> %da1_3 shape [%m, %k] : vector<16xf16>
    %la2_3 = vector.fragment<lhs> %da2_3 shape [%m, %k] : vector<16xf16>
    %la3_3 = vector.fragment<lhs> %da3_3 shape [%m, %k] : vector<16xf16>
