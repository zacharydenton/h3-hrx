// Sixteen output channels share each input sample; weights are [Cout/16][Cin*kernel][16].
// Visit only the output phase's contributing taps, retaining ascending channel/tap FP32 FMAs.
amdgpu.target<gfx11-generic> @h3_convt1d_block_f32_gfx11 {subgroup_size = 32}

config.decl @h3.convt1d_block_f32.cin : %value: index where [range(%value, 1, 4096)]

config.decl @h3.convt1d_block_f32.cout : %value: index where [range(%value, 16, 4096), mul(%value, 16)]

config.decl @h3.convt1d_block_f32.ksize : %value: index where [range(%value, 1, 64)]

config.decl @h3.convt1d_block_f32.stride : %value: index where [range(%value, 1, 64)]

config.decl @h3.convt1d_block_f32.pad : %value: index where [range(%value, 0, 1024)]

config.decl @h3.convt1d_block_f32.len_bound : %value: index where [range(%value, 256, 4194304), mul(%value, 256)]

kernel.def target(@h3_convt1d_block_f32_gfx11) export("h3_convt1d_block_f32") @h3_convt1d_block_f32(%len: index, %olen: index) {
