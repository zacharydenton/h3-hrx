  %tc0 = index.constant 0 : index
  %n0 = index.add %n, %tc0 : index
  %active0 = index.cmp ult, %n0, %outlen : index
  %plus0 = index.add %n0, %pad : index
  %phase0 = index.rem %plus0, %stride : index
  %source0 = index.div %plus0, %stride : index
  %acc0_0, %acc1_0, %acc2_0, %acc3_0, %acc4_0, %acc5_0, %acc6_0, %acc7_0, %acc8_0, %acc9_0, %acc10_0, %acc11_0, %acc12_0, %acc13_0, %acc14_0, %acc15_0 = scf.for %ic = [%z to %cin step %one](%ai0_0 = %bias0 : f32, %ai1_0 = %bias1 : f32, %ai2_0 = %bias2 : f32, %ai3_0 = %bias3 : f32, %ai4_0 = %bias4 : f32, %ai5_0 = %bias5 : f32, %ai6_0 = %bias6 : f32, %ai7_0 = %bias7 : f32, %ai8_0 = %bias8 : f32, %ai9_0 = %bias9 : f32, %ai10_0 = %bias10 : f32, %ai11_0 = %bias11 : f32, %ai12_0 = %bias12 : f32, %ai13_0 = %bias13 : f32, %ai14_0 = %bias14 : f32, %ai15_0 = %bias15 : f32) -> (f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, f32) {
