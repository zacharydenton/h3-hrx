  %z = index.constant 0 : index
  %one = index.constant 1 : index
  %offset = index.constant 0 : offset
  %span = index.constant 64 : index
  %otile = index.constant 16 : index
  %length = index.assume %len [range(%len, 1, 4194304), le(%len, %len_bound)] : index
  %outlen = index.assume %olen [range(%olen, 1, 4194304), le(%olen, %len_bound)] : index
  %gxb = index.div %len_bound, %span : index
  %gyb = index.div %cout, %otile : index
  %gx0 = kernel.workgroup.id<x> : index
  %gy0 = kernel.workgroup.id<y> : index
  %gx = index.assume %gx0 [lt(%gx0, %gxb)] : index
  %gy = index.assume %gy0 [lt(%gy0, %gyb)] : index
