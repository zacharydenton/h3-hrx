// Byte-preserving pitched rows, including zero padding of each completed row.
config.decl @h3.weight_rows.row_bytes : %value: index where [range(%value, 1, 2147483647)]
config.decl @h3.weight_rows.pitch_bytes : %value: index where [range(%value, 1, 2147483647)]
kernel.def export("h3_weight_rows") @h3_weight_rows(%output_bytes: index) {
  %one = index.constant 1 : index
  %width = index.constant 256 : index
  %round = index.constant 255 : index
  %rounded = index.add %output_bytes, %round : index
  %groups = index.div %rounded, %width : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%width, %one, %one) : index
} launch(%input: buffer, %output: buffer, %count32: i32, %first32: i32, %span32: i32) {
  %zero = index.constant 0 : offset
  %width = index.constant 256 : index
  %count_raw = index.cast %count32 : i32 to index
  %count = index.assume %count_raw [range(%count_raw, 1, 2147483647)] : index
  %first_raw = index.cast %first32 : i32 to index
  %first = index.assume %first_raw [range(%first_raw, 0, 2147483647)] : index
  %row = config.get @h3.weight_rows.row_bytes : index
  %pitch = config.get @h3.weight_rows.pitch_bytes : index
  %span_raw = index.cast %span32 : i32 to index
  %span = index.assume %span_raw [range(%span_raw, 1, 2147483647)] : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %base = index.mul %group, %width : index
  %i = index.add %base, %lane : index
  %src = buffer.view %input[%zero] : buffer -> view<[%count]xi8>
  %dst = buffer.view %output[%zero] : buffer -> view<[%span]xi8>
  %extent = index.sub %span, %first : index
  %active = index.cmp ult, %i, %extent : index
  scf.if %active {
    %at_raw = index.add %first, %i : index
    %at = index.assume %at_raw [range(%at_raw, 0, 2147483647)] : index
    %r = index.div %at, %pitch : index
    %c = index.rem %at, %pitch : index
    %data = index.cmp ult, %c, %row : index
    %value = scf.if %data -> (i8) {
      %start = index.mul %r, %row : index
      %position = index.add %start, %c : index
      %input = index.sub %position, %first : index
      %checked = index.assume %input [range(%input, 0, 2147483647), lt(%input, %count)] : index
      %byte = view.load %src[%checked] : view<[%count]xi8> -> i8
      scf.yield %byte : i8
    } else {
      %pad = scalar.constant 0 : i8
      scf.yield %pad : i8
    }
    %checked = index.assume %at [lt(%at, %span)] : index
    view.store %value, %dst[%checked] : i8, view<[%span]xi8>
  }
  kernel.return
}
