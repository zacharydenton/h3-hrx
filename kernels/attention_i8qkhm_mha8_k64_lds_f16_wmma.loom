  %out7 = vector.divf<nnan|ninf|nsz|arcp> %final7, %selected_sum : vector<8xf32>
  // Pair even and odd channels before the output mask, while both half-waves are active.
  // Only the first half-wave stores; its own words always hold the even channels.
  %half0 = vector.fptrunc %out0 : vector<8xf32> to vector<8xf16>
  %words0 = vector.bitcast %half0 : vector<8xf16> to vector<4xi32>
  %other0, %other_ok0 = kernel.subgroup.shuffle<xor> %words0, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %packed0 = low.invoke @h3_interleave_f16(%words0, %other0) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %half1 = vector.fptrunc %out1 : vector<8xf32> to vector<8xf16>
  %words1 = vector.bitcast %half1 : vector<8xf16> to vector<4xi32>
  %other1, %other_ok1 = kernel.subgroup.shuffle<xor> %words1, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %packed1 = low.invoke @h3_interleave_f16(%words1, %other1) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %half2 = vector.fptrunc %out2 : vector<8xf32> to vector<8xf16>
  %words2 = vector.bitcast %half2 : vector<8xf16> to vector<4xi32>
  %other2, %other_ok2 = kernel.subgroup.shuffle<xor> %words2, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %packed2 = low.invoke @h3_interleave_f16(%words2, %other2) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %half3 = vector.fptrunc %out3 : vector<8xf32> to vector<8xf16>
  %words3 = vector.bitcast %half3 : vector<8xf16> to vector<4xi32>
  %other3, %other_ok3 = kernel.subgroup.shuffle<xor> %words3, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %packed3 = low.invoke @h3_interleave_f16(%words3, %other3) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %half4 = vector.fptrunc %out4 : vector<8xf32> to vector<8xf16>
  %words4 = vector.bitcast %half4 : vector<8xf16> to vector<4xi32>
  %other4, %other_ok4 = kernel.subgroup.shuffle<xor> %words4, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %packed4 = low.invoke @h3_interleave_f16(%words4, %other4) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %half5 = vector.fptrunc %out5 : vector<8xf32> to vector<8xf16>
  %words5 = vector.bitcast %half5 : vector<8xf16> to vector<4xi32>
  %other5, %other_ok5 = kernel.subgroup.shuffle<xor> %words5, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %packed5 = low.invoke @h3_interleave_f16(%words5, %other5) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %half6 = vector.fptrunc %out6 : vector<8xf32> to vector<8xf16>
  %words6 = vector.bitcast %half6 : vector<8xf16> to vector<4xi32>
  %other6, %other_ok6 = kernel.subgroup.shuffle<xor> %words6, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %packed6 = low.invoke @h3_interleave_f16(%words6, %other6) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %half7 = vector.fptrunc %out7 : vector<8xf32> to vector<8xf16>
  %words7 = vector.bitcast %half7 : vector<8xf16> to vector<4xi32>
  %other7, %other_ok7 = kernel.subgroup.shuffle<xor> %words7, %i32_16, %i32_32 : vector<4xi32>, i32, i32
  %packed7 = low.invoke @h3_interleave_f16(%words7, %other7) : (vector<4xi32>, vector<4xi32>) -> (vector<16xf16>)
  %row_present = index.cmp ult, %q_row, %tokens0 : index
  %row_in_range = index.cmp ult, %q_row, %token_count : index
  %writes0 = scalar.andi %row_present, %row_in_range : i1
  %tile_present = index.cmp ult, %tile_in_image0, %tiles_per_image : index
  %writes1 = scalar.andi %writes0, %tile_present : i1
  %writes = scalar.andi %writes1, %lane_group_even : i1
  scf.if %writes {
    %global_row = index.assume %q_row [lt(%q_row, %token_count)] : index
    %out_limit = index.sub %out_stride0, %c16 : index
    %oc0 = index.constant 0 : index
    %col0_0 = index.add %head_base0, %oc0 : index
    %col0 = index.assume %col0_0 [le(%col0_0, %out_limit), mul(%col0_0, 16)] : index
    vector.store %packed0, %out_view[%global_row, %col0] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %oc16 = index.constant 16 : index
    %col16_0 = index.add %head_base0, %oc16 : index
    %col16 = index.assume %col16_0 [le(%col16_0, %out_limit), mul(%col16_0, 16)] : index
    vector.store %packed1, %out_view[%global_row, %col16] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %oc32 = index.constant 32 : index
    %col32_0 = index.add %head_base0, %oc32 : index
    %col32 = index.assume %col32_0 [le(%col32_0, %out_limit), mul(%col32_0, 16)] : index
    vector.store %packed2, %out_view[%global_row, %col32] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %oc48 = index.constant 48 : index
    %col48_0 = index.add %head_base0, %oc48 : index
    %col48 = index.assume %col48_0 [le(%col48_0, %out_limit), mul(%col48_0, 16)] : index
    vector.store %packed3, %out_view[%global_row, %col48] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %oc64 = index.constant 64 : index
    %col64_0 = index.add %head_base0, %oc64 : index
    %col64 = index.assume %col64_0 [le(%col64_0, %out_limit), mul(%col64_0, 16)] : index
    vector.store %packed4, %out_view[%global_row, %col64] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %oc80 = index.constant 80 : index
    %col80_0 = index.add %head_base0, %oc80 : index
    %col80 = index.assume %col80_0 [le(%col80_0, %out_limit), mul(%col80_0, 16)] : index
    vector.store %packed5, %out_view[%global_row, %col80] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %oc96 = index.constant 96 : index
    %col96_0 = index.add %head_base0, %oc96 : index
    %col96 = index.assume %col96_0 [le(%col96_0, %out_limit), mul(%col96_0, 16)] : index
    vector.store %packed6, %out_view[%global_row, %col96] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %oc112 = index.constant 112 : index
    %col112_0 = index.add %head_base0, %oc112 : index
    %col112 = index.assume %col112_0 [le(%col112_0, %out_limit), mul(%col112_0, 16)] : index
    vector.store %packed7, %out_view[%global_row, %col112] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
  }
  kernel.return
}
