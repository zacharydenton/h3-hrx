// out[c][r] = x[r][c] for f32 [rows][cols] -> [cols][rows] (the audio encoder's plane <-> row layouts).
amdgpu.target<gfx11-generic> @h3_transpose_f32_gfx11 {subgroup_size = 32}

config.decl @h3.transpose_f32.cols : %value: index where [range(%value, 1, 65536)]

kernel.def target(@h3_transpose_f32_gfx11) export("h3_transpose_f32") @h3_transpose_f32(%rows: index) {
  %c1 = index.constant 1 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %cols = config.get @h3.transpose_f32.cols : index
  %count = index.mul %rows, %cols : index
  %rounded = index.add %count, %c255 : index
  %groups = index.div %rounded, %c256 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%rows: index, %x: buffer, %out: buffer) {
  %cols = config.get @h3.transpose_f32.cols : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %rows_b = index.assume %rows [range(%rows, 1, 65536)] : index
  %count = index.mul %rows_b, %cols : index
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %base = index.mul %wg, %c256 : index
  %i = index.add %base, %lane : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %x_view = buffer.view %x_global[%c0_offset] : buffer -> view<[%rows_b]x[%cols]xf32>
  %out_view = buffer.view %out_global[%c0_offset] : buffer -> view<[%cols]x[%rows_b]xf32>
  %active = index.cmp ult, %i, %count : index
  scf.if %active {
    %ii = index.assume %i [lt(%i, %count)] : index
    %r0 = index.div %ii, %cols : index
    %r = index.assume %r0 [lt(%r0, %rows_b)] : index
    %c = index.rem %ii, %cols : index
    %v = view.load %x_view[%r, %c] : view<[%rows_b]x[%cols]xf32> -> f32
    view.store %v, %out_view[%c, %r] : f32, view<[%cols]x[%rows_b]xf32>
  }
  kernel.return
}
