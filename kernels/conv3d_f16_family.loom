// Shared bodies; exported wrappers retain the original launch and configuration contracts.

template.decl @h3.shared_conv3d_f16_wmma_add(%m_size: index, %a: buffer, %w: buffer, %bias: buffer, %c: buffer, %residual: buffer, %cfg_frames: index, %cfg_height: index, %cfg_width: index, %cfg_stride: index, %cfg_tstride: index, %cfg_taps_t: index, %cfg_cin_pad: index, %cfg_cin_stride: index, %cfg_rows_bound: index, %cfg_k_size: index, %cfg_n_size: index, %add_residual: i1)

template.def<@h3.shared_conv3d_f16_wmma_add> @h3_body_conv3d_f16_wmma_add(%m_size: index, %a: buffer, %w: buffer, %bias: buffer, %c: buffer, %residual: buffer, %cfg_frames: index, %cfg_height: index, %cfg_width: index, %cfg_stride: index, %cfg_tstride: index, %cfg_taps_t: index, %cfg_cin_pad: index, %cfg_cin_stride: index, %cfg_rows_bound: index, %cfg_k_size: index, %cfg_n_size: index, %add_residual: i1) {
  %k_size = index.assume %cfg_k_size [range(%cfg_k_size, 32, 32768), mul(%cfg_k_size, 32)] : index
  %n_size = index.assume %cfg_n_size [range(%cfg_n_size, 64, 8192), mul(%cfg_n_size, 64)] : index

  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %a_stage_bytes = index.constant 5120 : offset
  %w_stage_bytes = index.constant 5120 : offset
  %result_stage_bytes = index.constant 8192 : offset
  %wave_result_bytes = index.constant 1024 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %zero_f32x8 = vector.constant 0.0 : vector<8xf32>
  %zero_f16x4 = vector.constant 0.0 : vector<4xf16>
  %zero_f16x8 = vector.constant 0.0 : vector<8xf16>

  %tile_n_id = kernel.workgroup.id<x> : index
  %tile_m_id = kernel.workgroup.id<y> : index
  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index

  %wave_m = index.div %subgroup, %c2 : index
  %wave_n = index.rem %subgroup, %c2 : index
  %wave_row = index.mul %wave_m, %c16 : index
  %wave_col = index.mul %wave_n, %c32 : index
  %wave_col1 = index.add %wave_col, %c16 : index
  %base_m = index.mul %tile_m_id, %c64 : index
  %base_n = index.mul %tile_n_id, %c64 : index

  %a_global = buffer.assume.memory_space<global> %a : buffer
  %w_global = buffer.assume.memory_space<global> %w : buffer
  %bias_global = buffer.assume.memory_space<global> %bias : buffer
  %c_global = buffer.assume.memory_space<global> %c : buffer
  // A is the channels-last input [frames*H*W][Cin_stride]; the [M][K] matrix is never formed.
  // M = T_out*Ho*Wo is a launch argument -- bounded here, never with `where`.
  %c3 = index.constant 3 : index
  %c9 = index.constant 9 : index
  %m_bounded = index.assume %m_size [range(%m_size, 1, 16777216)] : index
  %ho = index.div %cfg_height, %cfg_stride : index
  %wo = index.div %cfg_width, %cfg_stride : index
  %plane = index.mul %ho, %wo : index
  %in_rows_per_frame = index.mul %cfg_height, %cfg_width : index
  %in_rows_total0 = index.mul %cfg_frames, %in_rows_per_frame : index
  %in_rows_total = index.assume %in_rows_total0 [range(%in_rows_total0, 1, 2097152), le(%in_rows_total0, %cfg_rows_bound)] : index
  // rows_bound * cin_stride * 2 must fit 32 bits: the host sets it per shape
  %taps = index.mul %c9, %cfg_taps_t : index
  %k_real = index.mul %cfg_cin_pad, %taps : index
  %c_limit = index.sub %cfg_cin_pad, %c8 : index
  %is_2d = index.cmp eq, %cfg_taps_t, %c1 : index
  %is_s2 = index.cmp eq, %cfg_stride, %c2 : index
  %a_view = buffer.view %a_global[%c0_offset] : buffer -> view<[%in_rows_total]x[%cfg_cin_stride]xf16>
  %w_view = buffer.view %w_global[%c0_offset] : buffer -> view<[%n_size]x[%k_size]xf16>
  %bias_view = buffer.view %bias_global[%c0_offset] : buffer -> view<[%n_size]xf32>
  %c_view = buffer.view %c_global[%c0_offset] : buffer -> view<[%m_size]x[%n_size]xf16>
  %residual_global = buffer.assume.memory_space<global> %residual : buffer
  %residual_view = buffer.view %residual_global[%c0_offset] : buffer -> view<[%m_size]x[%n_size]xf16>

  %a_stage = buffer.alloca<workgroup> align(16) %a_stage_bytes : buffer
  %w_stage = buffer.alloca<workgroup> align(16) %w_stage_bytes : buffer
  %result_stage = buffer.alloca<workgroup> align(16) %result_stage_bytes : buffer
  %a_stage_view = buffer.view %a_stage[%c0_offset] : buffer -> view<64x40xf16>
  %w_stage_view = buffer.view %w_stage[%c0_offset] : buffer -> view<64x40xf16>
  // The rhs fragment wants logical [k][n]; the staged weight tile is physically
  // [n][k] with a 40-element row, so a strided layout reads it transposed.
  %w_fragment_layout = encoding.layout.strided [1, %c40] : encoding<layout>
  %w_fragment_view = buffer.view %w_stage[%c0_offset] : buffer -> view<32x64xf16, %w_fragment_layout>
  %wave_result_offset = index.scale %subgroup, %wave_result_bytes : index, offset -> offset
  %result_view = buffer.view %result_stage[%wave_result_offset] : buffer -> view<16x16xf32>

  %load_packet = index.rem %workitem, %c4 : index
  %load_k = index.mul %load_packet, %c8 : index
  %load_row0 = index.div %workitem, %c4 : index
  %load_row = index.assume %load_row0 [range(%load_row0, 0, 63)] : index

  %acc_init0 = vector.fragment<init> %zero_f32x8 shape [%m, %n] : vector<8xf32>
  %acc_init1 = vector.fragment<init> %zero_f32x8 shape [%m, %n] : vector<8xf32>

  // Hoisted out of the k-loop: this workitem stages tile row load_row -- one
  // output voxel -- for every k, so its (t, yo, xo) is decomposed once here;
  // per k only the tap and channel of the column remain.
  %h_m0 = index.add %base_m, %load_row : index
  %h_ok0 = index.cmp ult, %h_m0, %m_bounded : index
  %h_safe0 = scf.select %h_ok0, %h_m0, %c0 : index
  %h_b0 = index.assume %h_safe0 [lt(%h_safe0, %m_bounded)] : index
  %h_img0 = index.div %h_b0, %plane : index
  %h_pix0 = index.rem %h_b0, %plane : index
  %h_yo0 = index.div %h_pix0, %wo : index
  %h_xo0 = index.rem %h_pix0, %wo : index
  %h_ys0 = index.mul %h_yo0, %cfg_stride : index
  %h_xs0 = index.mul %h_xo0, %cfg_stride : index
  %h_tb0 = index.mul %h_img0, %cfg_tstride : index

  // The first step's packets, gathered before the loop; every iteration then
  // stores the packets it was handed and gathers the next step's while the
  // WMMA runs on the staged tile.
  %source_k_first = index.add %c0, %load_k : index
  %row_first = index.add %load_row, %c0 : index
  %source_m_first = index.add %base_m, %row_first : index
  %m_in_range_first = index.cmp ult, %source_m_first, %m_size : index
  // Implicit im2col: this row of A is output voxel (t, yo, xo) and this column is tap (dt, dy, dx) of
  // channel c. Zero before the first frame (causal) and beyond taps*Cin_pad; reflect padding in space.
  %in_k_first = index.cmp ult, %source_k_first, %k_real : index
  %gathers_first = scalar.andi %m_in_range_first, %in_k_first : i1
  %a_values_first = scf.if %gathers_first -> (vector<8xf16>) {
    %ys_first = index.add %h_ys0, %c0 : index
    %xs_first = index.add %h_xs0, %c0 : index
    %tb_first = index.add %h_tb0, %c0 : index
    %tap_first = index.div %source_k_first, %cfg_cin_pad : index
    %c_first = index.rem %source_k_first, %cfg_cin_pad : index
    %dt_full_first = index.div %tap_first, %c9 : index
    %rem9_first = index.rem %tap_first, %c9 : index
    %dy_first = index.div %rem9_first, %c3 : index
    %dx_first = index.rem %rem9_first, %c3 : index
    %dt_first = scf.select %is_2d, %c2, %dt_full_first : index
    // time: ti = tb + dt - 2, inside iff tb + dt >= 2
    %tplus_first = index.add %tb_first, %dt_first : index
    %t_ok_first = index.cmp uge, %tplus_first, %c2 : index
    // space, stride 1: y0 = yo + dy in [0, H + 1] -> reflect(y0 - 1); stride 2: y0 = 2*yo + dy in [0, H] -> H maps to H - 2
    %y0_first = index.add %ys_first, %dy_first : index
    %x0_first = index.add %xs_first, %dx_first : index
    %hm2_first = index.sub %cfg_height, %c2 : index
    %wm2_first = index.sub %cfg_width, %c2 : index
    %hp1_first = index.add %cfg_height, %c1 : index
    %wp1_first = index.add %cfg_width, %c1 : index
    // y0 - 1 only where y0 >= 1 (the branch proves it); y0 == 0 reflects to 1
    %y_ge1_first = index.cmp uge, %y0_first, %c1 : index
    %x_ge1_first = index.cmp uge, %x0_first, %c1 : index
    %y_mid_first = scf.if %y_ge1_first -> (index) {
      %ym_first = index.sub %y0_first, %c1 : index
      scf.yield %ym_first : index
    } else {
      scf.yield %c1 : index
    }
    %x_mid_first = scf.if %x_ge1_first -> (index) {
      %xm_first = index.sub %x0_first, %c1 : index
      scf.yield %xm_first : index
    } else {
      scf.yield %c1 : index
    }
    %y_top_first = index.cmp eq, %y0_first, %hp1_first : index
    %x_top_first = index.cmp eq, %x0_first, %wp1_first : index
    %yi_s1_first = scf.select %y_top_first, %hm2_first, %y_mid_first : index
    %xi_s1_first = scf.select %x_top_first, %wm2_first, %x_mid_first : index
    %y_isH = index.cmp eq, %y0_first, %cfg_height : index
    %x_isW = index.cmp eq, %x0_first, %cfg_width : index
    %yi_s2_first = scf.select %y_isH, %hm2_first, %y0_first : index
    %xi_s2_first = scf.select %x_isW, %wm2_first, %x0_first : index
    %yi0_first = scf.select %is_s2, %yi_s2_first, %yi_s1_first : index
    %xi0_first = scf.select %is_s2, %xi_s2_first, %xi_s1_first : index
    %loaded_first = scf.if %t_ok_first -> (vector<8xf16>) {
      %ti0_first = index.sub %tplus_first, %c2 : index
      %ti_first = index.assume %ti0_first [lt(%ti0_first, %cfg_frames)] : index
      %yi_first = index.assume %yi0_first [lt(%yi0_first, %cfg_height)] : index
      %xi_first = index.assume %xi0_first [lt(%xi0_first, %cfg_width)] : index
      %row_t_first = index.mul %ti_first, %cfg_height : index
      %row_y0_first = index.add %row_t_first, %yi_first : index
      %row_yw_first = index.mul %row_y0_first, %cfg_width : index
      %in_row0_first = index.add %row_yw_first, %xi_first : index
      %in_row_first = index.assume %in_row0_first [lt(%in_row0_first, %in_rows_total)] : index
      %c_col_first = index.assume %c_first [le(%c_first, %c_limit), mul(%c_first, 8)] : index
      %v_first = vector.load %a_view[%in_row_first, %c_col_first] : view<[%in_rows_total]x[%cfg_cin_stride]xf16> -> vector<8xf16>
      scf.yield %v_first : vector<8xf16>
    } else {
      scf.yield %zero_f16x8 : vector<8xf16>
    }
    scf.yield %loaded_first : vector<8xf16>
  } else {
    scf.yield %zero_f16x8 : vector<8xf16>
  }
  %source_n_first = index.add %base_n, %row_first : index
  %w_in_k_first = index.cmp ult, %source_k_first, %k_size : index
  %w_values_first = scf.if %w_in_k_first -> (vector<8xf16>) {
    %w_k_first = index.assume %source_k_first [lt(%source_k_first, %k_size)] : index
    %w_loaded_first = vector.load %w_view[%source_n_first, %w_k_first] : view<[%n_size]x[%k_size]xf16> -> vector<8xf16>
    scf.yield %w_loaded_first : vector<8xf16>
  } else {
    scf.yield %zero_f16x8 : vector<8xf16>
  }
  %acc0, %acc1, %a_values_last, %w_values_last = scf.for %k_base = [%c0 to %k_size step %c32](%run0 = %acc_init0 : vector<8xf32>, %run1 = %acc_init1 : vector<8xf32>, %a_cur = %a_values_first : vector<8xf16>, %w_cur = %w_values_first : vector<8xf16>) -> (vector<8xf32>, vector<8xf32>, vector<8xf16>, vector<8xf16>) {
    vector.store %a_cur, %a_stage_view[%load_row, %load_k] : vector<8xf16>, view<64x40xf16>
    vector.store %w_cur, %w_stage_view[%load_row, %load_k] : vector<8xf16>, view<64x40xf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %k_next = index.add %k_base, %c32 : index
    %source_k_next = index.add %k_next, %load_k : index
    %row_next = index.add %load_row, %c0 : index
    %source_m_next = index.add %base_m, %row_next : index
    %m_in_range_next = index.cmp ult, %source_m_next, %m_size : index
    // Implicit im2col: this row of A is output voxel (t, yo, xo) and this column is tap (dt, dy, dx) of
    // channel c. Zero before the first frame (causal) and beyond taps*Cin_pad; reflect padding in space.
    %in_k_next = index.cmp ult, %source_k_next, %k_real : index
    %gathers_next = scalar.andi %m_in_range_next, %in_k_next : i1
    %a_values_next = scf.if %gathers_next -> (vector<8xf16>) {
      %ys_next = index.add %h_ys0, %c0 : index
      %xs_next = index.add %h_xs0, %c0 : index
      %tb_next = index.add %h_tb0, %c0 : index
      %tap_next = index.div %source_k_next, %cfg_cin_pad : index
      %c_next = index.rem %source_k_next, %cfg_cin_pad : index
      %dt_full_next = index.div %tap_next, %c9 : index
      %rem9_next = index.rem %tap_next, %c9 : index
      %dy_next = index.div %rem9_next, %c3 : index
      %dx_next = index.rem %rem9_next, %c3 : index
      %dt_next = scf.select %is_2d, %c2, %dt_full_next : index
      // time: ti = tb + dt - 2, inside iff tb + dt >= 2
      %tplus_next = index.add %tb_next, %dt_next : index
      %t_ok_next = index.cmp uge, %tplus_next, %c2 : index
      // space, stride 1: y0 = yo + dy in [0, H + 1] -> reflect(y0 - 1); stride 2: y0 = 2*yo + dy in [0, H] -> H maps to H - 2
      %y0_next = index.add %ys_next, %dy_next : index
      %x0_next = index.add %xs_next, %dx_next : index
      %hm2_next = index.sub %cfg_height, %c2 : index
      %wm2_next = index.sub %cfg_width, %c2 : index
      %hp1_next = index.add %cfg_height, %c1 : index
      %wp1_next = index.add %cfg_width, %c1 : index
      // y0 - 1 only where y0 >= 1 (the branch proves it); y0 == 0 reflects to 1
      %y_ge1_next = index.cmp uge, %y0_next, %c1 : index
      %x_ge1_next = index.cmp uge, %x0_next, %c1 : index
      %y_mid_next = scf.if %y_ge1_next -> (index) {
        %ym_next = index.sub %y0_next, %c1 : index
        scf.yield %ym_next : index
      } else {
        scf.yield %c1 : index
      }
      %x_mid_next = scf.if %x_ge1_next -> (index) {
        %xm_next = index.sub %x0_next, %c1 : index
        scf.yield %xm_next : index
      } else {
        scf.yield %c1 : index
      }
      %y_top_next = index.cmp eq, %y0_next, %hp1_next : index
      %x_top_next = index.cmp eq, %x0_next, %wp1_next : index
      %yi_s1_next = scf.select %y_top_next, %hm2_next, %y_mid_next : index
      %xi_s1_next = scf.select %x_top_next, %wm2_next, %x_mid_next : index
      %y_isH = index.cmp eq, %y0_next, %cfg_height : index
      %x_isW = index.cmp eq, %x0_next, %cfg_width : index
      %yi_s2_next = scf.select %y_isH, %hm2_next, %y0_next : index
      %xi_s2_next = scf.select %x_isW, %wm2_next, %x0_next : index
      %yi0_next = scf.select %is_s2, %yi_s2_next, %yi_s1_next : index
      %xi0_next = scf.select %is_s2, %xi_s2_next, %xi_s1_next : index
      %loaded_next = scf.if %t_ok_next -> (vector<8xf16>) {
        %ti0_next = index.sub %tplus_next, %c2 : index
        %ti_next = index.assume %ti0_next [lt(%ti0_next, %cfg_frames)] : index
        %yi_next = index.assume %yi0_next [lt(%yi0_next, %cfg_height)] : index
        %xi_next = index.assume %xi0_next [lt(%xi0_next, %cfg_width)] : index
        %row_t_next = index.mul %ti_next, %cfg_height : index
        %row_y0_next = index.add %row_t_next, %yi_next : index
        %row_yw_next = index.mul %row_y0_next, %cfg_width : index
        %in_row0_next = index.add %row_yw_next, %xi_next : index
        %in_row_next = index.assume %in_row0_next [lt(%in_row0_next, %in_rows_total)] : index
        %c_col_next = index.assume %c_next [le(%c_next, %c_limit), mul(%c_next, 8)] : index
        %v_next = vector.load %a_view[%in_row_next, %c_col_next] : view<[%in_rows_total]x[%cfg_cin_stride]xf16> -> vector<8xf16>
        scf.yield %v_next : vector<8xf16>
      } else {
        scf.yield %zero_f16x8 : vector<8xf16>
      }
      scf.yield %loaded_next : vector<8xf16>
    } else {
      scf.yield %zero_f16x8 : vector<8xf16>
    }
    %source_n_next = index.add %base_n, %row_next : index
    %w_in_k_next = index.cmp ult, %source_k_next, %k_size : index
    %w_values_next = scf.if %w_in_k_next -> (vector<8xf16>) {
      %w_k_next = index.assume %source_k_next [lt(%source_k_next, %k_size)] : index
      %w_loaded_next = vector.load %w_view[%source_n_next, %w_k_next] : view<[%n_size]x[%k_size]xf16> -> vector<8xf16>
      scf.yield %w_loaded_next : vector<8xf16>
    } else {
      scf.yield %zero_f16x8 : vector<8xf16>
    }
    %next0, %next1 = scf.for %k_half = [%c0 to %c32 step %c16](%half0 = %run0 : vector<8xf32>, %half1 = %run1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) unroll {
      %lhs = vector.fragment.load<lhs> %a_stage_view[%wave_row, %k_half] shape [%m, %k] : view<64x40xf16> -> vector<16xf16>
      %rhs0 = vector.fragment.load<rhs> %w_fragment_view[%k_half, %wave_col] shape [%k, %n] : view<32x64xf16, %w_fragment_layout> -> vector<16xf16>
      %rhs1 = vector.fragment.load<rhs> %w_fragment_view[%k_half, %wave_col1] shape [%k, %n] : view<32x64xf16, %w_fragment_layout> -> vector<16xf16>
      %out0 = vector.mma %lhs, %rhs0, %half0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %out1 = vector.mma %lhs, %rhs1, %half1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      scf.yield %out0, %out1 : vector<8xf32>, vector<8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next0, %next1, %a_values_next, %w_values_next : vector<8xf32>, vector<8xf32>, vector<8xf16>, vector<8xf16>
  }

  // Publish through LDS: each lane takes two vector4 slices of the 16x16 tile.
  %publish_row0 = index.div %lane, %c4 : index
  %publish_row1 = index.add %publish_row0, %c8 : index
  %publish_col_group = index.rem %lane, %c4 : index
  %publish_col = index.mul %publish_col_group, %c4 : index

  scf.for %fragment = [%c0 to %c2 step %c1] {
    %is_second = index.cmp eq, %fragment, %c1 : index
    %chosen = scf.select %is_second, %acc1, %acc0 : vector<8xf32>
    vector.fragment.store<result> %chosen, %result_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)

    %fragment_col_offset = index.mul %fragment, %c16 : index
    %tile_col = index.add %wave_col, %fragment_col_offset : index
    %out_col_local = index.add %tile_col, %publish_col : index
    %out_col = index.add %base_n, %out_col_local : index
    %bias_values = vector.load %bias_view[%out_col] : view<[%n_size]xf32> -> vector<4xf32>

    scf.for %half = [%c0 to %c2 step %c1] {
      %row_offset = index.mul %half, %c8 : index
      %publish_row = index.add %publish_row0, %row_offset : index
      %values = vector.load %result_view[%publish_row, %publish_col] : view<16x16xf32> -> vector<4xf32>
      %biased = vector.addf %values, %bias_values : vector<4xf32>
      %row_local = index.add %wave_row, %publish_row : index
      %out_row = index.add %base_m, %row_local : index
      %writes = index.cmp ult, %out_row, %m_size : index
      scf.if %writes {
        %bounded = index.assume %out_row [lt(%out_row, %m_size)] : index
        %finished = scf.if %add_residual -> (vector<4xf32>) {
          %prior_half = vector.load %residual_view[%bounded, %out_col] : view<[%m_size]x[%n_size]xf16> -> vector<4xf16>
          %prior = vector.extf %prior_half : vector<4xf16> to vector<4xf32>
          %summed = vector.addf %biased, %prior : vector<4xf32>
          scf.yield %summed : vector<4xf32>
        } else {
          scf.yield %biased : vector<4xf32>
        }
        %narrow = vector.fptrunc %finished : vector<4xf32> to vector<4xf16>
        vector.store %narrow, %c_view[%bounded, %out_col] : vector<4xf16>, view<[%m_size]x[%n_size]xf16>
      }
    }
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  }
  template.return
}

