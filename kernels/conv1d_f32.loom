// out[o][n] = (accumulate ? out[o][n] : 0) + b[o] + sum_{i,k} w[o][i][k] * x[i][n + k*dilation - pad]
// f32, channel-major [C][len]; zero padding; one lane per output sample, a workgroup row per output channel.
amdgpu.target<gfx11-generic> @h3_conv1d_f32_gfx11 {subgroup_size = 32}

config.decl @h3.conv1d_f32.cin : %value: index where [range(%value, 1, 4096)]

config.decl @h3.conv1d_f32.cout : %value: index where [range(%value, 1, 4096)]

config.decl @h3.conv1d_f32.ksize : %value: index where [range(%value, 1, 64)]

config.decl @h3.conv1d_f32.dilation : %value: index where [range(%value, 1, 64)]

config.decl @h3.conv1d_f32.pad : %value: index where [range(%value, 0, 1024)]

config.decl @h3.conv1d_f32.accumulate : %value: index where [range(%value, 0, 1)]

config.decl @h3.conv1d_f32.len_bound : %value: index where [range(%value, 256, 4194304), mul(%value, 256)]

kernel.def target(@h3_conv1d_f32_gfx11) export("h3_conv1d_f32") @h3_conv1d_f32(%len: index) {
  %c1 = index.constant 1 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %cout = config.get @h3.conv1d_f32.cout : index
  %rounded = index.add %len, %c255 : index
  %groups = index.div %rounded, %c256 : index
  kernel.launch.config workgroups(%groups, %cout, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%len: index, %x: buffer, %w: buffer, %b: buffer, %out: buffer) {
  %cin = config.get @h3.conv1d_f32.cin : index
  %cout = config.get @h3.conv1d_f32.cout : index
  %ksize = config.get @h3.conv1d_f32.ksize : index
  %dilation = config.get @h3.conv1d_f32.dilation : index
  %pad = config.get @h3.conv1d_f32.pad : index
  %accumulate = config.get @h3.conv1d_f32.accumulate : index
  %len_bound = config.get @h3.conv1d_f32.len_bound : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %len_b = index.assume %len [range(%len, 1, 4194304), le(%len, %len_bound)] : index
  %wg = kernel.workgroup.id<x> : index
  %o0 = kernel.workgroup.id<y> : index
  %o = index.assume %o0 [lt(%o0, %cout)] : index
  %lane = kernel.workitem.id<x> : index
  %base = index.mul %wg, %c256 : index
  %n = index.add %base, %lane : index
  %taps = index.mul %cin, %ksize : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %w_global = buffer.assume.memory_space<global> %w : buffer
  %b_global = buffer.assume.memory_space<global> %b : buffer
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %x_view = buffer.view %x_global[%c0_offset] : buffer -> view<[%cin]x[%len_b]xf32>
  %w_view = buffer.view %w_global[%c0_offset] : buffer -> view<[%cout]x[%taps]xf32>
  %b_view = buffer.view %b_global[%c0_offset] : buffer -> view<[%cout]xf32>
  %out_view = buffer.view %out_global[%c0_offset] : buffer -> view<[%cout]x[%len_b]xf32>
  %active = index.cmp ult, %n, %len_b : index
  scf.if %active {
    %nn = index.assume %n [lt(%n, %len_b)] : index
    %bias = view.load %b_view[%o] : view<[%cout]xf32> -> f32
    %is_acc = index.cmp eq, %accumulate, %c1 : index
    %prev = scf.if %is_acc -> (f32) {
      %old = view.load %out_view[%o, %nn] : view<[%cout]x[%len_b]xf32> -> f32
      scf.yield %old : f32
    } else {
      scf.yield %zero : f32
    }
    %start = scalar.addf %prev, %bias : f32
    %acc = scf.for %i = [%c0 to %cin step %c1](%acc_i = %start : f32) -> (f32) {
      %ii = index.assume %i [lt(%i, %cin)] : index
      %row = index.mul %ii, %ksize : index
      %acc_k = scf.for %k = [%c0 to %ksize step %c1](%acc_kk = %acc_i : f32) -> (f32) {
        %kk = index.assume %k [lt(%k, %ksize)] : index
        %tap0 = index.add %row, %kk : index
        %tap = index.assume %tap0 [lt(%tap0, %taps)] : index
        %reach = index.mul %kk, %dilation : index
        %src_plus = index.add %nn, %reach : index
        %ge = index.cmp uge, %src_plus, %pad : index
        %src_raw = index.sub %src_plus, %pad : index
        %lt = index.cmp ult, %src_raw, %len_b : index
        %valid = scalar.andi %ge, %lt : i1
        %next = scf.if %valid -> (f32) {
          %src = index.assume %src_raw [range(%src_raw, 0, 4194304), lt(%src_raw, %len_b)] : index
          %wv = view.load %w_view[%o, %tap] : view<[%cout]x[%taps]xf32> -> f32
          %xv = view.load %x_view[%ii, %src] : view<[%cin]x[%len_b]xf32> -> f32
          %fma = scalar.fmaf %wv, %xv, %acc_kk : f32
          scf.yield %fma : f32
        } else {
          scf.yield %acc_kk : f32
        }
        scf.yield %next : f32
      }
      scf.yield %acc_k : f32
    }
    view.store %acc, %out_view[%o, %nn] : f32, view<[%cout]x[%len_b]xf32>
  }
  kernel.return
}
