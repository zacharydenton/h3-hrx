// Preserve the eight-wave normalization tree used to qualify VAE checkpoints.
// A different sum association can cross an f16 rounding boundary.
template.decl @h3.prepare_sum_f16(%value: f32, %lanes: index) -> (f32)
template.def<@h3.prepare_sum_f16> @h3_prepare_sum_f16(%value: f32, %lanes: index) -> (f32) {
  %c0 = index.constant 0 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %eight_waves = index.cmp eq, %lanes, %c256 : index
  %total = scf.if %eight_waves -> (f32) {
    %sum_bytes = index.constant 32 : offset
    %sum_lds = buffer.alloca<workgroup> align(16) %sum_bytes : buffer
    %sum_view = buffer.view %sum_lds[%c0_offset] : buffer -> view<8xf32>
    %sum_wave = kernel.subgroup.id : index
    %sum_lane = kernel.subgroup.lane.id : index
    %sum_leader = index.cmp eq, %sum_lane, %c0 : index
    %sum_partial = kernel.subgroup.reduce<addf> %value : f32
    scf.if %sum_leader {
      %sum_wave_b = index.assume %sum_wave [range(%sum_wave, 0, 7)] : index
      view.store %sum_partial, %sum_view[%sum_wave_b] : f32, view<8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %sum_i0 = index.constant 0 : index
    %sum_p0 = view.load %sum_view[%sum_i0] : view<8xf32> -> f32
    %sum_i1 = index.constant 1 : index
    %sum_p1 = view.load %sum_view[%sum_i1] : view<8xf32> -> f32
    %sum_i2 = index.constant 2 : index
    %sum_p2 = view.load %sum_view[%sum_i2] : view<8xf32> -> f32
    %sum_i3 = index.constant 3 : index
    %sum_p3 = view.load %sum_view[%sum_i3] : view<8xf32> -> f32
    %sum_i4 = index.constant 4 : index
    %sum_p4 = view.load %sum_view[%sum_i4] : view<8xf32> -> f32
    %sum_i5 = index.constant 5 : index
    %sum_p5 = view.load %sum_view[%sum_i5] : view<8xf32> -> f32
    %sum_i6 = index.constant 6 : index
    %sum_p6 = view.load %sum_view[%sum_i6] : view<8xf32> -> f32
    %sum_i7 = index.constant 7 : index
    %sum_p7 = view.load %sum_view[%sum_i7] : view<8xf32> -> f32
    %sum_pair0 = scalar.addf %sum_p0, %sum_p4 : f32
    %sum_pair1 = scalar.addf %sum_p1, %sum_p5 : f32
    %sum_pair2 = scalar.addf %sum_p2, %sum_p6 : f32
    %sum_pair3 = scalar.addf %sum_p3, %sum_p7 : f32
    %sum_even = scalar.addf %sum_pair0, %sum_pair2 : f32
    %sum_odd = scalar.addf %sum_pair1, %sum_pair3 : f32
    %ordered = scalar.addf %sum_even, %sum_odd : f32
    scf.yield %ordered : f32
  } else {
    %native = kernel.workgroup.reduce<addf> %value : f32
    scf.yield %native : f32
  }
  template.return %total : f32
}

// Shared f16 preparation finish: narrowing or Hadamard, scale and packing.
// Views are reconstructed inside the template to preserve scalar shape specialization.
template.decl @h3.prepare_finish_f16(%chunks_per_lane: index, %lanes: index, %lane: index, %width_last: index, %out_last: index, %lds: buffer, %width: index, %q_global: buffer, %tokens_b: index, %out_stride: index, %row: index)

template.def<@h3.prepare_finish_f16> @h3_prepare_finish_f16(%chunks_per_lane: index, %lanes: index, %lane: index, %width_last: index, %out_last: index, %lds: buffer, %width: index, %q_global: buffer, %tokens_b: index, %out_stride: index, %row: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c0_offset = index.constant 0 : offset
  %x_view = buffer.view %lds[%c0_offset] : buffer -> view<[%width]xf32>
  %o_view = buffer.view %q_global[%c0_offset] : buffer -> view<[%tokens_b]x[%out_stride]xf16>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  // the row as formed, narrowed to f16: no rotation, no scale (8 elements per lane per step)
  scf.for %q_j = [%c0 to %chunks_per_lane step %c1] {
    %q_lane_step = index.mul %q_j, %lanes : index
    %q_chunk = index.add %q_lane_step, %lane : index
    %q_i0 = index.mul %q_chunk, %c8 : index
    %q_i = index.assume %q_i0 [le(%q_i0, %width_last), mul(%q_i0, 8)] : index
    %q_o = index.assume %q_i [le(%q_i, %out_last), mul(%q_i, 8)] : index
    %q_x = vector.load %x_view[%q_i] : view<[%width]xf32> -> vector<8xf32>
    %q_h = vector.fptrunc %q_x : vector<8xf32> to vector<8xf16>
    vector.store %q_h, %o_view[%row, %q_o] : vector<8xf16>, view<[%tokens_b]x[%out_stride]xf16>
  }
  template.return
}

// GEMM input preparation (plain), one workgroup of `lanes` lanes per token: form the
// row in f32 in LDS and write it narrowed to f16, unrotated and unscaled -- the operand the f16 GEMM consumes
// against the checkpoint's unrotated f16 rows (no Hadamard: the rotation only serves quantisation).
//
amdgpu.target<gfx11-generic> @h3_prepare_plain_f16_gfx11 {subgroup_size = 32}

config.decl @h3.prepare_plain_f16.width : %value: index where [range(%value, 256, 32768), mul(%value, 256)]

config.decl @h3.prepare_plain_f16.lanes : %value: index where [range(%value, 32, 1024), mul(%value, 32)]

config.decl @h3.prepare_plain_f16.out_stride : %value: index where [range(%value, 256, 65536), mul(%value, 64)]

kernel.def target(@h3_prepare_plain_f16_gfx11) export("h3_prepare_plain_f16") @h3_prepare_plain_f16(%tokens: index) {
  %c1 = index.constant 1 : index
  %lanes = config.get @h3.prepare_plain_f16.lanes : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%lanes, %c1, %c1) : index
} launch(%tokens: index, %h: buffer, %q: buffer) {
  %width = config.get @h3.prepare_plain_f16.width : index
  %lanes = config.get @h3.prepare_plain_f16.lanes : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %one = scalar.constant 1.0 : f32
  %zero = scalar.constant 0.0 : f32
  %seven = scalar.constant 7.0 : f32
  %neg_seven = scalar.constant -7.0 : f32
  %sixteenth = scalar.constant 0.0625 : f32
  %prescale = scalar.constant 1.0 : f32
  %prescale8 = vector.splat %prescale : vector<8xf32>
  %tiny = scalar.constant 1.0000000000000001e-30 : f32
  %fifteen = scalar.constant 15 : i32
  %sh4 = scalar.constant 4 : i32
  %sh8 = scalar.constant 8 : i32
  %sh12 = scalar.constant 12 : i32
  %sh16 = scalar.constant 16 : i32
  %sh20 = scalar.constant 20 : i32
  %sh24 = scalar.constant 24 : i32
  %sh28 = scalar.constant 28 : i32
  %zero8 = vector.splat %zero : vector<8xf32>
  %one8 = vector.splat %one : vector<8xf32>
  %seven8 = vector.splat %seven : vector<8xf32>
  %neg_seven8 = vector.splat %neg_seven : vector<8xf32>
  %fifteen8 = vector.splat %fifteen : vector<8xi32>
  %qmax = scalar.constant 127.0 : f32
  %neg_qmax = scalar.constant -127.0 : f32
  %qmax8 = vector.splat %qmax : vector<8xf32>
  %neg_qmax8 = vector.splat %neg_qmax : vector<8xf32>
  %mask = scalar.constant 255 : i32
  %mask8 = vector.splat %mask : vector<8xi32>
  %tokens_b = index.assume %tokens [range(%tokens, 1, 1048576)] : index
  %token = kernel.workgroup.id<x> : index
  %row = index.assume %token [lt(%token, %tokens_b)] : index
  %lane = kernel.workitem.id<x> : index
  %half_width = index.div %width, %c2 : index
  %word_width = index.div %width, %c4 : index
  // the quantised rows' pitch: the GEMM's padded k_stride (>= width)
  %out_stride = config.get @h3.prepare_plain_f16.out_stride : index
  %out_words = index.div %out_stride, %c4 : index
  %word_last = index.sub %word_width, %c2 : index
  %out_wlast = index.sub %out_words, %c2 : index
  %width_last = index.sub %width, %c8 : index
  %quads = index.div %width, %c4 : index
  %width_per_lane = index.div %width, %lanes : index
  %quads_per_lane = index.div %quads, %lanes : index
  %chunk_count = index.div %width, %c8 : index
  %chunks_per_lane = index.div %chunk_count, %lanes : index
  %h_global = buffer.assume.memory_space<global> %h : buffer
  %h_view = buffer.view %h_global[%c0_offset] : buffer -> view<[%tokens_b]x[%width]xf16>
  %q_global = buffer.assume.memory_space<global> %q : buffer
  %o_view = buffer.view %q_global[%c0_offset] : buffer -> view<[%tokens_b]x[%out_stride]xf16>
  %out_last = index.sub %out_stride, %c8 : index
  %row_bytes0 = index.mul %width, %c4 : index
  %row_bytes = index.cast %row_bytes0 : index to offset
  %lds = buffer.alloca<workgroup> align(16) %row_bytes : buffer
  %x_view = buffer.view %lds[%c0_offset] : buffer -> view<[%width]xf32>

  // the row as produced (the gate|up GEMM's fused silu(g)*u output)
  scf.for %m_j = [%c0 to %chunks_per_lane step %c1] {
    %m_lane_step = index.mul %m_j, %lanes : index
    %m_chunk = index.add %m_lane_step, %lane : index
    %m_i0 = index.mul %m_chunk, %c8 : index
    %m_i = index.assume %m_i0 [le(%m_i0, %width_last), mul(%m_i0, 8)] : index
    %m_v16 = vector.load %h_view[%row, %m_i] : view<[%tokens_b]x[%width]xf16> -> vector<8xf16>
    %m_out0 = vector.extf %m_v16 : vector<8xf16> to vector<8xf32>
    %m_out = vector.mulf %m_out0, %prescale8 : vector<8xf32>
    vector.store %m_out, %x_view[%m_i] : vector<8xf32>, view<[%width]xf32>
  }
  template.apply<@h3.prepare_finish_f16>(%chunks_per_lane, %lanes, %lane, %width_last, %out_last, %lds, %width, %q_global, %tokens_b, %out_stride, %row) : (index, index, index, index, index, buffer, index, buffer, index, index, index)
  kernel.return
}

// GEMM input preparation (norm), one workgroup of `lanes` lanes per token: form the
// row in f32 in LDS and write it narrowed to f16, unrotated and unscaled -- the operand the f16 GEMM consumes
// against the checkpoint's unrotated f16 rows (no Hadamard: the rotation only serves quantisation).
//
amdgpu.target<gfx11-generic> @h3_prepare_norm_f16_gfx11 {subgroup_size = 32}

config.decl @h3.prepare_norm_f16.width : %value: index where [range(%value, 256, 32768), mul(%value, 256)]

config.decl @h3.prepare_norm_f16.lanes : %value: index where [range(%value, 32, 1024), mul(%value, 32)]

config.decl @h3.prepare_norm_f16.out_stride : %value: index where [range(%value, 256, 65536), mul(%value, 64)]

config.decl @h3.prepare_norm_f16.eps : f32

config.decl @h3.prepare_norm_f16.classes : %value: index where [range(%value, 1, 64)]

kernel.def target(@h3_prepare_norm_f16_gfx11) export("h3_prepare_norm_f16") @h3_prepare_norm_f16(%tokens: index) {
  %c1 = index.constant 1 : index
  %lanes = config.get @h3.prepare_norm_f16.lanes : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%lanes, %c1, %c1) : index
} launch(%tokens: index, %h: buffer, %norm_weight: buffer, %table: buffer, %cls: buffer, %q: buffer) {
  %width = config.get @h3.prepare_norm_f16.width : index
  %lanes = config.get @h3.prepare_norm_f16.lanes : index
  %eps = config.get @h3.prepare_norm_f16.eps : f32
  %classes = config.get @h3.prepare_norm_f16.classes : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %one = scalar.constant 1.0 : f32
  %zero = scalar.constant 0.0 : f32
  %seven = scalar.constant 7.0 : f32
  %neg_seven = scalar.constant -7.0 : f32
  %sixteenth = scalar.constant 0.0625 : f32
  %prescale = scalar.constant 1.0 : f32
  %prescale8 = vector.splat %prescale : vector<8xf32>
  %tiny = scalar.constant 1.0000000000000001e-30 : f32
  %fifteen = scalar.constant 15 : i32
  %sh4 = scalar.constant 4 : i32
  %sh8 = scalar.constant 8 : i32
  %sh12 = scalar.constant 12 : i32
  %sh16 = scalar.constant 16 : i32
  %sh20 = scalar.constant 20 : i32
  %sh24 = scalar.constant 24 : i32
  %sh28 = scalar.constant 28 : i32
  %zero8 = vector.splat %zero : vector<8xf32>
  %one8 = vector.splat %one : vector<8xf32>
  %seven8 = vector.splat %seven : vector<8xf32>
  %neg_seven8 = vector.splat %neg_seven : vector<8xf32>
  %fifteen8 = vector.splat %fifteen : vector<8xi32>
  %qmax = scalar.constant 127.0 : f32
  %neg_qmax = scalar.constant -127.0 : f32
  %qmax8 = vector.splat %qmax : vector<8xf32>
  %neg_qmax8 = vector.splat %neg_qmax : vector<8xf32>
  %mask = scalar.constant 255 : i32
  %mask8 = vector.splat %mask : vector<8xi32>
  %tokens_b = index.assume %tokens [range(%tokens, 1, 1048576)] : index
  %token = kernel.workgroup.id<x> : index
  %row = index.assume %token [lt(%token, %tokens_b)] : index
  %lane = kernel.workitem.id<x> : index
  %half_width = index.div %width, %c2 : index
  %word_width = index.div %width, %c4 : index
  // the quantised rows' pitch: the GEMM's padded k_stride (>= width)
  %out_stride = config.get @h3.prepare_norm_f16.out_stride : index
  %out_words = index.div %out_stride, %c4 : index
  %word_last = index.sub %word_width, %c2 : index
  %out_wlast = index.sub %out_words, %c2 : index
  %width_last = index.sub %width, %c8 : index
  %quads = index.div %width, %c4 : index
  %width_per_lane = index.div %width, %lanes : index
  %quads_per_lane = index.div %quads, %lanes : index
  %chunk_count = index.div %width, %c8 : index
  %chunks_per_lane = index.div %chunk_count, %lanes : index
  %h_global = buffer.assume.memory_space<global> %h : buffer
  %nw_global = buffer.assume.memory_space<global> %norm_weight : buffer
  %tab_global = buffer.assume.memory_space<global> %table : buffer
  %cls_global = buffer.assume.memory_space<global> %cls : buffer
  // the residual stream is f32: H3's grows past f16's range by block 23
  %h_view = buffer.view %h_global[%c0_offset] : buffer -> view<[%tokens_b]x[%width]xf32>
  %nw_view = buffer.view %nw_global[%c0_offset] : buffer -> view<[%width]xf32>
  // the AdaLN table: rows 2*class (scale) and 2*class + 1 (shift), classes = (timestep, modality) pairs
  %table_rows = index.mul %classes, %c2 : index
  %tab_view = buffer.view %tab_global[%c0_offset] : buffer -> view<[%table_rows]x[%width]xf32>
  %cls_view = buffer.view %cls_global[%c0_offset] : buffer -> view<[%tokens_b]xi32>
  %cls_i32 = view.load %cls_view[%row] : view<[%tokens_b]xi32> -> i32
  %cls_idx0 = index.cast %cls_i32 : i32 to index
  %cls_idx = index.assume %cls_idx0 [range(%cls_idx0, 0, 63), lt(%cls_idx0, %classes)] : index
  %scale_row0 = index.mul %cls_idx, %c2 : index
  %scale_row = index.assume %scale_row0 [range(%scale_row0, 0, 126), lt(%scale_row0, %table_rows)] : index
  %shift_row0 = index.add %scale_row, %c1 : index
  %shift_row = index.assume %shift_row0 [range(%shift_row0, 1, 127), lt(%shift_row0, %table_rows)] : index
  %q_global = buffer.assume.memory_space<global> %q : buffer
  %o_view = buffer.view %q_global[%c0_offset] : buffer -> view<[%tokens_b]x[%out_stride]xf16>
  %out_last = index.sub %out_stride, %c8 : index
  %row_bytes0 = index.mul %width, %c4 : index
  %row_bytes = index.cast %row_bytes0 : index to offset
  %lds = buffer.alloca<workgroup> align(16) %row_bytes : buffer
  %x_view = buffer.view %lds[%c0_offset] : buffer -> view<[%width]xf32>

  // sum of squares, then normalise, scale and modulate into LDS
  %ss_v = scf.for %ss_j = [%c0 to %chunks_per_lane step %c1](%ss_acc = %zero8 : vector<8xf32>) -> (vector<8xf32>) {
    %ss_lane_step = index.mul %ss_j, %lanes : index
    %ss_chunk = index.add %ss_lane_step, %lane : index
    %ss_i0 = index.mul %ss_chunk, %c8 : index
    %ss_i = index.assume %ss_i0 [le(%ss_i0, %width_last), mul(%ss_i0, 8)] : index
    %ss_x = vector.load %h_view[%row, %ss_i] : view<[%tokens_b]x[%width]xf32> -> vector<8xf32>
    %ss_sq = vector.mulf %ss_x, %ss_x : vector<8xf32>
    %ss_next = vector.addf %ss_acc, %ss_sq : vector<8xf32>
    scf.yield %ss_next : vector<8xf32>
  }
  %ss = vector.reduce<addf> %ss_v, %zero : vector<8xf32>, f32
  %total = template.apply<@h3.prepare_sum_f16>(%ss, %lanes) : (f32, index) -> (f32)
  %width_i = index.cast %width : index to i32
  %width_f = scalar.sitofp %width_i : i32 to f32
  %mean = scalar.divf %total, %width_f : f32
  %mean_eps = scalar.addf %mean, %eps : f32
  %rms_inv = scalar.rsqrtf %mean_eps : f32
  %rms_inv8 = vector.splat %rms_inv : vector<8xf32>
  scf.for %m_j = [%c0 to %chunks_per_lane step %c1] {
    %m_lane_step = index.mul %m_j, %lanes : index
    %m_chunk = index.add %m_lane_step, %lane : index
    %m_i0 = index.mul %m_chunk, %c8 : index
    %m_i = index.assume %m_i0 [le(%m_i0, %width_last), mul(%m_i0, 8)] : index
    %m_x = vector.load %h_view[%row, %m_i] : view<[%tokens_b]x[%width]xf32> -> vector<8xf32>
    %m_n = vector.mulf %m_x, %rms_inv8 : vector<8xf32>
    %m_nw = vector.load %nw_view[%m_i] : view<[%width]xf32> -> vector<8xf32>
    %m_normed = vector.mulf %m_n, %m_nw : vector<8xf32>
    %m_ms = vector.load %tab_view[%scale_row, %m_i] : view<[%table_rows]x[%width]xf32> -> vector<8xf32>
    %m_ms1 = vector.addf %m_ms, %one8 : vector<8xf32>
    %m_sh = vector.load %tab_view[%shift_row, %m_i] : view<[%table_rows]x[%width]xf32> -> vector<8xf32>
    %m_scaled = vector.mulf %m_normed, %m_ms1 : vector<8xf32>
    %m_out = vector.addf %m_scaled, %m_sh : vector<8xf32>
    vector.store %m_out, %x_view[%m_i] : vector<8xf32>, view<[%width]xf32>
  }
  template.apply<@h3.prepare_finish_f16>(%chunks_per_lane, %lanes, %lane, %width_last, %out_last, %lds, %width, %q_global, %tokens_b, %out_stride, %row) : (index, index, index, index, index, buffer, index, buffer, index, index, index)
  kernel.return
}

