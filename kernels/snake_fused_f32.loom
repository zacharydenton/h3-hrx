    %q64_phase = index.rem %q64_t_plus, %c2 : index
    %q64_first = index.div %q64_t_plus, %c2 : index
    %q64_r0 = index.constant 0 : index
    %q64_tapstep0 = index.constant 0 : index
    %q64_tapraw0 = index.add %q64_phase, %q64_tapstep0 : index
    %q64_tap0 = index.assume %q64_tapraw0 [lt(%q64_tapraw0, %c12)] : index
    %q64_j0 = index.sub %q64_first, %q64_r0 : index
    %q64_low0 = index.cmp ult, %q64_j0, %c5 : index
    %q64_j5_0 = index.sub %q64_j0, %c5 : index
    %q64_src0_0 = scf.select %q64_low0, %c0, %q64_j5_0 : index
    %q64_high0 = index.cmp ugt, %q64_src0_0, %len_last : index
    %q64_src1_0 = scf.select %q64_high0, %len_last, %q64_src0_0 : index
    %q64_src0 = index.assume %q64_src1_0 [range(%q64_src1_0, 0, 4194304), lt(%q64_src1_0, %len_b)] : index
    %q64_fv0 = view.load %f_view[%q64_tap0] : view<12xf32> -> f32
    %q64_xv0 = view.load %x_view[%ch, %q64_src0] : view<[%channels]x[%len_b]xf32> -> f32
    %q64_r1 = index.constant 1 : index
