    %q64_low = index.cmp ult, %q64_global0, %c5 : index
    %q64_global1 = index.sub %q64_global0, %c5 : index
    %q64_global2 = scf.select %q64_low, %c0, %q64_global1 : index
    %q64_high = index.cmp ugt, %q64_global2, %olen_last : index
    %q64_global3 = scf.select %q64_high, %olen_last, %q64_global2 : index
    %q64_mm = index.assume %q64_global3 [lt(%q64_global3, %olen)] : index
    %q64_t_plus = index.add %q64_mm, %c15 : index
