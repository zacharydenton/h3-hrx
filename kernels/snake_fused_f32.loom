// BigVGAN anti-aliased SnakeBeta, generated by scripts/generate_snake_fused.py.
// Each 64-lane group produces 64 samples from 138 upsampled values in LDS.
// Clamp the downsample index before evaluating its upsample/Snake value, then
// clamp each original input tap. Keep six ascending FIR FMAs, factor2 and the
// original Snake operations, round through FP32 LDS, then twelve ascending FMAs.
// All lanes reach the barrier, including short/partial tiles. No global temporary.
// x [C][len] -> out [C][len]; bindings must be disjoint.
amdgpu.target<gfx11-generic> @h3_snake_fused_f32_gfx11 {subgroup_size = 32}
config.decl @h3.snake_fused_f32.channels : %value: index where [range(%value, 1, 4096)]
config.decl @h3.snake_fused_f32.len_bound : %value: index where [range(%value, 256, 4194304), mul(%value, 256)]
kernel.def target(@h3_snake_fused_f32_gfx11) export("h3_snake_fused_f32") @h3_snake_fused_f32(%len: index) {
  %c1 = index.constant 1 : index
  %span = index.constant 64 : index
  %tail = index.constant 63 : index
  %threads = index.constant 64 : index
  %channels = config.get @h3.snake_fused_f32.channels : index
  %rounded = index.add %len, %tail : index
  %groups = index.div %rounded, %span : index
  kernel.launch.config workgroups(%groups, %channels, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%len: index, %x: buffer, %fir: buffer, %alpha: buffer, %beta: buffer, %out: buffer) {
  %channels = config.get @h3.snake_fused_f32.channels : index
  %len_bound = config.get @h3.snake_fused_f32.len_bound : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c5 = index.constant 5 : index
  %c12 = index.constant 12 : index
  %c15 = index.constant 15 : index
  %span = index.constant 64 : index
  %shared_count = index.constant 138 : index
  %shared_bytes = index.constant 552 : offset
  %c0_offset = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %two = scalar.constant 2.0 : f32
  %len_b = index.assume %len [range(%len, 1, 4194304), le(%len, %len_bound)] : index
  %olen = index.mul %len_b, %c2 : index
  %olen_last = index.sub %olen, %c1 : index
  %len_last = index.sub %len_b, %c1 : index
  %wg = kernel.workgroup.id<x> : index
  %c_0 = kernel.workgroup.id<y> : index
  %ch = index.assume %c_0 [lt(%c_0, %channels)] : index
  %lane = kernel.workitem.id<x> : index
  %base = index.mul %wg, %span : index
  %base2 = index.mul %base, %c2 : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %f_global = buffer.assume.memory_space<global> %fir : buffer
  %a_global = buffer.assume.memory_space<global> %alpha : buffer
  %b_global = buffer.assume.memory_space<global> %beta : buffer
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %x_view = buffer.view %x_global[%c0_offset] : buffer -> view<[%channels]x[%len_b]xf32>
  %f_view = buffer.view %f_global[%c0_offset] : buffer -> view<12xf32>
  %a_view = buffer.view %a_global[%c0_offset] : buffer -> view<[%channels]xf32>
  %b_view = buffer.view %b_global[%c0_offset] : buffer -> view<[%channels]xf32>
  %out_view = buffer.view %out_global[%c0_offset] : buffer -> view<[%channels]x[%len_b]xf32>
  %lds = buffer.alloca<workgroup> align(16) %shared_bytes : buffer
  %lds_view = buffer.view %lds[%c0_offset] : buffer -> view<138xf32>
  %q0_offset = index.constant 0 : index
  %q0_qraw = index.add %lane, %q0_offset : index
  %q0_active = index.cmp ult, %q0_qraw, %shared_count : index
  scf.if %q0_active {
    %q0_slot = index.assume %q0_qraw [lt(%q0_qraw, %shared_count)] : index
    %q0_global0 = index.add %base2, %q0_slot : index
    %q0_low = index.cmp ult, %q0_global0, %c5 : index
    %q0_global1 = index.sub %q0_global0, %c5 : index
    %q0_global2 = scf.select %q0_low, %c0, %q0_global1 : index
    %q0_high = index.cmp ugt, %q0_global2, %olen_last : index
    %q0_global3 = scf.select %q0_high, %olen_last, %q0_global2 : index
    %q0_mm = index.assume %q0_global3 [lt(%q0_global3, %olen)] : index
    %q0_t_plus = index.add %q0_mm, %c15 : index
    // Only taps with k == (m + 15) mod 2 contribute. For active m,
    // m + 15 - k >= 4 and j < len + 10, so the other old tap predicates
    // are always true. Load these six taps ahead, then preserve their
    // ascending FP32 FMA order and the final factor-of-two rounding.
    %q0_phase = index.rem %q0_t_plus, %c2 : index
    %q0_first = index.div %q0_t_plus, %c2 : index
    %q0_r0 = index.constant 0 : index
    %q0_tapstep0 = index.constant 0 : index
    %q0_tapraw0 = index.add %q0_phase, %q0_tapstep0 : index
    %q0_tap0 = index.assume %q0_tapraw0 [lt(%q0_tapraw0, %c12)] : index
    %q0_j0 = index.sub %q0_first, %q0_r0 : index
    %q0_low0 = index.cmp ult, %q0_j0, %c5 : index
    %q0_j5_0 = index.sub %q0_j0, %c5 : index
    %q0_src0_0 = scf.select %q0_low0, %c0, %q0_j5_0 : index
    %q0_high0 = index.cmp ugt, %q0_src0_0, %len_last : index
    %q0_src1_0 = scf.select %q0_high0, %len_last, %q0_src0_0 : index
    %q0_src0 = index.assume %q0_src1_0 [range(%q0_src1_0, 0, 4194304), lt(%q0_src1_0, %len_b)] : index
    %q0_fv0 = view.load %f_view[%q0_tap0] : view<12xf32> -> f32
    %q0_xv0 = view.load %x_view[%ch, %q0_src0] : view<[%channels]x[%len_b]xf32> -> f32
    %q0_r1 = index.constant 1 : index
    %q0_tapstep1 = index.constant 2 : index
    %q0_tapraw1 = index.add %q0_phase, %q0_tapstep1 : index
    %q0_tap1 = index.assume %q0_tapraw1 [lt(%q0_tapraw1, %c12)] : index
    %q0_j1 = index.sub %q0_first, %q0_r1 : index
    %q0_low1 = index.cmp ult, %q0_j1, %c5 : index
    %q0_j5_1 = index.sub %q0_j1, %c5 : index
    %q0_src0_1 = scf.select %q0_low1, %c0, %q0_j5_1 : index
    %q0_high1 = index.cmp ugt, %q0_src0_1, %len_last : index
    %q0_src1_1 = scf.select %q0_high1, %len_last, %q0_src0_1 : index
    %q0_src1 = index.assume %q0_src1_1 [range(%q0_src1_1, 0, 4194304), lt(%q0_src1_1, %len_b)] : index
    %q0_fv1 = view.load %f_view[%q0_tap1] : view<12xf32> -> f32
    %q0_xv1 = view.load %x_view[%ch, %q0_src1] : view<[%channels]x[%len_b]xf32> -> f32
    %q0_r2 = index.constant 2 : index
    %q0_tapstep2 = index.constant 4 : index
    %q0_tapraw2 = index.add %q0_phase, %q0_tapstep2 : index
    %q0_tap2 = index.assume %q0_tapraw2 [lt(%q0_tapraw2, %c12)] : index
    %q0_j2 = index.sub %q0_first, %q0_r2 : index
    %q0_low2 = index.cmp ult, %q0_j2, %c5 : index
    %q0_j5_2 = index.sub %q0_j2, %c5 : index
    %q0_src0_2 = scf.select %q0_low2, %c0, %q0_j5_2 : index
    %q0_high2 = index.cmp ugt, %q0_src0_2, %len_last : index
    %q0_src1_2 = scf.select %q0_high2, %len_last, %q0_src0_2 : index
    %q0_src2 = index.assume %q0_src1_2 [range(%q0_src1_2, 0, 4194304), lt(%q0_src1_2, %len_b)] : index
    %q0_fv2 = view.load %f_view[%q0_tap2] : view<12xf32> -> f32
    %q0_xv2 = view.load %x_view[%ch, %q0_src2] : view<[%channels]x[%len_b]xf32> -> f32
    %q0_r3 = index.constant 3 : index
    %q0_tapstep3 = index.constant 6 : index
    %q0_tapraw3 = index.add %q0_phase, %q0_tapstep3 : index
    %q0_tap3 = index.assume %q0_tapraw3 [lt(%q0_tapraw3, %c12)] : index
    %q0_j3 = index.sub %q0_first, %q0_r3 : index
    %q0_low3 = index.cmp ult, %q0_j3, %c5 : index
    %q0_j5_3 = index.sub %q0_j3, %c5 : index
    %q0_src0_3 = scf.select %q0_low3, %c0, %q0_j5_3 : index
    %q0_high3 = index.cmp ugt, %q0_src0_3, %len_last : index
    %q0_src1_3 = scf.select %q0_high3, %len_last, %q0_src0_3 : index
    %q0_src3 = index.assume %q0_src1_3 [range(%q0_src1_3, 0, 4194304), lt(%q0_src1_3, %len_b)] : index
    %q0_fv3 = view.load %f_view[%q0_tap3] : view<12xf32> -> f32
    %q0_xv3 = view.load %x_view[%ch, %q0_src3] : view<[%channels]x[%len_b]xf32> -> f32
    %q0_r4 = index.constant 4 : index
    %q0_tapstep4 = index.constant 8 : index
    %q0_tapraw4 = index.add %q0_phase, %q0_tapstep4 : index
    %q0_tap4 = index.assume %q0_tapraw4 [lt(%q0_tapraw4, %c12)] : index
    %q0_j4 = index.sub %q0_first, %q0_r4 : index
    %q0_low4 = index.cmp ult, %q0_j4, %c5 : index
    %q0_j5_4 = index.sub %q0_j4, %c5 : index
    %q0_src0_4 = scf.select %q0_low4, %c0, %q0_j5_4 : index
    %q0_high4 = index.cmp ugt, %q0_src0_4, %len_last : index
    %q0_src1_4 = scf.select %q0_high4, %len_last, %q0_src0_4 : index
    %q0_src4 = index.assume %q0_src1_4 [range(%q0_src1_4, 0, 4194304), lt(%q0_src1_4, %len_b)] : index
    %q0_fv4 = view.load %f_view[%q0_tap4] : view<12xf32> -> f32
    %q0_xv4 = view.load %x_view[%ch, %q0_src4] : view<[%channels]x[%len_b]xf32> -> f32
    %q0_r5 = index.constant 5 : index
    %q0_tapstep5 = index.constant 10 : index
    %q0_tapraw5 = index.add %q0_phase, %q0_tapstep5 : index
    %q0_tap5 = index.assume %q0_tapraw5 [lt(%q0_tapraw5, %c12)] : index
    %q0_j5 = index.sub %q0_first, %q0_r5 : index
    %q0_low5 = index.cmp ult, %q0_j5, %c5 : index
    %q0_j5_5 = index.sub %q0_j5, %c5 : index
    %q0_src0_5 = scf.select %q0_low5, %c0, %q0_j5_5 : index
    %q0_high5 = index.cmp ugt, %q0_src0_5, %len_last : index
    %q0_src1_5 = scf.select %q0_high5, %len_last, %q0_src0_5 : index
    %q0_src5 = index.assume %q0_src1_5 [range(%q0_src1_5, 0, 4194304), lt(%q0_src1_5, %len_b)] : index
    %q0_fv5 = view.load %f_view[%q0_tap5] : view<12xf32> -> f32
    %q0_xv5 = view.load %x_view[%ch, %q0_src5] : view<[%channels]x[%len_b]xf32> -> f32
    %q0_acc0 = scalar.fmaf %q0_fv0, %q0_xv0, %zero : f32
    %q0_acc1 = scalar.fmaf %q0_fv1, %q0_xv1, %q0_acc0 : f32
    %q0_acc2 = scalar.fmaf %q0_fv2, %q0_xv2, %q0_acc1 : f32
    %q0_acc3 = scalar.fmaf %q0_fv3, %q0_xv3, %q0_acc2 : f32
    %q0_acc4 = scalar.fmaf %q0_fv4, %q0_xv4, %q0_acc3 : f32
    %q0_acc = scalar.fmaf %q0_fv5, %q0_xv5, %q0_acc4 : f32
    %q0_u = scalar.mulf %q0_acc, %two : f32
    %q0_al = view.load %a_view[%ch] : view<[%channels]xf32> -> f32
    %q0_be = view.load %b_view[%ch] : view<[%channels]xf32> -> f32
    %q0_arg = scalar.mulf %q0_al, %q0_u : f32
    %q0_s = scalar.sinf<afn> %q0_arg : f32
    %q0_s2 = scalar.mulf %q0_s, %q0_s : f32
    %q0_q = scalar.divf %q0_s2, %q0_be : f32
