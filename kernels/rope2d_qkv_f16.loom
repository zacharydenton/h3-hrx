// Rotate Q/K pairs in FP32 and pack padded FP16 Q, K, V rows. Each lane
// handles both halves of a pair, sharing the inputs and rotary coefficients.
amdgpu.target<gfx11-generic> @h3_rope2d_qkv_f16_gfx11 {subgroup_size = 32}

config.decl @h3.rope2d_qkv_f16.heads : %value: index where [range(%value, 1, 64)]
config.decl @h3.rope2d_qkv_f16.hd : %value: index where [range(%value, 2, 256), mul(%value, 2)]
config.decl @h3.rope2d_qkv_f16.hd_pad : %value: index where [range(%value, 32, 256), mul(%value, 32)]

kernel.def target(@h3_rope2d_qkv_f16_gfx11) export("h3_rope2d_qkv_f16") @h3_rope2d_qkv_f16(%tokens: index) {
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %zero = index.constant 0 : index
  %threads = index.constant 256 : index
  %round = index.constant 255 : index
  %heads = config.get @h3.rope2d_qkv_f16.heads : index
  %hd = config.get @h3.rope2d_qkv_f16.hd : index
  %hd_pad = config.get @h3.rope2d_qkv_f16.hd_pad : index
  %valid_hd = index.assume %hd [le(%hd, %hd_pad)] : index
  %half = index.div %valid_hd, %two : index
  %rem = index.rem %half, %four : index
  %wide = index.cmp eq, %rem, %zero : index
  %lanes = scf.select %wide, %four, %one : index
  %span = index.mul %lanes, %two : index
  %pairs = index.div %hd_pad, %span : index
  %rows = index.mul %tokens, %heads : index
  %count = index.mul %rows, %pairs : index
  %rounded = index.add %count, %round : index
  %groups = index.div %rounded, %threads : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%tokens: index, %qkv: buffer, %cos: buffer, %sin: buffer, %q: buffer, %k: buffer, %v: buffer) {
  %heads = config.get @h3.rope2d_qkv_f16.heads : index
  %hd = config.get @h3.rope2d_qkv_f16.hd : index
  %hd_pad = config.get @h3.rope2d_qkv_f16.hd_pad : index
  %valid_hd = index.assume %hd [le(%hd, %hd_pad)] : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %threads = index.constant 256 : index
  %offset = index.constant 0 : offset
  %tokens_b = index.assume %tokens [range(%tokens, 1, 65536)] : index
  %half = index.div %valid_hd, %two : index
  %rem = index.rem %half, %four : index
  %wide = index.cmp eq, %rem, %zero : index
  %lanes = scf.select %wide, %four, %one : index
  %span = index.mul %lanes, %two : index
  %pairs = index.div %hd_pad, %span : index
  %rows = index.mul %tokens_b, %heads : index
  %count = index.mul %rows, %pairs : index
  %wg = kernel.workgroup.id<x> : index
  %wi = kernel.workitem.id<x> : index
  %base = index.mul %wg, %threads : index
  %i = index.add %base, %wi : index
  %inner = index.mul %heads, %hd : index
  %width = index.mul %inner, %three : index
  %out_w = index.mul %heads, %hd_pad : index
  %qkv_global = buffer.assume.memory_space<global> %qkv : buffer
  %cos_global = buffer.assume.memory_space<global> %cos : buffer
  %sin_global = buffer.assume.memory_space<global> %sin : buffer
  %q_global = buffer.assume.memory_space<global> %q : buffer
  %k_global = buffer.assume.memory_space<global> %k : buffer
  %v_global = buffer.assume.memory_space<global> %v : buffer
  %qkv_view = buffer.view %qkv_global[%offset] : buffer -> view<[%tokens_b]x[%width]xf32>
  %cos_view = buffer.view %cos_global[%offset] : buffer -> view<[%tokens_b]x[%half]xf32>
  %sin_view = buffer.view %sin_global[%offset] : buffer -> view<[%tokens_b]x[%half]xf32>
  %q_view = buffer.view %q_global[%offset] : buffer -> view<[%tokens_b]x[%out_w]xf16>
  %k_view = buffer.view %k_global[%offset] : buffer -> view<[%tokens_b]x[%out_w]xf16>
  %v_view = buffer.view %v_global[%offset] : buffer -> view<[%tokens_b]x[%out_w]xf16>
  %active = index.cmp ult, %i, %count : index
  scf.if %active {
    %head_row = index.div %i, %pairs : index
    %t0 = index.div %head_row, %heads : index
    %t = index.assume %t0 [lt(%t0, %tokens_b)] : index
    %h = index.rem %head_row, %heads : index
    %pair = index.rem %i, %pairs : index
    %d = index.mul %pair, %lanes : index
    %hbase = index.mul %h, %hd : index
    %obase = index.mul %h, %hd_pad : index
    %in_head = index.cmp ult, %d, %half : index
    scf.if %in_head {
      %last_pair = index.sub %half, %lanes : index
      %j = index.assume %d [le(%d, %last_pair)] : index
      %qc0 = index.add %hbase, %j : index
      %qc1 = index.add %qc0, %half : index
      %kc0 = index.add %qc0, %inner : index
      %kc1 = index.add %qc1, %inner : index
      %vc0 = index.add %kc0, %inner : index
      %vc1 = index.add %kc1, %inner : index
      %oc0 = index.add %obase, %j : index
      %oc1 = index.add %oc0, %half : index
      %cv = vector.load %cos_view[%t, %j] : view<[%tokens_b]x[%half]xf32> -> vector<[%lanes]xf32>
      %sv = vector.load %sin_view[%t, %j] : view<[%tokens_b]x[%half]xf32> -> vector<[%lanes]xf32>
      %sneg = vector.negf %sv : vector<[%lanes]xf32>
      %q0 = vector.load %qkv_view[%t, %qc0] : view<[%tokens_b]x[%width]xf32> -> vector<[%lanes]xf32>
      %q1 = vector.load %qkv_view[%t, %qc1] : view<[%tokens_b]x[%width]xf32> -> vector<[%lanes]xf32>
      %k0 = vector.load %qkv_view[%t, %kc0] : view<[%tokens_b]x[%width]xf32> -> vector<[%lanes]xf32>
      %k1 = vector.load %qkv_view[%t, %kc1] : view<[%tokens_b]x[%width]xf32> -> vector<[%lanes]xf32>
      %v0 = vector.load %qkv_view[%t, %vc0] : view<[%tokens_b]x[%width]xf32> -> vector<[%lanes]xf32>
      %v1 = vector.load %qkv_view[%t, %vc1] : view<[%tokens_b]x[%width]xf32> -> vector<[%lanes]xf32>
      %qmul0 = vector.mulf %q0, %cv : vector<[%lanes]xf32>
      %qr0 = vector.fmaf %q1, %sneg, %qmul0 : vector<[%lanes]xf32>
      %qmul1 = vector.mulf %q1, %cv : vector<[%lanes]xf32>
      %qr1 = vector.fmaf %q0, %sv, %qmul1 : vector<[%lanes]xf32>
      %kmul0 = vector.mulf %k0, %cv : vector<[%lanes]xf32>
      %kr0 = vector.fmaf %k1, %sneg, %kmul0 : vector<[%lanes]xf32>
      %kmul1 = vector.mulf %k1, %cv : vector<[%lanes]xf32>
      %kr1 = vector.fmaf %k0, %sv, %kmul1 : vector<[%lanes]xf32>
      %qhalf0 = vector.fptrunc %qr0 : vector<[%lanes]xf32> to vector<[%lanes]xf16>
      vector.store %qhalf0, %q_view[%t, %oc0] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
      %qhalf1 = vector.fptrunc %qr1 : vector<[%lanes]xf32> to vector<[%lanes]xf16>
      vector.store %qhalf1, %q_view[%t, %oc1] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
      %khalf0 = vector.fptrunc %kr0 : vector<[%lanes]xf32> to vector<[%lanes]xf16>
      vector.store %khalf0, %k_view[%t, %oc0] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
      %khalf1 = vector.fptrunc %kr1 : vector<[%lanes]xf32> to vector<[%lanes]xf16>
      vector.store %khalf1, %k_view[%t, %oc1] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
      %vhalf0 = vector.fptrunc %v0 : vector<[%lanes]xf32> to vector<[%lanes]xf16>
      vector.store %vhalf0, %v_view[%t, %oc0] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
      %vhalf1 = vector.fptrunc %v1 : vector<[%lanes]xf32> to vector<[%lanes]xf16>
      vector.store %vhalf1, %v_view[%t, %oc1] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
    } else {
      // The active lanes write [0, hd); the remaining lanes zero [hd, hd_pad).
      %pad0 = index.mul %d, %two : index
      %pc0 = index.add %obase, %pad0 : index
      %pc1 = index.add %pc0, %lanes : index
      %zero16 = scalar.constant 0.0 : f16
      %zeros = vector.splat %zero16 : vector<[%lanes]xf16>
      vector.store %zeros, %q_view[%t, %pc0] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
      vector.store %zeros, %q_view[%t, %pc1] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
      vector.store %zeros, %k_view[%t, %pc0] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
      vector.store %zeros, %k_view[%t, %pc1] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
      vector.store %zeros, %v_view[%t, %pc0] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
      vector.store %zeros, %v_view[%t, %pc1] : vector<[%lanes]xf16>, view<[%tokens_b]x[%out_w]xf16>
    }
  }
  kernel.return
}
