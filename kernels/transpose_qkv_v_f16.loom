// Extract V directly from a fused [rows][3 * width] MHA QKV projection.
// [rows][width] f16 -> [width][row_capacity] f16 through LDS: V^T for attention.
// Use 64x64 tiles when width is divisible by 64, otherwise 32x32. Zero columns past `rows`;
// callers can launch across the complete capacity to clear reused output storage.
// Workgroups (width / tile_size, ceil(rows / tile_size)) of 256 lanes visit adjacent input columns first.
amdgpu.target<gfx11-generic> @h3_transpose_qkv_v_f16_gfx11 {subgroup_size = 32}

config.decl @h3.transpose_qkv_v_f16.width : %value: index where [range(%value, 32, 65536), mul(%value, 32)]

config.decl @h3.transpose_qkv_v_f16.row_capacity : %value: index where [range(%value, 32, 1048576), mul(%value, 32)]

kernel.def target(@h3_transpose_qkv_v_f16_gfx11) export("h3_transpose_qkv_v_f16") @h3_transpose_qkv_v_f16(%rows: index) {
  %c1 = index.constant 1 : index
  %c0 = index.constant 0 : index
  %c64 = index.constant 64 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %width = config.get @h3.transpose_qkv_v_f16.width : index
  %remainder = index.rem %width, %c64 : index
  %wide = index.cmp eq, %remainder, %c0 : index
  %tile_size = scf.select %wide, %c64, %c32 : index
  %tile_less = index.sub %tile_size, %c1 : index
  %rounded = index.add %rows, %tile_less : index
  %row_tiles = index.div %rounded, %tile_size : index
  %col_tiles = index.div %width, %tile_size : index
  kernel.launch.config workgroups(%col_tiles, %row_tiles, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%rows: index, %x: buffer, %out: buffer) {
  %width = config.get @h3.transpose_qkv_v_f16.width : index
  %cap = config.get @h3.transpose_qkv_v_f16.row_capacity : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c0_offset = index.constant 0 : offset
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %remainder = index.rem %width, %c64 : index
  %wide = index.cmp eq, %remainder, %c0 : index
  %tile_size = scf.select %wide, %c64, %c32 : index
  %tile_stride = index.add %tile_size, %c4 : index
  %tile_limit = index.sub %tile_size, %c4 : index
  %lanes_per_row = index.div %tile_size, %c4 : index
  %rows_per_pass = index.div %c256, %lanes_per_row : index
  %passes = index.div %tile_size, %rows_per_pass : index
  %small_bytes = index.constant 2304 : offset
  %wide_bytes = index.constant 8704 : offset
  %lds_bytes = scf.select %wide, %wide_bytes, %small_bytes : offset
  %zero_h = scalar.constant 0.0 : f16
  %zero4 = vector.splat %zero_h : vector<4xf16>
  %rows_b = index.assume %rows [range(%rows, 1, 1048576), le(%rows, %cap)] : index
  %ct = kernel.workgroup.id<x> : index
  %rt = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %row0 = index.mul %rt, %tile_size : index
  %col0a = index.mul %ct, %tile_size : index
  %col_limit = index.sub %width, %tile_size : index
  %col0 = index.assume %col0a [le(%col0a, %col_limit), mul(%col0a, 32)] : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %o_global = buffer.assume.memory_space<global> %out : buffer
  %stride = index.mul %width, %c3 : index
  %voff = index.mul %width, %c2 : index
  %x_view = buffer.view %x_global[%c0_offset] : buffer -> view<[%rows_b]x[%stride]xf16>
  %o_view = buffer.view %o_global[%c0_offset] : buffer -> view<[%width]x[%cap]xf16>
  %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %tile = buffer.view %lds[%c0_offset] : buffer -> view<[%tile_size]x[%tile_stride]xf16>
  // Load vector4 slices across adjacent columns, then advance through row strips.
  %lr_base = index.div %lane, %lanes_per_row : index
  %lc0 = index.rem %lane, %lanes_per_row : index
  %lc = index.mul %lc0, %c4 : index
  %lcb = index.assume %lc [le(%lc, %tile_limit), mul(%lc, 4)] : index
  scf.for %pass = [%c0 to %passes step %c1] unroll {
    %lr_offset = index.mul %pass, %rows_per_pass : index
    %lr = index.add %lr_base, %lr_offset : index
    %grow = index.add %row0, %lr : index
    %in_rows = index.cmp ult, %grow, %rows_b : index
    scf.if %in_rows {
      %grow_b = index.assume %grow [lt(%grow, %rows_b)] : index
      %gcol = index.add %col0, %lcb : index
      %gcol_limit = index.sub %width, %c4 : index
      %gcolb = index.assume %gcol [le(%gcol, %gcol_limit), mul(%gcol, 4)] : index
      %vcol0 = index.add %voff, %gcolb : index
      %vlimit = index.sub %stride, %c4 : index
      %vcol = index.assume %vcol0 [le(%vcol0, %vlimit), mul(%vcol0, 4)] : index
      %v = vector.load %x_view[%grow_b, %vcol] : view<[%rows_b]x[%stride]xf16> -> vector<4xf16>
      vector.store %v, %tile[%lr, %lcb] : vector<4xf16>, view<[%tile_size]x[%tile_stride]xf16>
    } else {
      vector.store %zero4, %tile[%lr, %lcb] : vector<4xf16>, view<[%tile_size]x[%tile_stride]xf16>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  // Exchange row/column roles and publish vector4 slices of the transposed tile.
  scf.for %pass = [%c0 to %passes step %c1] unroll {
    %tc_offset = index.mul %pass, %rows_per_pass : index
    %tc = index.add %lr_base, %tc_offset : index
    %tr = index.mul %lc0, %c4 : index
    %trb = index.assume %tr [le(%tr, %tile_limit), mul(%tr, 4)] : index
    %e0 = view.load %tile[%trb, %tc] : view<[%tile_size]x[%tile_stride]xf16> -> f16
    %tr1 = index.add %trb, %c1 : index
    %tr2 = index.add %trb, %c2 : index
    %tr3 = index.add %trb, %c3 : index
    %e1 = view.load %tile[%tr1, %tc] : view<[%tile_size]x[%tile_stride]xf16> -> f16
    %e2 = view.load %tile[%tr2, %tc] : view<[%tile_size]x[%tile_stride]xf16> -> f16
    %e3 = view.load %tile[%tr3, %tc] : view<[%tile_size]x[%tile_stride]xf16> -> f16
    %ov = vector.from_elements %e0, %e1, %e2, %e3 : vector<4xf16>
    %orow = index.add %col0, %tc : index
    %orow_b = index.assume %orow [lt(%orow, %width)] : index
    %ocol = index.add %row0, %trb : index
    %ocol_limit = index.sub %cap, %c4 : index
    %in_cols = index.cmp ule, %ocol, %ocol_limit : index
    scf.if %in_cols {
      %ocol_b = index.assume %ocol [le(%ocol, %ocol_limit), mul(%ocol, 4)] : index
      vector.store %ov, %o_view[%orow_b, %ocol_b] : vector<4xf16>, view<[%width]x[%cap]xf16>
    }
  }
  kernel.return
}
