// Head size 64 (the VAE decoder): two channels per lane. Per-head RMSNorm (weight w[c]) and rotate-half rotary embedding on q and k read from the
// fused projection buffer [tokens][row_stride] (q at column 0, k at column k_offset, v at
// k_offset + heads*128) and written to contiguous q_out, k_out, v_out [tokens][heads*128],
// the layouts attention's operand loads want. One workgroup of 256 lanes per token handles
// eight heads at a time: a wave per head, four channels per lane, the head's sum of squares
// reduced across the wave.
//   x = h / sqrt(mean(h^2) + eps) * w[c]
//   channels c < 24 pair with c + 24: (x1, x2) -> (x1*cos - x2*sin, x1*sin + x2*cos), cos/sin
//   [tokens][24]; channels 48..63 pass through. The partner quad lives 12 lanes away and comes
//   through a subgroup shuffle.
amdgpu.target<gfx11-generic> @h3_rope64_qknorm_gfx11 {subgroup_size = 32}

config.decl @h3.rope64_qknorm_f16.row_stride : %value: index where [range(%value, 128, 65536), mul(%value, 128)]

config.decl @h3.rope64_qknorm_f16.heads : %value: index where [range(%value, 1, 256)]

config.decl @h3.rope64_qknorm_f16.k_offset : %value: index where [range(%value, 128, 65536), mul(%value, 128)]

config.decl @h3.rope64_qknorm_f16.eps : f32

kernel.def target(@h3_rope64_qknorm_gfx11) export("h3_rope64_qknorm_f16") @h3_rope64_qknorm_f16(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens: index, %qkv: buffer, %q_weight: buffer, %k_weight: buffer, %cos: buffer, %sin: buffer, %q_out: buffer, %k_out: buffer, %v_out: buffer) {
  %row_stride = config.get @h3.rope64_qknorm_f16.row_stride : index
  %heads = config.get @h3.rope64_qknorm_f16.heads : index
  %k_offset = config.get @h3.rope64_qknorm_f16.k_offset : index
  %eps = config.get @h3.rope64_qknorm_f16.eps : f32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c24 = index.constant 24 : index
  %c22 = index.constant 22 : index
  %c64 = index.constant 64 : index
  %c0_offset = index.constant 0 : offset
  %i32_32 = scalar.constant 32 : i32
  %zero_f = scalar.constant 0.0 : f32
  %inv64 = scalar.constant 0.015625 : f32
  %tokens_b = index.assume %tokens [range(%tokens, 1, 1048576)] : index
  %token = kernel.workgroup.id<x> : index
  %row = index.assume %token [lt(%token, %tokens_b)] : index
  %wave0 = kernel.subgroup.id : index
  %wave = index.assume %wave0 [range(%wave0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index
  %lane_col = index.mul %lane, %c2 : index
  %qk_heads = index.add %heads, %heads : index
  %heads_total = index.add %qk_heads, %heads : index
  %rounds0 = index.add %heads_total, %c7 : index
  %rounds = index.div %rounds0, %c8 : index
  %qkv_global = buffer.assume.memory_space<global> %qkv : buffer
  %qo_global = buffer.assume.memory_space<global> %q_out : buffer
  %ko_global = buffer.assume.memory_space<global> %k_out : buffer
  %vo_global = buffer.assume.memory_space<global> %v_out : buffer
  %width = index.mul %heads, %c64 : index
  %qw_global = buffer.assume.memory_space<global> %q_weight : buffer
  %kw_global = buffer.assume.memory_space<global> %k_weight : buffer
  %cos_global = buffer.assume.memory_space<global> %cos : buffer
  %sin_global = buffer.assume.memory_space<global> %sin : buffer
  %qkv_view = buffer.view %qkv_global[%c0_offset] : buffer -> view<[%tokens_b]x[%row_stride]xf16>
  %qo_view = buffer.view %qo_global[%c0_offset] : buffer -> view<[%tokens_b]x[%width]xf16>
  %ko_view = buffer.view %ko_global[%c0_offset] : buffer -> view<[%tokens_b]x[%width]xf16>
  %vo_view = buffer.view %vo_global[%c0_offset] : buffer -> view<[%tokens_b]x[%width]xf16>
  %v_offset = index.add %k_offset, %width : index
  %w_limit = index.sub %width, %c2 : index
  %qw_view = buffer.view %qw_global[%c0_offset] : buffer -> view<64xf32>
  %kw_view = buffer.view %kw_global[%c0_offset] : buffer -> view<64xf32>
  %cos_view = buffer.view %cos_global[%c0_offset] : buffer -> view<[%tokens_b]x24xf32>
  %sin_view = buffer.view %sin_global[%c0_offset] : buffer -> view<[%tokens_b]x24xf32>
  %col_limit = index.sub %row_stride, %c2 : index
  // rotate-half lane classes: 0..11 hold x1 (channels 0..47), 12..23 hold x2 (48..95), 24..31 pass through
  %is_lo = index.cmp ult, %lane, %c12 : index
  %is_pair = index.cmp ult, %lane, %c24 : index
  %up = index.add %lane, %c12 : index
  %down0 = index.sub %lane, %c12 : index
  %down = scf.select %is_pair, %down0, %lane : index
  %partner0 = scf.select %is_lo, %up, %down : index
  %partner1 = index.assume %partner0 [range(%partner0, 0, 31)] : index
  %partner = index.cast %partner1 : index to i32
  %pair_lane0 = scf.select %is_lo, %lane, %c0 : index
  %pair_lane1 = index.sub %lane, %c12 : index
  %pair_lane2 = scf.select %is_lo, %pair_lane0, %pair_lane1 : index
  %pair_lane3 = scf.select %is_pair, %pair_lane2, %c0 : index
  %pair_col0 = index.mul %pair_lane3, %c2 : index
  %pair_col = index.assume %pair_col0 [le(%pair_col0, %c22), mul(%pair_col0, 2)] : index
  scf.for %r = [%c0 to %rounds step %c1] {
    %r8 = index.mul %r, %c8 : index
    %head = index.add %r8, %wave : index
    %active = index.cmp ult, %head, %heads_total : index
    scf.if %active {
      %is_q = index.cmp ult, %head, %heads : index
      %is_v = index.cmp uge, %head, %qk_heads : index
      %k_head0 = index.sub %head, %heads : index
      %k_head1 = scf.select %is_q, %c0, %k_head0 : index
      %k_head = index.assume %k_head1 [range(%k_head1, 0, 255)] : index
      %v_head0 = index.sub %head, %qk_heads : index
      %v_head1 = scf.select %is_v, %v_head0, %c0 : index
      %v_head = index.assume %v_head1 [range(%v_head1, 0, 255)] : index
      %q_base = index.mul %head, %c64 : index
      %k_base0 = index.mul %k_head, %c64 : index
      %k_base = index.add %k_offset, %k_base0 : index
      %base_qk = scf.select %is_q, %q_base, %k_base : index
      %v_base0 = index.mul %v_head, %c64 : index
      %v_base = index.add %v_offset, %v_base0 : index
      %base = scf.select %is_v, %v_base, %base_qk : index
      %col0 = index.add %base, %lane_col : index
      %col = index.assume %col0 [le(%col0, %col_limit), mul(%col0, 2)] : index
      %v16 = vector.load %qkv_view[%row, %col] : view<[%tokens_b]x[%row_stride]xf16> -> vector<2xf16>
      scf.if %is_v {
        %vc0 = index.add %v_base0, %lane_col : index
        %vc = index.assume %vc0 [le(%vc0, %w_limit), mul(%vc0, 2)] : index
        vector.store %v16, %vo_view[%row, %vc] : vector<2xf16>, view<[%tokens_b]x[%width]xf16>
      } else {
        %v = vector.extf %v16 : vector<2xf16> to vector<2xf32>
        %sq = vector.mulf %v, %v : vector<2xf32>
        %lane_ss = vector.reduce<addf> %sq, %zero_f : vector<2xf32>, f32
        %ss = kernel.subgroup.reduce<addf> %lane_ss : f32
        %mean = scalar.mulf %ss, %inv64 : f32
        %mean_eps = scalar.addf %mean, %eps : f32
        %rinv = scalar.rsqrtf %mean_eps : f32
        %rinv_v = vector.splat %rinv : vector<2xf32>
        %normed = vector.mulf %v, %rinv_v : vector<2xf32>
        %w_q = vector.load %qw_view[%lane_col] : view<64xf32> -> vector<2xf32>
        %w_k = vector.load %kw_view[%lane_col] : view<64xf32> -> vector<2xf32>
        %w = scf.if %is_q -> (vector<2xf32>) {
          scf.yield %w_q : vector<2xf32>
        } else {
          scf.yield %w_k : vector<2xf32>
        }
        %x = vector.mulf %normed, %w : vector<2xf32>
        // the partner quad (channel +-48) from 12 lanes away; every lane takes part in the shuffle
        %px, %ok = kernel.subgroup.shuffle<index> %x, %partner, %i32_32 : vector<2xf32>, i32, i32
        %c = vector.load %cos_view[%row, %pair_col] : view<[%tokens_b]x24xf32> -> vector<2xf32>
        %s = vector.load %sin_view[%row, %pair_col] : view<[%tokens_b]x24xf32> -> vector<2xf32>
        // x1' = x1 cos - x2 sin (lanes 0..11 hold x1, partner x2); x2' = x1 sin + x2 cos (lanes 12..23)
        %xc = vector.mulf %x, %c : vector<2xf32>
        %ps = vector.mulf %px, %s : vector<2xf32>
        %lo_out = vector.subf %xc, %ps : vector<2xf32>
        %hi_out = vector.addf %xc, %ps : vector<2xf32>
        %pair_out = scf.if %is_lo -> (vector<2xf32>) {
          scf.yield %lo_out : vector<2xf32>
        } else {
          scf.yield %hi_out : vector<2xf32>
        }
        %out = scf.if %is_pair -> (vector<2xf32>) {
          scf.yield %pair_out : vector<2xf32>
        } else {
          scf.yield %x : vector<2xf32>
        }
        %out16 = vector.fptrunc %out : vector<2xf32> to vector<2xf16>
        scf.if %is_q {
          %qc0 = index.add %q_base, %lane_col : index
          %qc = index.assume %qc0 [le(%qc0, %w_limit), mul(%qc0, 2)] : index
          vector.store %out16, %qo_view[%row, %qc] : vector<2xf16>, view<[%tokens_b]x[%width]xf16>
        } else {
          %kc0 = index.add %k_base0, %lane_col : index
          %kc = index.assume %kc0 [le(%kc0, %w_limit), mul(%kc0, 2)] : index
          vector.store %out16, %ko_view[%row, %kc] : vector<2xf16>, view<[%tokens_b]x[%width]xf16>
        }
      }
    }
  }
  kernel.return
}
