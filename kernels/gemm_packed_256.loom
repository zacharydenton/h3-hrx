          %range_checked = vector.select %range_finite, %sat, %scaled : vector<4xf32>
          %narrow = vector.fptrunc %range_checked : vector<4xf32> to vector<4xf16>
          vector.store %narrow, %c_view[%bounded, %out_col] : vector<4xf16>, view<[%m_bounded]x[%n_size]xf16>
        }
      }
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
    }
  }
  template.return
}

