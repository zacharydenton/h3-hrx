    %gw1 = vector.load %w_view[%w_row1, %kq_first] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
    %gw2 = vector.load %w_view[%w_row2, %kq_first] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
    %gw3 = vector.load %w_view[%w_row3, %kq_first] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
    %acc00, %acc01, %acc10, %acc11, %a0_last, %a1_last, %a2_last, %a3_last, %a4_last, %a5_last, %a6_last, %a7_last, %w0_last, %w1_last, %w2_last, %w3_last = scf.for %k_base = [%c0 to %k_size step %k_step](%r00 = %acc_init : vector<8xi32>, %r01 = %acc_init : vector<8xi32>, %r10 = %acc_init : vector<8xi32>, %r11 = %acc_init : vector<8xi32>, %ca0 = %ga0 : vector<4xi32>, %ca1 = %ga1 : vector<4xi32>, %ca2 = %ga2 : vector<4xi32>, %ca3 = %ga3 : vector<4xi32>, %ca4 = %ga4 : vector<4xi32>, %ca5 = %ga5 : vector<4xi32>, %ca6 = %ga6 : vector<4xi32>, %ca7 = %ga7 : vector<4xi32>, %cw0 = %gw0 : vector<4xi32>, %cw1 = %gw1 : vector<4xi32>, %cw2 = %gw2 : vector<4xi32>, %cw3 = %gw3 : vector<4xi32>) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>) {
      vector.store %ca0, %a_stage[%st_arow0, %st_quad] : vector<4xi32>, view<128x68xi32>
      vector.store %ca1, %a_stage[%st_arow1, %st_quad] : vector<4xi32>, view<128x68xi32>
      vector.store %ca2, %a_stage[%st_arow2, %st_quad] : vector<4xi32>, view<128x68xi32>
      vector.store %ca3, %a_stage[%st_arow3, %st_quad] : vector<4xi32>, view<128x68xi32>
      vector.store %ca4, %a_stage[%st_arow4, %st_quad] : vector<4xi32>, view<128x68xi32>
      vector.store %ca5, %a_stage[%st_arow5, %st_quad] : vector<4xi32>, view<128x68xi32>
      vector.store %ca6, %a_stage[%st_arow6, %st_quad] : vector<4xi32>, view<128x68xi32>
      vector.store %ca7, %a_stage[%st_arow7, %st_quad] : vector<4xi32>, view<128x68xi32>
      vector.store %cw0, %w_stage[%st_wrow0, %st_quad] : vector<4xi32>, view<64x68xi32>
      vector.store %cw1, %w_stage[%st_wrow1, %st_quad] : vector<4xi32>, view<64x68xi32>
      vector.store %cw2, %w_stage[%st_wrow2, %st_quad] : vector<4xi32>, view<64x68xi32>
      vector.store %cw3, %w_stage[%st_wrow3, %st_quad] : vector<4xi32>, view<64x68xi32>
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %k_next = index.add %k_base, %k_step : index
      %in_k = index.cmp ult, %k_next, %k_size : index
      %kq_next0 = index.div %k_next, %packed_per_word : index
      %kq_slot = index.add %kq_next0, %st_quad : index
      %kq_safe = scf.select %in_k, %kq_slot, %st_quad : index
      %kq_next = index.assume %kq_safe [le(%kq_safe, %k_quad_limit), mul(%kq_safe, 4)] : index
      %na0 = vector.load %a_view[%a_row0, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na1 = vector.load %a_view[%a_row1, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na2 = vector.load %a_view[%a_row2, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na3 = vector.load %a_view[%a_row3, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na4 = vector.load %a_view[%a_row4, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na5 = vector.load %a_view[%a_row5, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na6 = vector.load %a_view[%a_row6, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na7 = vector.load %a_view[%a_row7, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %nw0 = vector.load %w_view[%w_row0, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
      %nw1 = vector.load %w_view[%w_row1, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
      %nw2 = vector.load %w_view[%w_row2, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
      %nw3 = vector.load %w_view[%w_row3, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>

      // Eight substeps per loop keep operand registers below the spill threshold.
      %substeps = index.div %c64, %registers : index
      %o00_end, %o01_end, %o10_end, %o11_end = scf.for %sub = [%c0 to %substeps step %c1](%carry00 = %r00 : vector<8xi32>, %carry01 = %r01 : vector<8xi32>, %carry10 = %r10 : vector<8xi32>, %carry11 = %r11 : vector<8xi32>) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>) unroll(%c8) {
        %sub_column = index.mul %sub, %registers : index
        %u_da0 = vector.load %a_stage[%fa0, %sub_column] : view<128x68xi32> -> vector<[%registers]xi32>
        %u_da1 = vector.load %a_stage[%fa1, %sub_column] : view<128x68xi32> -> vector<[%registers]xi32>
        %u_db0 = vector.load %w_stage[%fb0, %sub_column] : view<64x68xi32> -> vector<[%registers]xi32>
        %u_db1 = vector.load %w_stage[%fb1, %sub_column] : view<64x68xi32> -> vector<[%registers]xi32>
        %u_la0 = vector.fragment<lhs> %u_da0 shape [%m, %k] using {schema = %i4_schema : encoding<schema>} : vector<[%registers]xi32>
        %u_la1 = vector.fragment<lhs> %u_da1 shape [%m, %k] using {schema = %i4_schema : encoding<schema>} : vector<[%registers]xi32>
        %u_rb0 = vector.fragment<rhs> %u_db0 shape [%k, %n] using {schema = %i4_schema : encoding<schema>} : vector<[%registers]xi32>
        %u_rb1 = vector.fragment<rhs> %u_db1 shape [%k, %n] using {schema = %i4_schema : encoding<schema>} : vector<[%registers]xi32>
        %u_o00 = vector.mma %u_la0, %u_rb0, %carry00 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        %u_o01 = vector.mma %u_la0, %u_rb1, %carry01 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        %u_o10 = vector.mma %u_la1, %u_rb0, %carry10 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        %u_o11 = vector.mma %u_la1, %u_rb1, %carry11 : vector<[%registers]xi32>, vector<[%registers]xi32>, vector<8xi32>
        scf.yield %u_o00, %u_o01, %u_o10, %u_o11 : vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %o00_end, %o01_end, %o10_end, %o11_end, %na0, %na1, %na2, %na3, %na4, %na5, %na6, %na7, %nw0, %nw1, %nw2, %nw3 : vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>
    }

    // Publish through LDS. Each lane takes two vector4 slices of each staged 16x16 tile.
    %publish_row0 = index.div %lane, %c4 : index
    %publish_col_group = index.rem %lane, %c4 : index
    %publish_col = index.mul %publish_col_group, %c4 : index
    %zero_f32 = scalar.constant 0.0 : f32
    %zero4 = vector.splat %zero_f32 : vector<4xf32>
    scf.for %step = [%c0 to %c4 step %c1] {
