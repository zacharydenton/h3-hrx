template.decl @h3.packed_resid_256b(%m_size: index, %a: buffer, %w: buffer, %scale: buffer, %a_scale: buffer, %c: buffer, %gate: buffer, %cls: buffer, %bias: buffer, %cfg_k_size: index, %cfg_n_size: index, %cfg_k_stride: index, %cfg_m_group: index, %cfg_classes: index, %registers: index, %k_step: index, %packed_per_word: index)

template.def<@h3.packed_resid_256b> @h3_packed_resid_256b(%m_size: index, %a: buffer, %w: buffer, %scale: buffer, %a_scale: buffer, %c: buffer, %gate: buffer, %cls: buffer, %bias: buffer, %cfg_k_size: index, %cfg_n_size: index, %cfg_k_stride: index, %cfg_m_group: index, %cfg_classes: index, %registers: index, %k_step: index, %packed_per_word: index) {
