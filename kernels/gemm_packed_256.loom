      %na1 = vector.load %a_view[%a_row1, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na2 = vector.load %a_view[%a_row2, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %na3 = vector.load %a_view[%a_row3, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      %nw0 = vector.load %w_view[%w_row0, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
      %nw1 = vector.load %w_view[%w_row1, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>

      // Full unrolling preserves the source order of each staged substep.
      %substeps = index.div %c16, %registers : index
      %o00_end, %o01_end, %o02_end, %o03_end, %o10_end, %o11_end, %o12_end, %o13_end, %o20_end, %o21_end, %o22_end, %o23_end, %o30_end, %o31_end, %o32_end, %o33_end = scf.for %sub = [%c0 to %substeps step %c1](%carry00 = %r00 : vector<8xi32>, %carry01 = %r01 : vector<8xi32>, %carry02 = %r02 : vector<8xi32>, %carry03 = %r03 : vector<8xi32>, %carry10 = %r10 : vector<8xi32>, %carry11 = %r11 : vector<8xi32>, %carry12 = %r12 : vector<8xi32>, %carry13 = %r13 : vector<8xi32>, %carry20 = %r20 : vector<8xi32>, %carry21 = %r21 : vector<8xi32>, %carry22 = %r22 : vector<8xi32>, %carry23 = %r23 : vector<8xi32>, %carry30 = %r30 : vector<8xi32>, %carry31 = %r31 : vector<8xi32>, %carry32 = %r32 : vector<8xi32>, %carry33 = %r33 : vector<8xi32>) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>) unroll {
