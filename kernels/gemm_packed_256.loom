    %a_row3 = index.assume %a_safe3 [lt(%a_safe3, %m_bounded)] : index
    %st_wrow0 = index.add %st_row_base, %c0 : index
    %w_n0 = index.add %base_n, %st_wrow0 : index
    %w_row0 = index.assume %w_n0 [lt(%w_n0, %n_size)] : index
    %st_wrow1 = index.add %st_row_base, %c64 : index
    %w_n1 = index.add %base_n, %st_wrow1 : index
    %w_row1 = index.assume %w_n1 [lt(%w_n1, %n_size)] : index

