          %den = vector.addf %one4, %e : vector<4xf32>
          %sig = vector.divf %one4, %den : vector<4xf32>
          %silu = vector.mulf %g, %sig : vector<4xf32>
          %prod = vector.mulf %silu, %u : vector<4xf32>
          scf.if %output_f32 {
