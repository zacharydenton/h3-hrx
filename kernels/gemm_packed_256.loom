    %st_arow6 = index.add %st_row_base, %c96 : index
    %a_m6 = index.add %base_m, %st_arow6 : index
    %a_ok6 = index.cmp ult, %a_m6, %m_bounded : index
    %a_safe6 = scf.select %a_ok6, %a_m6, %c0 : index
