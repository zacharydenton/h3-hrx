          %range_abs = vector.absf %prod : vector<4xf32>
          %range_finite = vector.cmpf olt, %range_abs, %range_inf : vector<4xf32> -> vector<4xi1>
          %range_checked = vector.select %range_finite, %sat, %prod : vector<4xf32>
          %narrow = vector.fptrunc %range_checked : vector<4xf32> to vector<4xf16>
          vector.store %narrow, %c_view[%bounded, %out_col] : vector<4xf16>, view<[%m_bounded]x[%n_half]xf16>
          }
        }
      }
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
    }
  }
