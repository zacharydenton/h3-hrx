// BigVGAN's anti-aliased activation, second half: the 12-tap low-pass at stride 2 with replicate
// padding (5 left, 6 right): out[c][n] = sum_k fir[k] * y[c][clamp(2n + k - 5, 0, len2 - 1)].
// y [C][len2] -> out [C][len2 / 2]. One lane per output sample.
amdgpu.target<gfx11-generic> @h3_down2_f32_gfx11 {subgroup_size = 32}

config.decl @h3.down2_f32.channels : %value: index where [range(%value, 1, 4096)]

config.decl @h3.down2_f32.len_bound : %value: index where [range(%value, 256, 4194304), mul(%value, 256)]

kernel.def target(@h3_down2_f32_gfx11) export("h3_down2_f32") @h3_down2_f32(%len2: index) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %channels = config.get @h3.down2_f32.channels : index
  %olen = index.div %len2, %c2 : index
  %rounded = index.add %olen, %c255 : index
  %groups = index.div %rounded, %c256 : index
  kernel.launch.config workgroups(%groups, %channels, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%len2: index, %y: buffer, %fir: buffer, %out: buffer) {
  %channels = config.get @h3.down2_f32.channels : index
  %len_bound = config.get @h3.down2_f32.len_bound : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c5 = index.constant 5 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %zero = scalar.constant 0.0 : f32
  %len2_b = index.assume %len2 [range(%len2, 2, 8388608), mul(%len2, 2), le(%len2, %len_bound)] : index
  %olen = index.div %len2_b, %c2 : index
  %len_last = index.sub %len2_b, %c1 : index
  %wg = kernel.workgroup.id<x> : index
  %c_0 = kernel.workgroup.id<y> : index
  %ch = index.assume %c_0 [lt(%c_0, %channels)] : index
  %lane = kernel.workitem.id<x> : index
  %base = index.mul %wg, %c256 : index
  %n = index.add %base, %lane : index
  %y_global = buffer.assume.memory_space<global> %y : buffer
  %f_global = buffer.assume.memory_space<global> %fir : buffer
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %y_view = buffer.view %y_global[%c0_offset] : buffer -> view<[%channels]x[%len2_b]xf32>
  %f_view = buffer.view %f_global[%c0_offset] : buffer -> view<12xf32>
  %out_view = buffer.view %out_global[%c0_offset] : buffer -> view<[%channels]x[%olen]xf32>
  %active = index.cmp ult, %n, %olen : index
  scf.if %active {
    %nn = index.assume %n [lt(%n, %olen)] : index
    %n2 = index.mul %nn, %c2 : index
    // Prefetch the twelve clamped samples; retain ascending FP32 FMAs.
    %k0 = index.constant 0 : index
    %j0 = index.add %n2, %k0 : index
    %low0 = index.cmp ult, %j0, %c5 : index
    %j5_0 = index.sub %j0, %c5 : index
    %src0_0 = scf.select %low0, %c0, %j5_0 : index
    %high0 = index.cmp ugt, %src0_0, %len_last : index
    %src1_0 = scf.select %high0, %len_last, %src0_0 : index
    %src0 = index.assume %src1_0 [range(%src1_0, 0, 8388608), lt(%src1_0, %len2_b)] : index
    %fv0 = view.load %f_view[%k0] : view<12xf32> -> f32
    %yv0 = view.load %y_view[%ch, %src0] : view<[%channels]x[%len2_b]xf32> -> f32
    %k1 = index.constant 1 : index
    %j1 = index.add %n2, %k1 : index
    %low1 = index.cmp ult, %j1, %c5 : index
    %j5_1 = index.sub %j1, %c5 : index
    %src0_1 = scf.select %low1, %c0, %j5_1 : index
    %high1 = index.cmp ugt, %src0_1, %len_last : index
    %src1_1 = scf.select %high1, %len_last, %src0_1 : index
    %src1 = index.assume %src1_1 [range(%src1_1, 0, 8388608), lt(%src1_1, %len2_b)] : index
    %fv1 = view.load %f_view[%k1] : view<12xf32> -> f32
    %yv1 = view.load %y_view[%ch, %src1] : view<[%channels]x[%len2_b]xf32> -> f32
    %k2 = index.constant 2 : index
    %j2 = index.add %n2, %k2 : index
    %low2 = index.cmp ult, %j2, %c5 : index
    %j5_2 = index.sub %j2, %c5 : index
    %src0_2 = scf.select %low2, %c0, %j5_2 : index
    %high2 = index.cmp ugt, %src0_2, %len_last : index
    %src1_2 = scf.select %high2, %len_last, %src0_2 : index
    %src2 = index.assume %src1_2 [range(%src1_2, 0, 8388608), lt(%src1_2, %len2_b)] : index
    %fv2 = view.load %f_view[%k2] : view<12xf32> -> f32
    %yv2 = view.load %y_view[%ch, %src2] : view<[%channels]x[%len2_b]xf32> -> f32
    %k3 = index.constant 3 : index
    %j3 = index.add %n2, %k3 : index
    %low3 = index.cmp ult, %j3, %c5 : index
    %j5_3 = index.sub %j3, %c5 : index
    %src0_3 = scf.select %low3, %c0, %j5_3 : index
    %high3 = index.cmp ugt, %src0_3, %len_last : index
    %src1_3 = scf.select %high3, %len_last, %src0_3 : index
    %src3 = index.assume %src1_3 [range(%src1_3, 0, 8388608), lt(%src1_3, %len2_b)] : index
    %fv3 = view.load %f_view[%k3] : view<12xf32> -> f32
    %yv3 = view.load %y_view[%ch, %src3] : view<[%channels]x[%len2_b]xf32> -> f32
    %k4 = index.constant 4 : index
    %j4 = index.add %n2, %k4 : index
    %low4 = index.cmp ult, %j4, %c5 : index
    %j5_4 = index.sub %j4, %c5 : index
    %src0_4 = scf.select %low4, %c0, %j5_4 : index
    %high4 = index.cmp ugt, %src0_4, %len_last : index
    %src1_4 = scf.select %high4, %len_last, %src0_4 : index
    %src4 = index.assume %src1_4 [range(%src1_4, 0, 8388608), lt(%src1_4, %len2_b)] : index
    %fv4 = view.load %f_view[%k4] : view<12xf32> -> f32
    %yv4 = view.load %y_view[%ch, %src4] : view<[%channels]x[%len2_b]xf32> -> f32
    %k5 = index.constant 5 : index
    %j5 = index.add %n2, %k5 : index
    %low5 = index.cmp ult, %j5, %c5 : index
    %j5_5 = index.sub %j5, %c5 : index
    %src0_5 = scf.select %low5, %c0, %j5_5 : index
    %high5 = index.cmp ugt, %src0_5, %len_last : index
    %src1_5 = scf.select %high5, %len_last, %src0_5 : index
    %src5 = index.assume %src1_5 [range(%src1_5, 0, 8388608), lt(%src1_5, %len2_b)] : index
    %fv5 = view.load %f_view[%k5] : view<12xf32> -> f32
    %yv5 = view.load %y_view[%ch, %src5] : view<[%channels]x[%len2_b]xf32> -> f32
    %k6 = index.constant 6 : index
    %j6 = index.add %n2, %k6 : index
    %low6 = index.cmp ult, %j6, %c5 : index
    %j5_6 = index.sub %j6, %c5 : index
    %src0_6 = scf.select %low6, %c0, %j5_6 : index
    %high6 = index.cmp ugt, %src0_6, %len_last : index
    %src1_6 = scf.select %high6, %len_last, %src0_6 : index
    %src6 = index.assume %src1_6 [range(%src1_6, 0, 8388608), lt(%src1_6, %len2_b)] : index
    %fv6 = view.load %f_view[%k6] : view<12xf32> -> f32
    %yv6 = view.load %y_view[%ch, %src6] : view<[%channels]x[%len2_b]xf32> -> f32
    %k7 = index.constant 7 : index
    %j7 = index.add %n2, %k7 : index
    %low7 = index.cmp ult, %j7, %c5 : index
    %j5_7 = index.sub %j7, %c5 : index
    %src0_7 = scf.select %low7, %c0, %j5_7 : index
    %high7 = index.cmp ugt, %src0_7, %len_last : index
    %src1_7 = scf.select %high7, %len_last, %src0_7 : index
    %src7 = index.assume %src1_7 [range(%src1_7, 0, 8388608), lt(%src1_7, %len2_b)] : index
    %fv7 = view.load %f_view[%k7] : view<12xf32> -> f32
    %yv7 = view.load %y_view[%ch, %src7] : view<[%channels]x[%len2_b]xf32> -> f32
    %k8 = index.constant 8 : index
    %j8 = index.add %n2, %k8 : index
    %low8 = index.cmp ult, %j8, %c5 : index
    %j5_8 = index.sub %j8, %c5 : index
    %src0_8 = scf.select %low8, %c0, %j5_8 : index
    %high8 = index.cmp ugt, %src0_8, %len_last : index
    %src1_8 = scf.select %high8, %len_last, %src0_8 : index
    %src8 = index.assume %src1_8 [range(%src1_8, 0, 8388608), lt(%src1_8, %len2_b)] : index
    %fv8 = view.load %f_view[%k8] : view<12xf32> -> f32
    %yv8 = view.load %y_view[%ch, %src8] : view<[%channels]x[%len2_b]xf32> -> f32
    %k9 = index.constant 9 : index
    %j9 = index.add %n2, %k9 : index
    %low9 = index.cmp ult, %j9, %c5 : index
    %j5_9 = index.sub %j9, %c5 : index
    %src0_9 = scf.select %low9, %c0, %j5_9 : index
    %high9 = index.cmp ugt, %src0_9, %len_last : index
    %src1_9 = scf.select %high9, %len_last, %src0_9 : index
    %src9 = index.assume %src1_9 [range(%src1_9, 0, 8388608), lt(%src1_9, %len2_b)] : index
    %fv9 = view.load %f_view[%k9] : view<12xf32> -> f32
    %yv9 = view.load %y_view[%ch, %src9] : view<[%channels]x[%len2_b]xf32> -> f32
    %k10 = index.constant 10 : index
    %j10 = index.add %n2, %k10 : index
    %low10 = index.cmp ult, %j10, %c5 : index
    %j5_10 = index.sub %j10, %c5 : index
    %src0_10 = scf.select %low10, %c0, %j5_10 : index
    %high10 = index.cmp ugt, %src0_10, %len_last : index
    %src1_10 = scf.select %high10, %len_last, %src0_10 : index
    %src10 = index.assume %src1_10 [range(%src1_10, 0, 8388608), lt(%src1_10, %len2_b)] : index
    %fv10 = view.load %f_view[%k10] : view<12xf32> -> f32
    %yv10 = view.load %y_view[%ch, %src10] : view<[%channels]x[%len2_b]xf32> -> f32
    %k11 = index.constant 11 : index
    %j11 = index.add %n2, %k11 : index
    %low11 = index.cmp ult, %j11, %c5 : index
    %j5_11 = index.sub %j11, %c5 : index
    %src0_11 = scf.select %low11, %c0, %j5_11 : index
    %high11 = index.cmp ugt, %src0_11, %len_last : index
    %src1_11 = scf.select %high11, %len_last, %src0_11 : index
    %src11 = index.assume %src1_11 [range(%src1_11, 0, 8388608), lt(%src1_11, %len2_b)] : index
    %fv11 = view.load %f_view[%k11] : view<12xf32> -> f32
    %yv11 = view.load %y_view[%ch, %src11] : view<[%channels]x[%len2_b]xf32> -> f32
    %acc0 = scalar.fmaf %fv0, %yv0, %zero : f32
    %acc1 = scalar.fmaf %fv1, %yv1, %acc0 : f32
    %acc2 = scalar.fmaf %fv2, %yv2, %acc1 : f32
    %acc3 = scalar.fmaf %fv3, %yv3, %acc2 : f32
    %acc4 = scalar.fmaf %fv4, %yv4, %acc3 : f32
    %acc5 = scalar.fmaf %fv5, %yv5, %acc4 : f32
    %acc6 = scalar.fmaf %fv6, %yv6, %acc5 : f32
    %acc7 = scalar.fmaf %fv7, %yv7, %acc6 : f32
    %acc8 = scalar.fmaf %fv8, %yv8, %acc7 : f32
    %acc9 = scalar.fmaf %fv9, %yv9, %acc8 : f32
    %acc10 = scalar.fmaf %fv10, %yv10, %acc9 : f32
    %acc = scalar.fmaf %fv11, %yv11, %acc10 : f32
    view.store %acc, %out_view[%ch, %nn] : f32, view<[%channels]x[%olen]xf32>
  }
  kernel.return
}
