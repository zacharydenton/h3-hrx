  %w_fragment_layout = encoding.layout.strided [1, %c40] : encoding<layout>
  %w_fragment_view = buffer.view %w_stage[%c0_offset] : buffer -> view<32x64xbf16, %w_fragment_layout>
  %wave_result_offset = index.scale %subgroup, %wave_result_bytes : index, offset -> offset
  %result_view = buffer.view %result_stage[%wave_result_offset] : buffer -> view<16x16xf32>

  %load_packet = index.rem %workitem, %c8 : index
  %load_k = index.mul %load_packet, %c4 : index
  %load_row0 = index.div %workitem, %c8 : index
  %load_row = index.assume %load_row0 [range(%load_row0, 0, 31)] : index
  %load_row_high = index.add %load_row, %c32 : index

  %acc_init0 = vector.fragment<init> %zero_f32x8 shape [%m, %n] : vector<8xf32>
  %acc_init1 = vector.fragment<init> %zero_f32x8 shape [%m, %n] : vector<8xf32>

  %acc0, %acc1 = scf.for %k_base = [%c0 to %k_size step %c32](%run0 = %acc_init0 : vector<8xf32>, %run1 = %acc_init1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
    %source_k = index.add %k_base, %load_k : index
    scf.for %half = [%c0 to %c2 step %c1] {
      %row_offset = index.mul %half, %c32 : index
      %row = index.add %load_row, %row_offset : index
      %source_m = index.add %base_m, %row : index
      %m_in_range = index.cmp ult, %source_m, %m_size : index
      %a_values = scf.if %m_in_range -> (vector<4xbf16>) {
        %bounded = index.assume %source_m [lt(%source_m, %m_size)] : index
        %wide = vector.load %a_view[%bounded, %source_k] : view<[%m_size]x[%k_size]xf32> -> vector<4xf32>
        %narrow = vector.fptrunc %wide : vector<4xf32> to vector<4xbf16>
        scf.yield %narrow : vector<4xbf16>
      } else {
        scf.yield %zero_f16x4 : vector<4xbf16>
      }
      vector.store %a_values, %a_stage_view[%row, %load_k] : vector<4xbf16>, view<64x40xbf16>
      %source_n = index.add %base_n, %row : index
      %w_values = vector.load %w_view[%source_n, %source_k] : view<[%n_size]x[%k_size]xbf16> -> vector<4xbf16>
      vector.store %w_values, %w_stage_view[%row, %load_k] : vector<4xbf16>, view<64x40xbf16>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %next0, %next1 = scf.for %k_half = [%c0 to %c32 step %c16](%half0 = %run0 : vector<8xf32>, %half1 = %run1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) unroll {
      %lhs = vector.fragment.load<lhs> %a_stage_view[%wave_row, %k_half] shape [%m, %k] : view<64x40xbf16> -> vector<16xbf16>
      %rhs0 = vector.fragment.load<rhs> %w_fragment_view[%k_half, %wave_col] shape [%k, %n] : view<32x64xbf16, %w_fragment_layout> -> vector<16xbf16>
      %rhs1 = vector.fragment.load<rhs> %w_fragment_view[%k_half, %wave_col1] shape [%k, %n] : view<32x64xbf16, %w_fragment_layout> -> vector<16xbf16>
      %out0 = vector.mma %lhs, %rhs0, %half0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %out1 = vector.mma %lhs, %rhs1, %half1 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      scf.yield %out0, %out1 : vector<8xf32>, vector<8xf32>
