      %z = vector.mulf %g_rs2, %biased0 : vector<4xf32>
      %az = vector.absf %z : vector<4xf32>
      %pz = vector.fmaf %g_p, %az, %g_one : vector<4xf32>
      %t = vector.divf %g_one, %pz : vector<4xf32>
      %poly4 = vector.fmaf %g_a5, %t, %g_a4 : vector<4xf32>
      %poly3 = vector.fmaf %poly4, %t, %g_a3 : vector<4xf32>
      %poly2 = vector.fmaf %poly3, %t, %g_a2 : vector<4xf32>
      %poly1 = vector.fmaf %poly2, %t, %g_a1 : vector<4xf32>
      %poly = vector.mulf %poly1, %t : vector<4xf32>
      %nz2 = vector.mulf %az, %az : vector<4xf32>
      %mz2 = vector.mulf %g_neg1, %nz2 : vector<4xf32>
      %ez = vector.expf<afn> %mz2 : vector<4xf32>
      %pe = vector.mulf %poly, %ez : vector<4xf32>
      %erf_abs = vector.subf %g_one, %pe : vector<4xf32>
      %azt = vector.maxnumf %az, %g_tiny : vector<4xf32>
      %sgn = vector.divf %z, %azt : vector<4xf32>
      %erf = vector.mulf %sgn, %erf_abs : vector<4xf32>
      %one_erf = vector.addf %g_one, %erf : vector<4xf32>
      %hx = vector.mulf %g_half, %biased0 : vector<4xf32>
      %biased = vector.mulf %hx, %one_erf : vector<4xf32>
      %row_local = index.add %wave_row, %publish_row : index
