// Fused head RMSNorm, 96-channel rotate-half RoPE and INT8 operand preparation.
// Reads a Q or K slice of the original fused FP16 QKV projection. The FP16
// rounding after RoPE and the LDS Hadamard arithmetic match the unfused path.
// Unsmooth K only; callers using K mean smoothing retain the separate kernels.
amdgpu.target<gfx11-generic> @h3_prepare_qk_rope_i8hm_gfx11 {subgroup_size = 32}

config.decl @h3.prepare_qk_rope_i8hm.row_stride : %value: index where [range(%value, 128, 65536), mul(%value, 128)]

config.decl @h3.prepare_qk_rope_i8hm.head_offset : %value: index where [range(%value, 0, 65536), mul(%value, 128)]

config.decl @h3.prepare_qk_rope_i8hm.heads : %value: index where [range(%value, 1, 256)]

config.decl @h3.prepare_qk_rope_i8hm.extra_scale : f32

config.decl @h3.prepare_qk_rope_i8hm.token_capacity : %value: index where [range(%value, 32, 1048576), mul(%value, 32)]

config.decl @h3.prepare_qk_rope_i8hm.eps : f32

kernel.def target(@h3_prepare_qk_rope_i8hm_gfx11) export("h3_prepare_qk_rope_i8hm") @h3_prepare_qk_rope_i8hm(%tokens: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%tokens: index, %x: buffer, %weight: buffer, %cos: buffer, %sin: buffer, %codes: buffer, %scales: buffer) {
  %capacity = config.get @h3.prepare_qk_rope_i8hm.token_capacity : index
  %row_stride = config.get @h3.prepare_qk_rope_i8hm.row_stride : index
  %head_offset = config.get @h3.prepare_qk_rope_i8hm.head_offset : index
  %heads = config.get @h3.prepare_qk_rope_i8hm.heads : index
  %extra = config.get @h3.prepare_qk_rope_i8hm.extra_scale : f32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c124 = index.constant 124 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c0_offset = index.constant 0 : offset
  %row_bytes = index.constant 512 : offset
  %lds_bytes = index.constant 4096 : offset
  %sh4 = scalar.constant 4 : i32
  %sh8 = scalar.constant 8 : i32
  %sh12 = scalar.constant 12 : i32
  %sh16 = scalar.constant 16 : i32
  %sh24 = scalar.constant 24 : i32
  %fifteen = scalar.constant 255 : i32
  %seven = scalar.constant 127.0 : f32
  %neg_seven = scalar.constant -127.0 : f32
  %tiny = scalar.constant 1.0000000000000001e-30 : f32
  %zero = scalar.constant 0.0 : f32
  %seven4 = vector.splat %seven : vector<4xf32>
  %zero4 = vector.splat %zero : vector<4xf32>
  %neg_seven4 = vector.splat %neg_seven : vector<4xf32>
  %fifteen4 = vector.splat %fifteen : vector<4xi32>
  %tokens_b = index.assume %tokens [range(%tokens, 1, 1048576)] : index
  %words = index.mul %heads, %c32 : index
  %rows = index.mul %heads, %capacity : index
  // one workgroup per token; its eight waves take heads round * 8 + wave (as the rope kernel)
  %token0 = kernel.workgroup.id<x> : index
  %token = index.assume %token0 [lt(%token0, %tokens_b)] : index
  %wave0 = kernel.subgroup.id : index
  %wave = index.assume %wave0 [range(%wave0, 0, 7)] : index
  %lane0 = kernel.subgroup.lane.id : index
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index
  %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %row_off = index.scale %wave, %row_bytes : index, offset -> offset
  %row_view = buffer.view %lds[%row_off] : buffer -> view<128xf32>
  %rounds0 = index.add %heads, %c7 : index
  %rounds = index.div %rounds0, %c8 : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %c_global = buffer.assume.memory_space<global> %codes : buffer
  %s_global = buffer.assume.memory_space<global> %scales : buffer
  %x_view = buffer.view %x_global[%c0_offset] : buffer -> view<[%tokens_b]x[%row_stride]xf16>
  %eps = config.get @h3.prepare_qk_rope_i8hm.eps : f32
  %nr_invd = scalar.constant 0.0078125 : f32
  %nr_32 = scalar.constant 32 : i32
  %nr_12 = index.constant 12 : index
  %nr_24 = index.constant 24 : index
  %nr_44 = index.constant 44 : index
  %nr_wg = buffer.assume.memory_space<global> %weight : buffer
  %nr_cg = buffer.assume.memory_space<global> %cos : buffer
  %nr_sg = buffer.assume.memory_space<global> %sin : buffer
  %nr_wv = buffer.view %nr_wg[%c0_offset] : buffer -> view<128xf32>
  %nr_cv = buffer.view %nr_cg[%c0_offset] : buffer -> view<[%tokens_b]x48xf32>
  %nr_sv = buffer.view %nr_sg[%c0_offset] : buffer -> view<[%tokens_b]x48xf32>
  %nr_lo = index.cmp ult, %lane, %nr_12 : index
  %nr_pair = index.cmp ult, %lane, %nr_24 : index
  %nr_up = index.add %lane, %nr_12 : index
  %nr_down0 = index.sub %lane, %nr_12 : index
  %nr_down = scf.select %nr_pair, %nr_down0, %lane : index
  %nr_partner0 = scf.select %nr_lo, %nr_up, %nr_down : index
  %nr_partner1 = index.assume %nr_partner0 [range(%nr_partner0, 0, 31)] : index
  %nr_partner = index.cast %nr_partner1 : index to i32
  %nr_pairlane0 = scf.select %nr_lo, %lane, %nr_down0 : index
  %nr_pairlane = scf.select %nr_pair, %nr_pairlane0, %c0 : index
  %nr_paircol0 = index.mul %nr_pairlane, %c4 : index
  %nr_paircol = index.assume %nr_paircol0 [le(%nr_paircol0, %nr_44), mul(%nr_paircol0, 4)] : index
  %c_view = buffer.view %c_global[%c0_offset] : buffer -> view<[%rows]x32xi32>
  %s_view = buffer.view %s_global[%c0_offset] : buffer -> view<[%heads]x[%capacity]xf32>
  scf.for %r = [%c0 to %rounds step %c1] {
    %r8 = index.mul %r, %c8 : index
    %head0 = index.add %r8, %wave : index
    %active = index.cmp ult, %head0, %heads : index
    scf.if %active {
      %head = index.assume %head0 [lt(%head0, %heads)] : index
      %hcol0 = index.mul %head, %c128 : index
      %hcol1 = index.add %hcol0, %head_offset : index
      %lane4 = index.mul %lane, %c4 : index
      %col0 = index.add %hcol1, %lane4 : index
      %col_limit = index.sub %row_stride, %c4 : index
      %col = index.assume %col0 [le(%col0, %col_limit), mul(%col0, 4)] : index
      %x4h = vector.load %x_view[%token, %col] : view<[%tokens_b]x[%row_stride]xf16> -> vector<4xf16>
      %nr_v = vector.extf %x4h : vector<4xf16> to vector<4xf32>
      %nr_sq = vector.mulf %nr_v, %nr_v : vector<4xf32>
      %nr_lss = vector.reduce<addf> %nr_sq, %zero : vector<4xf32>, f32
      %nr_ss = kernel.subgroup.reduce<addf> %nr_lss : f32
      %nr_mean = scalar.mulf %nr_ss, %nr_invd : f32
      %nr_me = scalar.addf %nr_mean, %eps : f32
      %nr_ri = scalar.rsqrtf %nr_me : f32
      %nr_riv = vector.splat %nr_ri : vector<4xf32>
      %nr_norm = vector.mulf %nr_v, %nr_riv : vector<4xf32>
      %nr_w = vector.load %nr_wv[%lane4] : view<128xf32> -> vector<4xf32>
      %nr_x = vector.mulf %nr_norm, %nr_w : vector<4xf32>
      %nr_px, %nr_ok = kernel.subgroup.shuffle<index> %nr_x, %nr_partner, %nr_32 : vector<4xf32>, i32, i32
      %nr_c = vector.load %nr_cv[%token, %nr_paircol] : view<[%tokens_b]x48xf32> -> vector<4xf32>
      %nr_s = vector.load %nr_sv[%token, %nr_paircol] : view<[%tokens_b]x48xf32> -> vector<4xf32>
      %nr_xc = vector.mulf %nr_x, %nr_c : vector<4xf32>
      %nr_ps = vector.mulf %nr_px, %nr_s : vector<4xf32>
      %nr_lout = vector.subf %nr_xc, %nr_ps : vector<4xf32>
      %nr_hout = vector.addf %nr_xc, %nr_ps : vector<4xf32>
      %nr_pout = scf.select %nr_lo, %nr_lout, %nr_hout : vector<4xf32>
      %nr_out = scf.select %nr_pair, %nr_pout, %nr_x : vector<4xf32>
      %nr_half = vector.fptrunc %nr_out : vector<4xf32> to vector<4xf16>
      %x4 = vector.extf %nr_half : vector<4xf16> to vector<4xf32>
      %y = vector.subf %x4, %zero4 : vector<4xf32>
      // H_128, unnormalised: within the lane (index bits 0, 1), then across lanes (bits 2..6) through
      // this wave's 128-float LDS row (no lane shuffles or subgroup reductions: their lowering on
      // gfx1151 reads stale registers intermittently)
      %a = vector.extract %y[0] : vector<4xf32> -> f32
      %b = vector.extract %y[1] : vector<4xf32> -> f32
      %c = vector.extract %y[2] : vector<4xf32> -> f32
      %d = vector.extract %y[3] : vector<4xf32> -> f32
      %ab_p = scalar.addf %a, %b : f32
      %ab_m = scalar.subf %a, %b : f32
      %cd_p = scalar.addf %c, %d : f32
      %cd_m = scalar.subf %c, %d : f32
      %e0 = scalar.addf %ab_p, %cd_p : f32
      %e1 = scalar.addf %ab_m, %cd_m : f32
      %e2 = scalar.subf %ab_p, %cd_p : f32
      %e3 = scalar.subf %ab_m, %cd_m : f32
      %s0 = vector.from_elements %e0, %e1, %e2, %e3 : vector<4xf32>
      %lane_col = index.mul %lane, %c4 : index
      %lc = index.assume %lane_col [le(%lane_col, %c124), mul(%lane_col, 4)] : index
      vector.store %s0, %row_view[%lc] : vector<4xf32>, view<128xf32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      %lq1 = index.div %lane, %c1 : index
      %lb1 = index.rem %lq1, %c2 : index
      %hi1 = index.cmp eq, %lb1, %c1 : index
      %pl1a = index.sub %lane, %c1 : index
      %pl1b = index.add %lane, %c1 : index
      %pl1 = scf.select %hi1, %pl1a, %pl1b : index
      %pc10 = index.mul %pl1, %c4 : index
      %pc1 = index.assume %pc10 [range(%pc10, 0, 124), mul(%pc10, 4)] : index
      %p1 = vector.load %row_view[%pc1] : view<128xf32> -> vector<4xf32>
      %sum1 = vector.addf %s0, %p1 : vector<4xf32>
      %dif1 = vector.subf %p1, %s0 : vector<4xf32>
      %s2 = scf.select %hi1, %dif1, %sum1 : vector<4xf32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      vector.store %s2, %row_view[%lc] : vector<4xf32>, view<128xf32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      %lq2 = index.div %lane, %c2 : index
      %lb2 = index.rem %lq2, %c2 : index
      %hi2 = index.cmp eq, %lb2, %c1 : index
      %pl2a = index.sub %lane, %c2 : index
      %pl2b = index.add %lane, %c2 : index
      %pl2 = scf.select %hi2, %pl2a, %pl2b : index
      %pc20 = index.mul %pl2, %c4 : index
      %pc2 = index.assume %pc20 [range(%pc20, 0, 124), mul(%pc20, 4)] : index
      %p2 = vector.load %row_view[%pc2] : view<128xf32> -> vector<4xf32>
      %sum2 = vector.addf %s2, %p2 : vector<4xf32>
      %dif2 = vector.subf %p2, %s2 : vector<4xf32>
      %s4 = scf.select %hi2, %dif2, %sum2 : vector<4xf32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      vector.store %s4, %row_view[%lc] : vector<4xf32>, view<128xf32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      %lq4 = index.div %lane, %c4 : index
      %lb4 = index.rem %lq4, %c2 : index
      %hi4 = index.cmp eq, %lb4, %c1 : index
      %pl4a = index.sub %lane, %c4 : index
      %pl4b = index.add %lane, %c4 : index
      %pl4 = scf.select %hi4, %pl4a, %pl4b : index
      %pc40 = index.mul %pl4, %c4 : index
      %pc4 = index.assume %pc40 [range(%pc40, 0, 124), mul(%pc40, 4)] : index
      %p4 = vector.load %row_view[%pc4] : view<128xf32> -> vector<4xf32>
      %sum4 = vector.addf %s4, %p4 : vector<4xf32>
      %dif4 = vector.subf %p4, %s4 : vector<4xf32>
      %s8 = scf.select %hi4, %dif4, %sum4 : vector<4xf32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      vector.store %s8, %row_view[%lc] : vector<4xf32>, view<128xf32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      %lq8 = index.div %lane, %c8 : index
      %lb8 = index.rem %lq8, %c2 : index
      %hi8 = index.cmp eq, %lb8, %c1 : index
      %pl8a = index.sub %lane, %c8 : index
      %pl8b = index.add %lane, %c8 : index
      %pl8 = scf.select %hi8, %pl8a, %pl8b : index
      %pc80 = index.mul %pl8, %c4 : index
      %pc8 = index.assume %pc80 [range(%pc80, 0, 124), mul(%pc80, 4)] : index
      %p8 = vector.load %row_view[%pc8] : view<128xf32> -> vector<4xf32>
      %sum8 = vector.addf %s8, %p8 : vector<4xf32>
      %dif8 = vector.subf %p8, %s8 : vector<4xf32>
      %s16 = scf.select %hi8, %dif8, %sum8 : vector<4xf32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      vector.store %s16, %row_view[%lc] : vector<4xf32>, view<128xf32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      %lq16 = index.div %lane, %c16 : index
      %lb16 = index.rem %lq16, %c2 : index
      %hi16 = index.cmp eq, %lb16, %c1 : index
      %pl16a = index.sub %lane, %c16 : index
      %pl16b = index.add %lane, %c16 : index
      %pl16 = scf.select %hi16, %pl16a, %pl16b : index
      %pc160 = index.mul %pl16, %c4 : index
      %pc16 = index.assume %pc160 [range(%pc160, 0, 124), mul(%pc160, 4)] : index
      %p16 = vector.load %row_view[%pc16] : view<128xf32> -> vector<4xf32>
      %sum16 = vector.addf %s16, %p16 : vector<4xf32>
      %dif16 = vector.subf %p16, %s16 : vector<4xf32>
      %r = scf.select %hi16, %dif16, %sum16 : vector<4xf32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      vector.store %r, %row_view[%lc] : vector<4xf32>, view<128xf32>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      // per (token, head) absmax over the 128 rotated values: every lane scans the row
      %amax_v = scf.for %i = [%c0 to %c128 step %c4](%acc = %zero4 : vector<4xf32>) -> (vector<4xf32>) {
        %ii = index.assume %i [le(%i, %c124), mul(%i, 4)] : index
        %v = vector.load %row_view[%ii] : view<128xf32> -> vector<4xf32>
        %av = vector.absf %v : vector<4xf32>
        %m = vector.maxnumf %acc, %av : vector<4xf32>
        scf.yield %m : vector<4xf32>
      }
      %amax0 = vector.reduce<maxnumf> %amax_v, %zero : vector<4xf32>, f32
      %amax = scalar.maxnumf %amax0, %tiny : f32
      %sc = scalar.divf %amax, %seven : f32
      %inv = scalar.divf %seven, %amax : f32
      %inv4 = vector.splat %inv : vector<4xf32>
      %qf = vector.mulf %r, %inv4 : vector<4xf32>
      %qr = vector.roundevenf %qf : vector<4xf32>
      %qc = vector.maxnumf %qr, %neg_seven4 : vector<4xf32>
      %qd = vector.minnumf %qc, %seven4 : vector<4xf32>
      %qi = vector.fptosi %qd : vector<4xf32> to vector<4xi32>
      %qn = vector.andi %qi, %fifteen4 : vector<4xi32>
      %n0 = vector.extract %qn[0] : vector<4xi32> -> i32
      %n1 = vector.extract %qn[1] : vector<4xi32> -> i32
      %n2 = vector.extract %qn[2] : vector<4xi32> -> i32
      %n3 = vector.extract %qn[3] : vector<4xi32> -> i32
      %n1s = scalar.shli %n1, %sh8 : i32
      %n2s = scalar.shli %n2, %sh16 : i32
      %n3s = scalar.shli %n3, %sh24 : i32
      %h01 = scalar.ori %n0, %n1s : i32
      %h012 = scalar.ori %h01, %n2s : i32
      %word = scalar.ori %h012, %n3s : i32
      %hw = index.mul %head, %c32 : index
      %wi0 = index.add %hw, %lane : index
      %wi = index.assume %wi0 [lt(%wi0, %words)] : index
      %flat0 = index.mul %head, %capacity : index
      %flat1 = index.add %flat0, %token : index
      %flat = index.assume %flat1 [lt(%flat1, %rows)] : index
      view.store %word, %c_view[%flat, %lane] : i32, view<[%rows]x32xi32>
      %is_lane0 = index.cmp eq, %lane, %c0 : index
      scf.if %is_lane0 {
        %scale = scalar.mulf %sc, %extra : f32
        view.store %scale, %s_view[%head, %token] : f32, view<[%heads]x[%capacity]xf32>
      }
    }
  }
  kernel.return
}
