// Krea 2's int4 GEMM: loom-gemm's 128x128 register-prefetch tile with grouped
// rasterization, plus the W4A4 ConvRot epilogue -- the i32 accumulator is scaled by
// the weight row's scale and the activation token's scale:
//   x[m, n] = f16( x[m, n] + gate[cls[m]][n] * acc[m, n] * w_scale[n] * a_scale[m] )   (in place on x;
//   gate is a [classes][N] table, cls[m] the row's (timestep, modality) class)
// A [M][K] and W [N][K] are int4 nibbles (low first), both already Hadamard-rotated
// along K (the weights offline, the activations by the prepare kernel).
//
// GENERATED by tools/gen_gemm.py from loom-gemm; edit the generator.
amdgpu.target<gfx11-generic> @h3_gemm_i4_resid_gfx11 {subgroup_size = 32}

config.decl @h3.gemm_i4_resid.k_size : %value: index where [range(%value, 128, 65536), mul(%value, 128)]

config.decl @h3.gemm_i4_resid.n_size : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

// m-tiles per raster group: chosen per token count so the tile rows divide with as few ghost rows as possible
config.decl @h3.gemm_i4_resid.m_group : %value: index where [range(%value, 1, 4)]

config.decl @h3.gemm_i4_resid.classes : %value: index where [range(%value, 1, 64)]

kernel.def target(@h3_gemm_i4_resid_gfx11) export("h3_gemm_i4_resid") @h3_gemm_i4_resid(%m_size: index) {
  %c1 = index.constant 1 : index
  %c127 = index.constant 127 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %n_size0 = config.get @h3.gemm_i4_resid.n_size : index
  %m_rounded = index.add %m_size, %c127 : index
  %m_tiles = index.div %m_rounded, %c128 : index
  %m_group = config.get @h3.gemm_i4_resid.m_group : index
  %m_group_less = index.sub %m_group, %c1 : index
  %m_tiles3 = index.add %m_tiles, %m_group_less : index
  %m_groups = index.div %m_tiles3, %m_group : index
  %m_tiles_padded = index.mul %m_groups, %m_group : index
  %n_tiles = index.div %n_size0, %c128 : index
  kernel.launch.config workgroups(%n_tiles, %m_tiles_padded, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%m_size: index, %a: buffer, %w: buffer, %scale: buffer, %a_scale: buffer, %c: buffer, %gate: buffer, %cls: buffer) {
  %k_size0 = config.get @h3.gemm_i4_resid.k_size : index
  %n_size0 = config.get @h3.gemm_i4_resid.n_size : index
  %k_size = index.assume %k_size0 [range(%k_size0, 128, 65536), mul(%k_size0, 128)] : index
  %n_size = index.assume %n_size0 [range(%n_size0, 128, 32768), mul(%n_size0, 128)] : index

  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c20 = index.constant 20 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %lds_bytes = index.constant 20480 : offset
  %w_stage_offset = index.constant 10240 : offset
  %wave_result_bytes = index.constant 1024 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %zero_i32x8 = vector.constant 0 : vector<8xi32>
  %zero_i32x4 = vector.constant 0 : vector<4xi32>
  %i4_schema = encoding.define #encoding.operand<element_format=i4, payload_elements=16, payload_registers=2> : encoding<schema>

  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index
  %lane16 = index.rem %lane, %c16 : index
  %m_bounded = index.assume %m_size [range(%m_size, 1, 16777216)] : index
  %c127 = index.constant 127 : index
  // Rasterization: the launch is n_tiles x (m_tiles rounded up to a multiple of m_group),
  // and tiles are visited in groups of m_group m-tiles per sweep of n, so each W tile is
  // read m_group times in quick succession from cache instead of once per row of tiles.
  // A tile row past M is a ghost: its A rows load as zero and it writes nothing.
  %wg_x = kernel.workgroup.id<x> : index
  %wg_y = kernel.workgroup.id<y> : index
  %c_n_tiles = index.div %n_size, %c128 : index
  %linear0 = index.mul %wg_y, %c_n_tiles : index
  %linear = index.add %linear0, %wg_x : index
  %m_group = config.get @h3.gemm_i4_resid.m_group : index
  %group_span = index.mul %c_n_tiles, %m_group : index
  %group = index.div %linear, %group_span : index
  %in_group = index.rem %linear, %group_span : index
  %group_m = index.mul %group, %m_group : index
  %m_in_group = index.rem %in_group, %m_group : index
  %tile_m_id = index.add %group_m, %m_in_group : index
  %tile_n_id0 = index.div %in_group, %m_group : index
  %tile_n_id = index.assume %tile_n_id0 [lt(%tile_n_id0, %c_n_tiles)] : index

  // Wave grid 4 (m) x 2 (n): rows wave_row..+32, columns wave_col..+64 of the tile.
  %wave_m = index.div %subgroup, %c2 : index
  %wave_n = index.rem %subgroup, %c2 : index
  %wave_row = index.mul %wave_m, %c32 : index
  %wave_col = index.mul %wave_n, %c64 : index
  %base_m = index.mul %tile_m_id, %c128 : index
  %base_n = index.mul %tile_n_id, %c128 : index
  %k_quads = index.div %k_size, %c8 : index

  %a_global = buffer.assume.memory_space<global> %a : buffer
  %w_global = buffer.assume.memory_space<global> %w : buffer
  %scale_global = buffer.assume.memory_space<global> %scale : buffer
  %a_scale_global = buffer.assume.memory_space<global> %a_scale : buffer
  %gate_global = buffer.assume.memory_space<global> %gate : buffer
  %cls_global = buffer.assume.memory_space<global> %cls : buffer
  %classes = config.get @h3.gemm_i4_resid.classes : index
  %c_global = buffer.assume.memory_space<global> %c : buffer
  // A and W as rows of K/4 i32 quads; C as f16.
  %a_view = buffer.view %a_global[%c0_offset] : buffer -> view<[%m_bounded]x[%k_quads]xi32>
  %w_view = buffer.view %w_global[%c0_offset] : buffer -> view<[%n_size]x[%k_quads]xi32>
  %scale_view = buffer.view %scale_global[%c0_offset] : buffer -> view<[%n_size]xf32>
  %a_scale_view = buffer.view %a_scale_global[%c0_offset] : buffer -> view<[%m_bounded]xf32>
  %gate_view = buffer.view %gate_global[%c0_offset] : buffer -> view<[%classes]x[%n_size]xf32>
  %cls_view = buffer.view %cls_global[%c0_offset] : buffer -> view<[%m_bounded]xi32>
  %c_view = buffer.view %c_global[%c0_offset] : buffer -> view<[%m_bounded]x[%n_size]xf16>

  %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  // Stages: 128 rows of 20 quads (64 bytes of k, 16 of padding against bank conflicts).
  %a_stage = buffer.view %lds[%c0_offset] : buffer -> view<128x20xi32>
  %w_stage = buffer.view %lds[%w_stage_offset] : buffer -> view<128x20xi32>
  %wave_result_offset = index.scale %subgroup, %wave_result_bytes : index, offset -> offset
  %result_view = buffer.view %lds[%wave_result_offset] : buffer -> view<16x16xi32>

  // Staging map: packet p = workitem + 256*i (i = 0, 1) covers row p/4, quad column (p%4)*4.
  %pk0 = index.add %workitem, %c0 : index
  %pk1 = index.add %workitem, %c256 : index
  %st_row0 = index.div %pk0, %c4 : index
  %st_row1 = index.div %pk1, %c4 : index
  %st_sub = index.rem %workitem, %c4 : index
  %st_quad = index.mul %st_sub, %c4 : index
  %a_m0 = index.add %base_m, %st_row0 : index
  %a_m1 = index.add %base_m, %st_row1 : index
  %a_ok0 = index.cmp ult, %a_m0, %m_bounded : index
  %a_ok1 = index.cmp ult, %a_m1, %m_bounded : index
  %a_safe0 = scf.select %a_ok0, %a_m0, %c0 : index
  %a_safe1 = scf.select %a_ok1, %a_m1, %c0 : index
  %a_row0 = index.assume %a_safe0 [lt(%a_safe0, %m_bounded)] : index
  %a_row1 = index.assume %a_safe1 [lt(%a_safe1, %m_bounded)] : index
  %w_n0 = index.add %base_n, %st_row0 : index
  %w_n1 = index.add %base_n, %st_row1 : index
  %w_row0 = index.assume %w_n0 [lt(%w_n0, %n_size)] : index
  %w_row1 = index.assume %w_n1 [lt(%w_n1, %n_size)] : index
  // A step is 16 quads; this lane's slot within it is st_quad. Global columns are
  // step + slot, bounded by K/4 - 4 and 4-aligned.
  %k_quad_limit = index.sub %k_quads, %c4 : index

  // Operand rows this lane reads: A rows wave_row + 16i + lane16, W rows wave_col + 16j + lane16.
  %fa0 = index.add %wave_row, %lane16 : index
  %fa1 = index.add %fa0, %c16 : index
  %fb0 = index.add %wave_col, %lane16 : index
  %fb1 = index.add %fb0, %c16 : index
  %fb2 = index.add %fb0, %c32 : index
  %fb3 = index.add %fb0, %c48 : index

  %acc_init = vector.fragment<init> %zero_i32x8 shape [%m, %n] : vector<8xi32>

  // Gather of one k step (64 bytes = 16 quads) into registers, at quad column kq.
  %kq_first = index.assume %st_quad [le(%st_quad, %k_quad_limit), mul(%st_quad, 4)] : index
  %ga0_first = scf.if %a_ok0 -> (vector<4xi32>) {
    %v = vector.load %a_view[%a_row0, %kq_first] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
    scf.yield %v : vector<4xi32>
  } else {
    scf.yield %zero_i32x4 : vector<4xi32>
  }
  %ga1_first = scf.if %a_ok1 -> (vector<4xi32>) {
    %v = vector.load %a_view[%a_row1, %kq_first] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
    scf.yield %v : vector<4xi32>
  } else {
    scf.yield %zero_i32x4 : vector<4xi32>
  }
  %gw0_first = vector.load %w_view[%w_row0, %kq_first] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
  %gw1_first = vector.load %w_view[%w_row1, %kq_first] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>

  %acc00, %acc01, %acc02, %acc03, %acc10, %acc11, %acc12, %acc13, %a_last0, %a_last1, %w_last0, %w_last1 = scf.for %k_base = [%c0 to %k_size step %c128](%r00 = %acc_init : vector<8xi32>, %r01 = %acc_init : vector<8xi32>, %r02 = %acc_init : vector<8xi32>, %r03 = %acc_init : vector<8xi32>, %r10 = %acc_init : vector<8xi32>, %r11 = %acc_init : vector<8xi32>, %r12 = %acc_init : vector<8xi32>, %r13 = %acc_init : vector<8xi32>, %ca0 = %ga0_first : vector<4xi32>, %ca1 = %ga1_first : vector<4xi32>, %cw0 = %gw0_first : vector<4xi32>, %cw1 = %gw1_first : vector<4xi32>) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>) {
    // Stage what we were handed.
    vector.store %ca0, %a_stage[%st_row0, %st_quad] : vector<4xi32>, view<128x20xi32>
    vector.store %ca1, %a_stage[%st_row1, %st_quad] : vector<4xi32>, view<128x20xi32>
    vector.store %cw0, %w_stage[%st_row0, %st_quad] : vector<4xi32>, view<128x20xi32>
    vector.store %cw1, %w_stage[%st_row1, %st_quad] : vector<4xi32>, view<128x20xi32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    // Prefetch the next step (zero past K) while the WMMAs run on this one.
    %k_next = index.add %k_base, %c128 : index
    %in_k = index.cmp ult, %k_next, %k_size : index
    %kq_next0 = index.div %k_next, %c8 : index
    %kq_slot = index.add %kq_next0, %st_quad : index
    %kq_safe = scf.select %in_k, %kq_slot, %st_quad : index
    %kq_next = index.assume %kq_safe [le(%kq_safe, %k_quad_limit), mul(%kq_safe, 4)] : index
    %load_a0 = scalar.andi %in_k, %a_ok0 : i1
    %load_a1 = scalar.andi %in_k, %a_ok1 : i1
    %na0 = scf.if %load_a0 -> (vector<4xi32>) {
      %v = vector.load %a_view[%a_row0, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      scf.yield %v : vector<4xi32>
    } else {
      scf.yield %zero_i32x4 : vector<4xi32>
    }
    %na1 = scf.if %load_a1 -> (vector<4xi32>) {
      %v = vector.load %a_view[%a_row1, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      scf.yield %v : vector<4xi32>
    } else {
      scf.yield %zero_i32x4 : vector<4xi32>
    }
    %nw0 = scf.if %in_k -> (vector<4xi32>) {
      %v = vector.load %w_view[%w_row0, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
      scf.yield %v : vector<4xi32>
    } else {
      scf.yield %zero_i32x4 : vector<4xi32>
    }
    %nw1 = scf.if %in_k -> (vector<4xi32>) {
      %v = vector.load %w_view[%w_row1, %kq_next] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
      scf.yield %v : vector<4xi32>
    } else {
      scf.yield %zero_i32x4 : vector<4xi32>
    }

    // Eight 16-wide sub-steps over the staged 64 bytes (128 nibbles).
    %n00, %n01, %n02, %n03, %n10, %n11, %n12, %n13 = scf.for %kq = [%c0 to %c16 step %c2](%h00 = %r00 : vector<8xi32>, %h01 = %r01 : vector<8xi32>, %h02 = %r02 : vector<8xi32>, %h03 = %r03 : vector<8xi32>, %h10 = %r10 : vector<8xi32>, %h11 = %r11 : vector<8xi32>, %h12 = %r12 : vector<8xi32>, %h13 = %r13 : vector<8xi32>) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>) unroll {
      %da0 = vector.load %a_stage[%fa0, %kq] : view<128x20xi32> -> vector<2xi32>
      %da1 = vector.load %a_stage[%fa1, %kq] : view<128x20xi32> -> vector<2xi32>
      %db0 = vector.load %w_stage[%fb0, %kq] : view<128x20xi32> -> vector<2xi32>
      %db1 = vector.load %w_stage[%fb1, %kq] : view<128x20xi32> -> vector<2xi32>
      %db2 = vector.load %w_stage[%fb2, %kq] : view<128x20xi32> -> vector<2xi32>
      %db3 = vector.load %w_stage[%fb3, %kq] : view<128x20xi32> -> vector<2xi32>
      %la0 = vector.fragment<lhs> %da0 shape [%m, %k] using {schema = %i4_schema : encoding<schema>} : vector<2xi32>
      %la1 = vector.fragment<lhs> %da1 shape [%m, %k] using {schema = %i4_schema : encoding<schema>} : vector<2xi32>
      %rb0 = vector.fragment<rhs> %db0 shape [%k, %n] using {schema = %i4_schema : encoding<schema>} : vector<2xi32>
      %rb1 = vector.fragment<rhs> %db1 shape [%k, %n] using {schema = %i4_schema : encoding<schema>} : vector<2xi32>
      %rb2 = vector.fragment<rhs> %db2 shape [%k, %n] using {schema = %i4_schema : encoding<schema>} : vector<2xi32>
      %rb3 = vector.fragment<rhs> %db3 shape [%k, %n] using {schema = %i4_schema : encoding<schema>} : vector<2xi32>
      %o00 = vector.mma %la0, %rb0, %h00 : vector<2xi32>, vector<2xi32>, vector<8xi32>
      %o01 = vector.mma %la0, %rb1, %h01 : vector<2xi32>, vector<2xi32>, vector<8xi32>
      %o02 = vector.mma %la0, %rb2, %h02 : vector<2xi32>, vector<2xi32>, vector<8xi32>
      %o03 = vector.mma %la0, %rb3, %h03 : vector<2xi32>, vector<2xi32>, vector<8xi32>
      %o10 = vector.mma %la1, %rb0, %h10 : vector<2xi32>, vector<2xi32>, vector<8xi32>
      %o11 = vector.mma %la1, %rb1, %h11 : vector<2xi32>, vector<2xi32>, vector<8xi32>
      %o12 = vector.mma %la1, %rb2, %h12 : vector<2xi32>, vector<2xi32>, vector<8xi32>
      %o13 = vector.mma %la1, %rb3, %h13 : vector<2xi32>, vector<2xi32>, vector<8xi32>
      scf.yield %o00, %o01, %o02, %o03, %o10, %o11, %o12, %o13 : vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %n00, %n01, %n02, %n03, %n10, %n11, %n12, %n13, %na0, %na1, %nw0, %nw1 : vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>
  }

  // Publish through LDS: each lane takes two vector4 slices of each 16x16 tile.
  %publish_row0 = index.div %lane, %c4 : index
  %publish_col_group = index.rem %lane, %c4 : index
  %publish_col = index.mul %publish_col_group, %c4 : index

  scf.for %fragment = [%c0 to %c8 step %c1] {
    %fi = index.div %fragment, %c4 : index
    %fj = index.rem %fragment, %c4 : index
    %is1 = index.cmp eq, %fragment, %c1 : index
    %is2 = index.cmp eq, %fragment, %c2 : index
    %is3 = index.cmp eq, %fragment, %c3 : index
    %is4 = index.cmp eq, %fragment, %c4 : index
    %is5 = index.cmp eq, %fj, %c1 : index
    %is6 = index.cmp eq, %fj, %c2 : index
    %is7 = index.cmp eq, %fj, %c3 : index
    %p1 = scf.select %is1, %acc01, %acc00 : vector<8xi32>
    %p2 = scf.select %is2, %acc02, %p1 : vector<8xi32>
    %p3 = scf.select %is3, %acc03, %p2 : vector<8xi32>
    %q1 = scf.select %is5, %acc11, %acc10 : vector<8xi32>
    %q2 = scf.select %is6, %acc12, %q1 : vector<8xi32>
    %q3 = scf.select %is7, %acc13, %q2 : vector<8xi32>
    %is_second_row = index.cmp uge, %fragment, %c4 : index
    %chosen = scf.select %is_second_row, %q3, %p3 : vector<8xi32>
    vector.fragment.store<result> %chosen, %result_view[%c0, %c0] shape [%m, %n] : vector<8xi32>, view<16x16xi32>
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)

    %frag_row_offset = index.mul %fi, %c16 : index
    %frag_col_offset = index.mul %fj, %c16 : index
    %tile_col = index.add %wave_col, %frag_col_offset : index
    %out_col_local = index.add %tile_col, %publish_col : index
    %out_col = index.add %base_n, %out_col_local : index
    %scale_values = vector.load %scale_view[%out_col] : view<[%n_size]xf32> -> vector<4xf32>

    scf.for %half = [%c0 to %c2 step %c1] {
      %row_offset = index.mul %half, %c8 : index
      %publish_row = index.add %publish_row0, %row_offset : index
      %values = vector.load %result_view[%publish_row, %publish_col] : view<16x16xi32> -> vector<4xi32>
      %values_f32 = vector.sitofp %values : vector<4xi32> to vector<4xf32>
      %scaled0 = vector.mulf %values_f32, %scale_values : vector<4xf32>
      %row_in_wave = index.add %frag_row_offset, %publish_row : index
      %row_local = index.add %wave_row, %row_in_wave : index
      %out_row = index.add %base_m, %row_local : index
      %writes = index.cmp ult, %out_row, %m_bounded : index
      scf.if %writes {
        %bounded = index.assume %out_row [lt(%out_row, %m_bounded)] : index
        %a_scale_value = view.load %a_scale_view[%bounded] : view<[%m_bounded]xf32> -> f32
        %cls_i32 = view.load %cls_view[%bounded] : view<[%m_bounded]xi32> -> i32
        %cls_idx0 = index.cast %cls_i32 : i32 to index
        %cls_idx = index.assume %cls_idx0 [range(%cls_idx0, 0, 63), lt(%cls_idx0, %classes)] : index
        %gate_values = vector.load %gate_view[%cls_idx, %out_col] : view<[%classes]x[%n_size]xf32> -> vector<4xf32>
        %a_scale_vector = vector.splat %a_scale_value : vector<4xf32>
        %scaled = vector.mulf %scaled0, %a_scale_vector : vector<4xf32>
        %gated = vector.mulf %scaled, %gate_values : vector<4xf32>
        %prior_half = vector.load %c_view[%bounded, %out_col] : view<[%m_bounded]x[%n_size]xf16> -> vector<4xf16>
        %prior = vector.extf %prior_half : vector<4xf16> to vector<4xf32>
        %summed = vector.addf %prior, %gated : vector<4xf32>
        %narrow = vector.fptrunc %summed : vector<4xf32> to vector<4xf16>
        vector.store %narrow, %c_view[%bounded, %out_col] : vector<4xf16>, view<[%m_bounded]x[%n_size]xf16>
      }
    }
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  }
  kernel.return
}
